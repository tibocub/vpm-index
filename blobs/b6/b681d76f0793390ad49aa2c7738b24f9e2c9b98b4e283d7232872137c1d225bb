local http = require("socket.http")
local json = require("dkjson")

-- For faster access, no need to index table
local httpRequest = http.request
local jsonDecode = json.decode
local jsonEncode = json.encode

local version = 6
local serverUrl = "http://localhost:8765"

local function httpReq(action, params)
    local table = { action = action, params = params, version = version }
    local request = jsonEncode(table)
    local r, c = httpRequest(serverUrl, request)
    if (not r) then
        return nil, c
    end
    return jsonDecode(r).result, jsonDecode(r).error
end


