-- std.lua namespace for model-authored background workflows.
-- The code is intentionally unsandboxed; the host owns its script budget.

local workflow = require("subagents.workflow")
local spawn = require("subagents.spawn")
local progress = require("subagents.progress")

local M = {}

local MAX_JOBS = 32
local INSTRUCTION_BUDGET = 10000000

-- Inline profiles shadow discovered profiles for this workflow only.
local function workflow_profiles(inline_profiles, discovered)
    if inline_profiles == nil then return discovered end
    if type(inline_profiles) ~= "table" then return nil, "profiles must be an array" end

    local count = 0
    for key in pairs(inline_profiles) do
        if type(key) ~= "number" then return nil, "profiles must be an array" end
        count = count + 1
    end
    if count ~= #inline_profiles then return nil, "profiles must be a dense array" end

    local by_name, seen = {}, {}
    for index, raw in ipairs(inline_profiles) do
        if type(raw) ~= "table" then
            return nil, string.format("profiles[%d] must be an object", index)
        end
        local name = raw.name
        if type(name) ~= "string" or name:match("^%s*$") then
            return nil, string.format("profiles[%d].name must be a non-empty string", index)
        end
        if seen[name] then return nil, string.format("duplicate inline profile '%s'", name) end
        local system_prompt = raw.system_prompt
        if type(system_prompt) ~= "string" or system_prompt:match("^%s*$") then
            return nil, string.format("profiles[%d].system_prompt must be a non-empty string", index)
        end
        if raw.description ~= nil and type(raw.description) ~= "string" then
            return nil, string.format("profiles[%d].description must be a string when given", index)
        end
        seen[name] = true
        by_name[name] = {
            name = name,
            description = raw.description or "",
            body = system_prompt,
            layer = "workflow",
        }
    end
    return spawn.overlay_profiles(discovered, by_name)
end

local function budget_hook()
    error("instruction budget exceeded", 0)
end

-- std.lua runs in the calling agent's lane, so `panto.ext.agent` is a child
-- inside a child's script. Children get no delegation surface: no namespace
-- here, and no subagents.* tools (spawn.inherited_tools). Hosts without a
-- recorded primary have no child lanes.
function M.called_by_primary()
    local ext = require("panto").ext
    local primary = rawget(ext, "_primary_agent")
    return primary == nil or rawequal(ext.agent, primary)
end

function M.factory(context, discovered)
    if not M.called_by_primary() then return nil end
    context = type(context) == "table" and context or {}
    return {
        workflow = function(fn, opts)
            if type(fn) ~= "function" then error("subagents.workflow expects a function(ctx, input)", 2) end
            if type(opts) ~= "table" and opts ~= nil then
                error("subagents.workflow options must be a table", 2)
            end
            opts = opts or {}
            local profiles, err = workflow_profiles(opts.profiles, discovered)
            if not profiles then error(err, 2) end

            local task = workflow.workflow(fn)
            local tool_call_id = context.parent_tool_call_id or context.tool_call_id
            progress.prepare(tool_call_id)
            local id = workflow.start(task, {
                max_jobs = MAX_JOBS,
                profiles = profiles,
                tool_call_id = tool_call_id,
                workflow_labels = true,
                on_resume = function(co)
                    debug.sethook(co, budget_hook, "", INSTRUCTION_BUDGET)
                end,
                on_yield = function(co)
                    debug.sethook(co)
                end,
            })
            return workflow.workflows[id]
        end,
        workflows = workflow.workflows,
        agents = workflow.agents,
    }
end

return M
