local M = {
    -- Flags.
    NO_RECORD = 1<<0,

    --  Submission class.
    Submission = {},
}




--[[--
Create a new submission.

@tparam string ll_path Path of laundry list file.
@tparam string report_path Path of report file generated upon calling
    @{Submission:deposit}. If not specified, the report is returned.
@tparam int f Submission flags:
    - NO_RECORD: the submission URI is not recorded.

@treturn table New Submission object.
]]
function M.Submission:new(ll_path, report_path, f)
    f = f or 0
    if not path.isfile(ll_path) then error(ll_path .. " is not a file.", 2) end

    local sub = {
        root_path = path.dirname(ll_path),
        ll_path = ll_path,
        report_path = report_path,
        name = ll_path:match("pkar_submission[%-_%.](.*)%.csv"),
        sip = {},           --- SIP resources indexed by ID.
        gr = graph.new(),   --- Main graph of submitted resources.
        ord_ids = {},       --- IDs of resources ordered as entered in the LL.
        alpha_ord_paths = {}, --- Paths ordered alphabetically (hierarchically).
        path_to_id = {},    --- Local path to ID mapping.
        --- Track IDs in SIP to validate links created in a submission.
        --  TODO ids might be redundant with sip, check for cleanup.
        ids = {},
        members = {},       --- Track member relationships.
    }
    if f & M.NO_RECORD == 0 then
        sub.id = "sub:" .. model.idgen()
        sub.uri = term.new_iriref_ns(sub.id)
    end
    self.__index = self
    setmetatable(sub, self)

    local rc, ret = xpcall(parse_ll, debug.traceback, sub)
    if not rc then
        local fn_error, tb = split_tb(ret)
        return nil, generate_report(sub.report_path, {
            result = "failure",
            message = "An error occurred while parsing the SIP.",
            fn_error = fn_error,
            traceback = tb,
            ll = sub.ll_path,
            id = sub.current_id,
            path = sub.current_path,
        })
    end

    return sub
end


--[[--
Deposit resources from a SIP.
@tparam boolean cleanup If set to `true`, it removes the SIP if the submission
    is successful.

@treturn bool Whether the process completed successfully.
--]]
function M.Submission:deposit(cleanup)
    local rc, ret

    if self.uri then
        rc, ret = xpcall(add_sub_meta, debug.traceback, self)
        if not rc then
            return generate_report(self.report_path, {
                result = "failure",
                message = "An error occurred while updating submission metadata.",
                traceback = split_tb(ret),
                metadata = {
                    sub_id = self.id,
                },
            })
        end
    end

    logger:debug("Graph to be validated: ")
    for chunk in self.gr:encode() do logger:debug(chunk) end

    for id in pairs(self.ids) do
        local val_report = validator.validate(self.gr, model.id_to_uri(id))
        if val_report.max_level == "ERROR" then
            return generate_report(self.report_path, {
                result = "failure",
                message = "A resource did not pass validation.",
                traceback = {},
                metadata = {
                    sub_id = self.id,
                    rsrc_id = id,
                    validation = val_report,
                }
            })
        elseif val_report.max_level == "WARN" then logger:warn(
            "Validation raised warnings: " .. pp.write(val_report))
        elseif val_report.max_level == "NOTICE" then logger:info(
            "Validation raised notices: " .. pp.write(val_report)) end
    end

    -- BEGIN atomic DB update.
    local txn = repo.store:begin()
    -- Update tree first.
    for id, tree in pairs(self.trees) do
        assert(tree.uri, "No URI for tree: " .. id)

        -- Look for all trees connected to the referred subject.
        -- There *should* be only one...
        -- @TODO replace lookup with attr when Volksdata supports txn for
        -- that function.
        -- @TODO actually, move this whole thing to a dedicate remove() 
        -- function in tree...
        for spo in repo.gr:lookup(
                tree.ref_uri, model.uri_map.has_tree, nil, txn) do
            local gr = graph.new(repo.store, spo.o.data)
            local ct = gr:remove(nil, nil, nil, txn)
            logger:debug(("Removed %d triples from tree graph %s."):format(
                    ct, gr.uri.data))
        end

        _, ct = repo.store_updates(tree.gr, tree.uri, txn)
    end
    local rm_ct, add_ct = repo.store_updates(self.gr, nil, txn)

    txn:commit()
    -- END atomic DB update.

    -- After this point, the outcome is either `success` or `warnings`.

    -- Remove processing directory.
    local proc_dir = path.join(self.root_path, "proc")
    if path.isdir(proc_dir) then dir.rmtree(proc_dir) end

    local report = {
        metadata = {
            sub_id = self.id,
            resources = {},
            trees = {},
        },
    }

    if cleanup then
        local rc, ret = xpcall(cleanup_src, debug.traceback, self)
        if not rc then
            report.result = "warnings"
            report.message = "An error occurred while deleting the SIP source."
        end
    end

    report.result = "success"
    report.message = "The SIP has been successfully submitted."

    for id, rsrc in pairs(self.sip) do
        report.metadata.resources[id] =
                (rsrc.data.source_path or NT)[1] or false
    end
    for id, tree in pairs(self.trees) do
        report.metadata.trees[id] = self.trees[id]:structure()
    end

    return generate_report(self.report_path, report)
end


