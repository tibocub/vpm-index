--[[--
List submissions.

@treturn table List of pairs of submission ID and timestamp, ordered by the latter.
]]
function M.list()
    local sub_id_ts = repo.gr:term_set(
        pkar.RDF_TYPE, triple.POS_P,
        term.new_iriref_ns("pas:Submission"), triple.POS_O
    )
    subs = {}
    for s in sub_id_ts:iter() do
        tstamp = repo.get_single_v(s, "submitted").data
        label = (repo.get_single_v(s, "label") or NT).data

        table.insert(subs, {
            tstamp = tstamp,
            id = nsm.denormalize_uri(s.data),
            label = label,
        })
    end
    table.sort(subs, function(a, b) return a.tstamp < b.tstamp end)

    return subs
end


--- Get a submission's details and list of resources with minimal metadata.
function M.get(id)
    local s = term.new_iriref_ns("sub:" .. id:gsub("^sub:", ""))
    local sub = {
        metadata = {
            id = id,
            label = (repo.get_single_v(s, "label") or NT).data,
            timestamp = (repo.get_single_v(s, "submitted") or NT).data,
        },
        items = {}
    }

    -- Not found.
    if not sub.metadata.timestamp then return nil end

    for s in repo.gr:term_set(
        model.uri_map.sub_id, triple.POS_P,
        s, triple.POS_O
    ):iter() do
        sub.items[nsm.denormalize_uri(s.data)] = {
            content_type = nsm.denormalize_uri(
                    repo.get_single_v(s, "content_type").data),
            label = (repo.get_single_v(s, "label") or NT).data or "",
        }
    end

    return sub
end


function M.generate_res_ll(s, sparse, no_header)
    local tdata = get_tdata(s)
    if not tdata then return nil end

    return csv.encode(tdata, {
        encodeNilAs = "", allowMissingKeys = true,
        fieldsToKeep = gather_keys(tdata, sparse),
        headers = no_header ~= true,
    })
end


--[[--
Generate a laundry list for a submission.

@tparam s volksdata.Term URI of LL (`sub:...`).

@treturn string Laundry list as a serialized CSV.
@treturn string|nil Original submission name, if it was provided.
]]
function M.generate_sub_ll(s, sparse)
    -- TODO this is quite inefficient. Rewrite this and generate_res_ll in a
    -- streaming application. https://github.com/rgamble/libcsv looks better
    -- than any Lua solution.
    local res_ts = repo.gr:term_set(
        model.uri_map.sub_id, triple.POS_P,
        s, triple.POS_O
    )
    local sub_name = (repo.get_single_v(s, "label") or NT).data

    local dip = {}
    for s in res_ts:iter() do
        for _, row in ipairs(get_tdata(s)) do table.insert(dip, row) end
    end

    return csv.encode(dip, {
        encodeNilAs = "", allowMissingKeys = true,
        fieldsToKeep = gather_keys(dip, sparse)
    }), sub_name
end


return M
