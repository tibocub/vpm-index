--An expression parser.
local ExpParser = {}
ExpParser.__index = ExpParser
setmetatable(ExpParser, {__index = SubParser})
package.loaded[...] = ExpParser

--Constructor.
--
--@param parser:Parser  Parser to use.
function ExpParser.new(parser)
  local self

  --(1) create
  self = setmetatable(SubParser.new(parser), ExpParser)
  self._.stmtParser = parser._.stmtParser

  --(2) return
  return self
end

--Read an expression.
--
--@return Exp
function ExpParser:next()
  local lex = self._.lexer

  if lex:advance():isSymbol("<") or (lex:advance(1):isSymbol("(") and lex:advance(2):isSymbol("<")) then
    return self:_readXmlExp()
  else
    return self:_readExp()
  end
end

--Read a regular expression.
--
--@return Exp
function ExpParser:_readExp()
  local lex = self._.lexer
  local tok, node, exp

  --(1) init expression
  tok = lex:advance()
  exp = Exp.new(tok.line, tok.col)

  --(2) read
  while true do
    tok = lex:next()

    if tok == nil or tok:isSymbol("</") then
      lex:unshift()

      if exp.tree:isWellFormed() then
        break
      else
        self:_raise("incomplete expression.", exp)
      end
    end

    if tok:isEol() then
      if exp.tree:isWellFormed() then
        lex:unshift()
        break
      end
    elseif tok:isSymbol("(") then
      lex:unshift()

      if exp.tree:isWellFormed() then
        self:_readCallArgs(exp)
      else
        exp:insert(self:_readSubExp())
      end
    elseif tok:isSymbol("[") then
      lex:unshift()

      if exp.tree:isWellFormed() then
        if lex:advance(2):isSymbol("*") then
          self:_readPackLOp(exp)
        else
          self:_readIndexOp(exp)
        end
      elseif lex:advance(2):isKeyword("for") then
        exp:insert(self:_readLiteralForList())
      elseif lex:advance(2):isEol() and lex:advance(3):isKeyword("for") then
        exp:insert(self:_readLiteralForList())
      else
        exp:insert(self:_readLiteralList())
      end
    elseif tok:isSymbol("[|") then
      lex:unshift()
      exp:insert(self:_readLiteralSet())
    elseif tok:isSymbol("?[") then
      lex:unshift()
      self:_readOptionalIndexOp(exp)
    elseif tok:isSymbol("{") then
      lex:unshift()

      if exp.tree:isWellFormed() then
        self:_readMPackOp(exp)
      else
        exp:insert(self:_readLiteralMapWithBrackets())
      end
    elseif tok.type == TokenType.SYMBOL and tablex.find({".", ":", "!"}, tok.value) and lex:advance().type == TokenType.SYMBOL and lex:advance().value == "{" then
      lex:unshift() --the dot

      if exp.tree:isWellFormed() then
        self:_readUpdateOp(exp)
      else
        self:_raise("'.{', ':{' and '!{' are not unary ops.", tok)
      end
    elseif tok:isKeyword("cast") then
      lex:unshift()
      exp:insert(self:_readCast())
    elseif tok:isKeyword("catch") then
      lex:unshift()
      exp:insert(self:_readCatch())
    elseif tok:isKeyword("await") then
      lex:unshift()
      exp:insert(self:_readAwait())
    elseif tok:isKeyword("cwait") then
      lex:unshift()
      exp:insert(self:_readCwait())
    elseif tok:isKeyword("const") then
      lex:unshift()
      exp:insert(self:_readConst())
    elseif tok:isKeyword("copy") then
      lex:unshift()
      exp:insert(self:_readCopy())
    elseif tok:isKeyword("async") then
      tok = lex:next()

      if tok:isKeyword("fn") then
        lex:unshift()
        lex:unshift()
        exp:insert(self:_readFn())
      elseif tok:isKeyword("pr") or tok:isKeyword("proc") then
        lex:unshift()
        lex:unshift()
        exp:insert(self:_readProc())
      else
        self:_raise("'fn' or 'proc' expected.", tok)
      end
    elseif tok:isKeyword("emit") then
      lex:unshift()
      exp:insert(self:_readEmitFn())
    elseif tok:isKeyword("expect") then
      lex:unshift()
      exp:insert(self:_readExpectFn())
    elseif tok:isKeyword("fn") then
      lex:unshift()
      exp:insert(self:_readFn())
    elseif tok:isKeyword("pr") or tok:isKeyword("proc") then
      lex:unshift()
      exp:insert(self:_readProc())
    elseif tok:isKeyword("if") then
      lex:unshift()
      exp:insert(self:_readIfSubExp())
    elseif tok:isKeyword("with") then
      lex:unshift()
      exp:insert(self:_readWithDoSubExp())
    elseif tok:isKeyword("overload") then
      lex:unshift()
      exp:insert(self:_readOverload())
    elseif tok:isKeyword("native") then
      lex:unshift()
      exp:insert(self:_readNative())
    elseif tok:isKeyword("new") then
      lex:unshift()
      exp:insert(self:_readNew())
    elseif tok:isKeyword("pawait") then
      lex:unshift()
      exp:insert(self:_readPawait())
    elseif tok:isKeyword("pcwait") then
      lex:unshift()
      exp:insert(self:_readPcwait())
    elseif tok:isKeyword("peval") then
      lex:unshift()
      exp:insert(self:_readPeval())
    elseif tok:isKeyword("pwait") then
      lex:unshift()
      exp:insert(self:_readPwait())
    elseif tok:isKeyword("throw") then
      lex:unshift()
      exp:insert(self:_readThrow())
    elseif tok:isKeyword("use") then
      lex:unshift()
      exp:insert(self:_readUse())
    elseif tok:isKeyword("self") and lex:advance(1):isSymbol(".") and lex:advance(2):isName("defer") then
      lex:unshift()
      exp:insert(self:_readSelfDefer())
    elseif tok:isKeyword("self") and lex:advance(1):isSymbol(".") and lex:advance(2):isName("deferred") then
      lex:unshift()
      exp:insert(self:_readSelfDeferred())
    elseif tok:isName("json") and lex:advance(1):isSymbol(".") and lex:advance(2):isName("decode") and lex:advance(3):isSymbol("<") then
      lex:unshift()
      exp:insert(self:_readJsonDecode())
    else
      if tok.type == TokenType.KEYWORD and tok.value == "not" then
        local aux = lex:advance()

        if aux.type == TokenType.KEYWORD and aux.value == "in" then
          lex:next()
          node = BinOp.new(Keyword.new(tok.line, tok.col, "notin"))
        elseif aux.type == TokenType.KEYWORD and aux.value == "like" then
          lex:next()
          node = BinOp.new(Keyword.new(tok.line, tok.col, "notlike"))
        else
          node = UnaryOp.new(tok)
        end
      elseif tok.type == TokenType.KEYWORD and tok.value == "is" then
        local aux = lex:advance()

        if aux.type == TokenType.KEYWORD and aux.value == "not" then
          lex:next()
          node = BinOp.new(Keyword.new(tok.line, tok.col, "isnot"))
        else
          node = self:_getNodeOf(tok)
        end
      elseif tok.type == TokenType.SYMBOL and tablex.find({"+", "-", "<<<", ">>>"}, tok.value) then
        if exp.tree:isWellFormed() then
          node = BinOp.new(tok)
        else
          node = UnaryOp.new(tok)
        end
      elseif tok.type == TokenType.SYMBOL and tablex.find({":", ".", "!"}, tok.value) then
        if exp.tree:isWellFormed() then
          node = BinOp.new(tok)
        else
          node = UnaryOp.new(tok)
        end
      elseif tok:isSymbol("$") then
        node = UnaryOp.new(tok)
      else
        node = self:_getNodeOf(tok)
      end

      if node == nil then
        if exp.tree:isWellFormed() then
          lex:unshift()
          break
        else
          self:_raise("invalid expression node.", tok)
        end
      else
        exp:insert(node)
      end
    end
  end

  --(3) return
  return exp
end

--Return a node for a given token.
--
--@param tok:Token  The token.
--@return Node
function ExpParser:_getNodeOf(tok)
  local node

  --(1) create node
  if tok.type == TokenType.NAME then
    node = Terminal.new(TerminalType.NAME, tok)
  elseif tok:isRe() then
    node = Terminal.new(TerminalType.RE, tok)
  elseif tok.type == TokenType.LITERAL then
    if tok.subtype == LiteralType.NUMBER then
      node = Terminal.new(TerminalType.NUM, tok)
    elseif tok.subtype == LiteralType.STRING then
      node = Terminal.new(TerminalType.TEXT, tok)
    elseif tok.subtype == LiteralType.TMPL_STRING then
      node = Terminal.new(TerminalType.TMPL_TEXT, tok)
    end
  elseif tok.type == TokenType.KEYWORD then
    local kw = tok.value

    if kw == "nop" then
      node = Terminal.new(TerminalType.NOP, tok)
    elseif kw == "false" then
      node = Terminal.new(TerminalType.FALSE, tok)
    elseif kw == "nil" then
      node = Terminal.new(TerminalType.NIL, tok)
    elseif kw == "self" then
      node = Terminal.new(TerminalType.SELF, tok)
    elseif kw == "super" then
      node = Terminal.new(TerminalType.SUPER, tok)
    elseif kw == "true" then
      node = Terminal.new(TerminalType.TRUE, tok)
    elseif tablex.find({"and", "in", "is", "like", "or"}, kw) then
      node = BinOp.new(tok)
    end
  elseif tok.type == TokenType.SYMBOL then
    local sym = tok.value

    if tablex.find({"~", "..."}, sym) then
      node = UnaryOp.new(tok)
    elseif tablex.find({"+=", "-=", "*", "*=", "**", "**=", "/", "/=", "%", "%=",
                        "=", ".=", "=~", ":=", "::=", "?=",
                        "==", "!=", "===", "!==", "==~", "!=~", "==^", "!=^",
                        "<", "<<", "<<<", "<<=", "<=", ">", ">>", ">>>", ">>=", ">=",
                        "^", "^=", ".", "?", "??", ":", "!", "&", "&=", "&&", "|", "|=", "||"}, sym) then
      node = BinOp.new(tok)
    end
  end

  --(2) return
  return node
end

--Read (exp) or (exp, exp, exp...).
--
--@return Exp or ExpSeq
function ExpParser:_readSubExp()
  local lex = self._.lexer
  local term, tok, ln, col

  --(1) read
  tok = lex:nextSymbol("(")
  ln, col = tok.line, tok.col

  if lex:advance():isEol() then
    term = ExpSeq.new(ln, col)

    while true do
      lex:nextEol()
      lex:skipEol()

      tok = lex:advance()
      if tok == nil or tok:isSymbol(")") then
        break
      end

      term:insert(self:_readExp())
    end
  else
    term = SubExp.new(ln, col, self:_readExp())
  end

  lex:nextSymbol(")")

  --(2) return
  return term
end

--Read if then else end.
--
--@return IfSubExp
function ExpParser:_readIfSubExp()
  local lex = self._.lexer
  local tok, ln, col, cond, tcase, fcase

  --(1) read
  tok = lex:nextKeyword("if")
  ln, col = tok.line, tok.col
  cond = self:_readExp()
  lex:nextKeyword("then")
  lex:skipEol()
  tcase = self:_readExp()
  lex:skipEol()

  if lex:skipKeyword("else") then
    fcase = self:_readExp()
    lex:skipEol()
  end

  if (fcase == nil and tcase.tree.root.exps == nil) or (fcase ~= nil and fcase.tree.root.exps == nil) then
    lex:nextKeyword("end")
  end

  --(2) return
  return IfSubExp.new(ln, col, cond, tcase, fcase)
end

--Read with..do subexpression.
--
--@return WithDoSubExp
function ExpParser:_readWithDoSubExp()
  local lex = self._.lexer
  local tok, ln, col, value, ifs, els

  --(1) read with clause
  tok = lex:nextKeyword("with")
  ln, col = tok.line, tok.col
  value = self:_readExp()
  lex:nextKeyword("do")

  --(2) read ifs and else clauses
  ifs = {}

  while true do
    lex:skipEol()

    if lex:skipKeyword("if") then
      local clause = {
        cond = self:_readExp()
      }

      lex:nextKeyword("then")
      lex:skipEol()
      clause.value = self:_readExp()
      table.insert(ifs, clause)
    elseif lex:skipKeyword("else") then
      lex:skipEol()
      els = self:_readExp()
      break
    else
      break
    end
  end

  lex:skipEol()
  lex:nextKeyword("end")

  --(3) return
  return WithDoSubExp.new(ln, col, value, ifs, els)
end

--Read a native(code) terminal.
--
--@return NativeFn
function ExpParser:_readNative()
  local lex = self._.lexer
  local tok, ln, col, code

  --(1) read
  tok = lex:next(TokenType.KEYWORD, "native")
  ln, col = tok.line, tok.col
  lex:next(TokenType.SYMBOL, "(")
  code = lex:next(TokenType.LITERAL).value
  lex:next(TokenType.SYMBOL, ")")

  --(2) return
  return NativeFn.new(ln, col, code)
end

--Read a cast<Exp>(Exp) terminal.
--
--@return CastFn
function ExpParser:_readCast()
  local lex = self._.lexer
  local tok, ln, col, to, exp

  --(1) read
  tok = lex:nextKeyword("cast")
  ln, col = tok.line, tok.col

  --(2) type
  lex:nextSymbol("<")
  to = lex:nextName().value
  lex:nextSymbol(">")

  --(3) value
  lex:nextSymbol("(")
  self:_skipEols()
  exp = self:_readExp()
  self:_skipEols()
  lex:nextSymbol(")")

  --(4) return
  return CastFn.new(ln, col, to, exp)
end

--Read a catch(Exp) terminal.
--
--@return CatchFn
