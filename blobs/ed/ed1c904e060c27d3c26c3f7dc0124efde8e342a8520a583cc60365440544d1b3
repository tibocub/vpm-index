--Read an emit() terminal.
--
--@return EmitFn
function ExpParser:_readEmitFn()
  local lex = self._.lexer
  local tok, ln, col, event, arg

  --(1) read
  tok = lex:nextKeyword("emit")
  ln, col = tok.line, tok.col
  lex:nextSymbol("(")
  event = self:_readExp()
  lex:nextSymbol(",")

  if lex:advance(1):isName() and lex:advance(2):isSymbol("=") then
    arg = {}

    while true do
      local name, value

      self:_skipEols()
      name = lex:nextName().value

      if lex:skipSymbol("=") then
        if lex:advance():isSymbol(",") then
          value = name
        else
          value = self:_readExp()
        end
      else
        value = name
      end

      table.insert(arg, {name = name, value = value})

      if not lex:skipSymbol(",") then
        break
      end
    end
  else
    arg = self:_readExp()
  end

  lex:nextSymbol(")")

  --(2) return
  return EmitFn.new(ln, col, event, arg)
end

--Read an expect() terminal.
--
--@return ExpectFn
function ExpParser:_readExpectFn()
  local lex = self._.lexer
  local tok, ln, col, val, types

  --(1) read
  tok = lex:nextKeyword("expect")
  ln, col = tok.line, tok.col
  lex:nextSymbol("(")
  val = self:_readExp()
  if lex:skipSymbol(",") then
    types = self:_readExp()
  end
  lex:nextSymbol(")")

  --(2) return
  return ExpectFn.new(ln, col, val, types)
end

--Read a use(Exp) terminal.
--
--@return UseFn
function ExpParser:_readUse()
  local lex = self._.lexer
  local tok, ln, col, exp

  --(1) read
  tok = lex:next(TokenType.KEYWORD, "use")
  ln, col = tok.line, tok.col
  lex:next(TokenType.SYMBOL, "(")
  exp = self:_readExp()
  lex:next(TokenType.SYMBOL, ")")

  --(2) return
  return UseFn.new(ln, col, exp)
end

--Read self.defer(Exp) terminal.
--
--@return SelfDeferFn
function ExpParser:_readSelfDefer()
  local lex = self._.lexer
  local tok, ln, col, exp

  --(1) read
  tok = lex:nextKeyword("self")
  ln, col = tok.line, tok.col
  lex:nextSymbol(".")
  lex:nextName("defer")
  lex:nextSymbol("(")
  exp = self:_readExp()
  lex:nextSymbol(")")

  --(2) return
  return SelfDeferFn.new(ln, col, exp)
end

--Read self.deferred() terminal.
--
--@return SelfDeferredFn
function ExpParser:_readSelfDeferred()
  local lex = self._.lexer
  local tok, ln, col

  --(1) read
  tok = lex:nextKeyword("self")
  ln, col = tok.line, tok.col
  lex:nextSymbol(".")
  lex:nextName("deferred")
  lex:nextSymbol("(")
  lex:nextSymbol(")")

  --(2) return
  return SelfDeferredFn.new(ln, col)
end

--Read a json.decode() terminal.
--
--@return JsonFn
function ExpParser:_readJsonDecode()
  local lex = self._.lexer
  local tok, ln, col, type, exp

  --(1) read
  tok = lex:nextName("json")
  ln, col = tok.line, tok.col
  lex:nextSymbol(".")
  lex:nextName("decode")
  lex:nextSymbol("<")
  type = lex:nextName().value
  lex:nextSymbol(">")
  lex:nextSymbol("(")
  exp = self:_readExp()
  lex:nextSymbol(")")

  --(2) return
  return JsonDecodeFn.new(ln, col, type, exp)
end

--Read a peval(Exp) terminal.
--
--@return PevalFn
function ExpParser:_readPeval()
  local lex = self._.lexer
  local tok, ln, col, exp

  --(1) read
  tok = lex:next(TokenType.KEYWORD, "peval")
  ln, col = tok.line, tok.col
  lex:next(TokenType.SYMBOL, "(")
  exp = self:_readExp()
  lex:next(TokenType.SYMBOL, ")")

  --(2) return
  return PevalFn.new(ln, col, exp)
end

--Read a throw(Exp [, Exp]) terminal.
--
--@return ThrowFn
function ExpParser:_readThrow()
  local lex = self._.lexer
  local tok, ln, col, args

  --(1) read
  tok = lex:next(TokenType.KEYWORD, "throw")
  ln, col = tok.line, tok.col
  lex:next(TokenType.SYMBOL, "(")

  args = {}
  while true do
    table.insert(args, self:_readExp())

    tok = lex:advance()
    if not (tok.type == TokenType.SYMBOL and tok.value == ",") then
      break
    end

    lex:next(TokenType.SYMBOL, ",")
  end

  lex:next(TokenType.SYMBOL, ")")

  --(2) return
  return ThrowFn.new(ln, col, args)
end

--Read the call arguments.
--
--@param exp:Exp  Current expression.
function ExpParser:_readCallArgs(exp)
  local lex = self._.lexer
  local tok, call

  --(1) pre: read (
  tok = lex:nextSymbol("(")
  tok.value = "()"

  --(2) create operator
  call = CallOp.new(tok)
  exp:insert(call)

  --(3) read arguments
  self:_skipEols()

  local onlyNamed = false
  while true do
    local arg

    tok = lex:advance()

    if not tok or tok:isSymbol(")") then
      break
    end

    arg = self:_readCallArg(onlyNamed)
    call:insert(arg)
    onlyNamed = arg.kind == "named"

    if lex:skipSymbol(",") or lex:skipEol() then
      self:_skipEols()
    else
      break
    end
  end

  call.finished = true
  lex:nextSymbol(")")
end

--Read a call argument.
--
--@param onlyNamed  Only the named arguments can be accepted.
--@returns Arg
function ExpParser:_readCallArg(onlyNamed)
  local lex = self._.lexer
  local tok, name, value, arg

  --(1) read
  if onlyNamed then
    name = lex:nextName().value

    if lex:skipSymbol("=") then
      tok = lex:advance()
      if not tok:isSymbol(",") and not tok:isSymbol(")") then
        value = self:_readExp()
      end
    end

    arg = Arg.new("named", name, value)
  else
    if lex:advance(1):isName() and lex:advance(2):isSymbol("=") then
      name = lex:nextName().value
      lex:nextSymbol("=")

      tok = lex:advance()
      if tok:isSymbol(",") or tok:isSymbol(")") then
        arg = Arg.new("named", name)
      else
        arg = Arg.new("named", name, self:_readExp())
      end
    else
      arg = Arg.new("positional", self:_readExp())
    end
  end

  --(2) return arg
  return arg
end

--Read a literal list: [for].
--
--@return LiteralForList
function ExpParser:_readLiteralForList()
  local lex = self._.lexer
  local tok, ln, col, vars, iter, exp

  --(1) read [for each
  tok = lex:nextSymbol("[")
  ln, col = tok.line, tok.col

  lex:skipEol()
  lex:nextKeyword("for")
  lex:skipKeyword("each")

  --(2) read variables
  vars = {lex:nextName().value}

  if lex:skipSymbol(",") then
    table.insert(vars, lex:nextName().value)
  end

  --(3) read value
  lex:nextKeyword("in")
  iter = self:_readExp()

  --(4) read expression
  lex:nextKeyword("do")
  exp = self:_readExp()

  --(5) read ]
  lex:skipEol()
  lex:nextSymbol("]")

  --(6) return
  return LiteralForList.new(ln, col, vars, iter, exp)
end

--Read a literal list: [...].
--
--@return LiteralList
function ExpParser:_readLiteralList()
  local lex = self._.lexer
  local tok, ln, col, items

  --(1) read [
  tok = lex:nextSymbol("[")
  ln, col = tok.line, tok.col

  --(2) read items
  items = {}

  self:_skipEols()
  if not lex:advance():isSymbol("]") then
    while true do
      table.insert(items, self:_readExp())

      tok = lex:advance()
      if tok:isSymbol(",") then
        lex:nextSymbol(",")
        self:_skipEols()
      elseif tok:isEol() then
        self:_skipEols()
        if lex:advance():isSymbol("]") then
          break
        end
      elseif tok:isSymbol("]") then
        break
      -- else
      --   self:_raise("',', ']' or end of line expected.", tok)
      end
    end
  end

  --(3) read ]
  lex:nextSymbol("]")

  --(4) return
  return LiteralList.new(ln, col, items)
end

--Read a literal set: [|...|].
--
--@return LiteralSet
function ExpParser:_readLiteralSet()
  local lex = self._.lexer
  local tok, ln, col, items

  --(1) read |
  tok = lex:nextSymbol("[|")
  ln, col = tok.line, tok.col

  --(2) read items
  items = {}

  self:_skipEols()

  tok = lex:advance()
  if tok and not tok:isSymbol("|]") then
    while true do
      table.insert(items, self:_readExp())

      tok = lex:advance()
      if tok:isSymbol(",") then
        lex:nextSymbol(",")
        self:_skipEols()
      elseif tok:isEol() then
        self:_skipEols()
        if lex:advance():isSymbol("|]") then
          break
        end
      elseif tok:isSymbol("|]") then
        break
      end
    end
  end

  --(3) read ]
  lex:nextSymbol("|]")

  --(4) return
  return LiteralSet.new(ln, col, items)
end

--Read a map field.
--
--@return {name, value, cond}
function ExpParser:_readLiteralMapField()
  local lex = self._.lexer
  local name, val, cond

  --(1) read
  if lex:skipSymbol("...") then
    local tok = lex:current()
    local op = UnaryOp.new(tok)

    val = Exp.new({line = tok.line, col = tok.col})
    val:insert(op)

    tok = lex:nextId()
    op:insert(Terminal.new(TerminalType.NAME, {line = tok.line, col = tok.col, value = tok.value}))

    name = nil
  elseif lex:skipSymbol("{") then
    if lex:skipSymbol("{") then
      name = lex:nextId()
      lex:nextSymbol("}")
      lex:nextSymbol("}")

      val = Exp.new(name.line, name.col)
      local op = BinOp.new({line = name.line, col = name.col, value = "."})
      val:insert(op)
      op:insert(Terminal.new(TerminalType.NAME, {line = name.line, col = name.col, value = name.value}))
      op:insert(Terminal.new(TerminalType.NAME, {line = name.line, col = name.col, value = name.value}))
    else
      name = lex:nextId()
      lex:nextSymbol("}")

      lex:nextSymbol("=")
      val = self:_readExp()

      local op = BinOp.new({line = name.line, col = name.col, value = "."})
      val:insert(op)
      op:insert(Terminal.new(TerminalType.NAME, {line = name.line, col = name.col, value = name.value}))
    end
  elseif lex:skipSymbol("[") then
    local start = lex:current()
    name = {value=self:_readExp()}
    lex:nextSymbol("]")

    lex:nextSymbol("=")
    if lex:skipEol() then
      val = Exp.new(start.line, start.col)
      val:insert(self:_readLiteralMapWithoutBrackets(start))
    else
      val = self:_readExp()
    end
  else
    if lex:skipKeyword("if") then
      cond = self:_readExp()
      lex:nextKeyword("then")
    end

    name = lex:nextId()

    if lex:skipSymbol("=") then
      if lex:skipEol() then
        val = Exp.new(name.line, name.col)
        val:insert(self:_readLiteralMapWithoutBrackets(name))
      else
        val = self:_readExp()
      end
    else
      val = Exp.new(name.line, name.col)
      val:insert(Terminal.new(TerminalType.NAME, {line = name.line, col = name.col, value = name.value}))
    end
  end

  --(2) return
  return {cond = cond, name = name and name.value or nil, value = val}
end

--Read a literal map defined without brackets.
--
--@param start:Token  Start token.
--@return LiteralMap
function ExpParser:_readLiteralMapWithoutBrackets(start)
  local lex = self._.lexer
  local fields = {}

  --(1) read fields
  while true do
    self:_skipEols()

    local tok = lex:advance()
    if (tok:isId() or tok:isSymbol("{") or tok:isSymbol("[")) and tok.col > start.col then
      table.insert(fields, self:_readLiteralMapField())
      if not lex._.token:isEol() then
        lex:nextEol()
      end
    else
      break
    end
  end

  --(3) return
  return LiteralMap.new(start.line, start.col, fields)
end

--Read a literal map defined with brackets.
--
--@return LiteralMap
function ExpParser:_readLiteralMapWithBrackets()
  local lex = self._.lexer
  local tok, ln, col
  local fields = {}

  --(1) read {
  tok = lex:nextSymbol("{")
  ln, col = tok.line, tok.col

  --(2) read fields
  self:_skipEols()
  if not lex:advance():isSymbol("}") then
    while true do
      table.insert(fields, self:_readLiteralMapField())

      tok = lex:advance()
      if tok:isSymbol(",") then
        lex:nextSymbol(",")
        self:_skipEols()
      elseif tok:isEol() then
        self:_skipEols()
        if lex:advance():isSymbol("}") then
          break
        end
      elseif tok:isSymbol("}") then
        break
      -- else
      --   self:_raise("',', '}' or end of line expected.", tok)
      end
    end
  end

  --(3) read }
  lex:nextSymbol("}")

  --(4) return
  return LiteralMap.new(ln, col, fields)
end

--Read a proc.
--
--@return LiteralProc
function ExpParser:_readProc()
  local parser, lex, stmt = self._.parser, self._.lexer, self._.stmtParser
  local tok, ln, col, async, params, catch, body

  --(1) read
  async = not not lex:skipKeyword("async")
  tok = lex:skipKeyword("pr") or lex:nextKeyword("proc")
  ln, col = tok.line, tok.col

  params = stmt:_readRoutineParams()

  if lex:skipSymbol("=>") then
    catch = self:_readExp()
    lex:nextEol()
  end

  if lex:skipSymbol("{") then
    if lex:skipSymbol("}") then
      body = {}
    else
      body = {parser:next()}
      if body[1].type == SentType.DIRECTIVE then
        table.insert(body, parser:next())
      end
      lex:nextSymbol("}")
    end
  else
    lex:skipEol()
    body = stmt:_readBody(3)
  end

  --(2) return
  return LiteralProc.new(ln, col, async, params, catch, body)
end

--Read a fn.
--
--@return LiteralFn
function ExpParser:_readFn()
  local parser, lex, stmt = self._.parser, self._.lexer, self._.stmtParser
  local tok, ln, col, async, params, subparams, rtype, rvar, catch, body

  --(1) read
  async = not not lex:skipKeyword("async")
  tok = lex:nextKeyword("fn")
  ln, col = tok.line, tok.col

  params, subparams = stmt:_readRoutineParams({subparams = true})

  if lex:skipSymbol("=>") then
    catch = self:_readExp()
    lex:nextEol()
  end

  if lex:skipSymbol("{") then
    if lex:skipSymbol("}") then
      body = {}
    else
      body = {parser:next()}
      if body[1].type == SentType.DIRECTIVE then
        table.insert(body, parser:next())
      end
      lex:nextSymbol("}")
    end
  else
    rvar = stmt:_readFnReturnVar()
    rtype = stmt:_readFnType()

    tok = lex:advance()
    if tok.type == TokenType.SYMBOL and tok.value == "=" then
      lex:nextSymbol("=")

      tok = lex:advance()
      if tok.type == TokenType.SYMBOL and tok.value == "(" then
        lex:nextSymbol("(")
        body = self:_readExp()
        body = {ReturnStmt.new(body.ln, body.col, body)}
        lex:nextSymbol(")")
      else
        body = self:_readExp()
        body = {ReturnStmt.new(body.ln, body.col, body)}
        lex:nextKeyword("end")
      end
    else
      body = stmt:_readBody(3)
    end
  end

  --(2) return
  return LiteralFn.new(ln, col, async, params, subparams, rtype, rvar, catch, body)
end

--Read ?[exp] operator.
--
--@param exp:Exp  Expression to update.
function ExpParser:_readOptionalIndexOp(exp)
  local lex = self._.lexer
  local tok, ln, col, ix

  --(1) read ?[Exp
  tok = lex:nextSymbol("?[")
  ln, col = tok.line, tok.col

  --(2) read expression
  ix = self:next()

  --(3) read ]
  lex:nextSymbol("]")

  --(4) add
  local op = BinOp.new({line = ln, col = col, value = "?[]"})
  exp:insert(op)
  op:insert(ix.tree.root)
end

--Read an indexing operator.
--
--@param exp:Exp  Expression to update.
function ExpParser:_readIndexOp(exp)
  local lex = self._.lexer
  local tok, ln, col, init, fin

  --(1) read [Exp
  tok = lex:next(TokenType.SYMBOL, "[")
  ln, col = tok.line, tok.col
  init = self:next()

  --(2) read "", Exp" if existing
  tok = lex:advance()

  if tok.type == TokenType.SYMBOL and tok.value == "," then
    lex:next()
    fin = self:next()
  end

  --(3) read ]
  lex:next(TokenType.SYMBOL, "]")

  --(4) add
  local op

  if fin == nil then
    op = BinOp.new({line = ln, col = col, value = "[]"})
    exp:insert(op)
    op:insert(init.tree.root)
  else
    op = SliceOp.new({line = ln, col = col, value = "[]"})
    exp:insert(op)
    op:insert(init.tree.root)
    op:insert(fin.tree.root)
  end
end

--Read the next [*] op.
--
--@param exp:Exp  Expression to update.
function ExpParser:_readPackLOp(exp)
  local lex = self._.lexer
  local tok, op

  --(1) read [
  tok = lex:nextSymbol("[")

  --(2) create op
  tok.value = "[]"
  op = PackLOp.new(tok)
  exp:insert(op)

  --(3) read *
  lex:nextSymbol("*")

  --(4) read items
  while lex:skipSymbol(",") do
    table.insert(op.children, self:_readExp())
  end

  --(5) read ]
  lex:nextSymbol("]")
  op.finished = true
end

--Read the next {name,name...} op.
--
--@param exp:Exp  Expression to update.
function ExpParser:_readMPackOp(exp)
  local lex = self._.lexer
  local tok, op, clone

  --(1) read {
  tok = lex:nextSymbol("{")
  self:_skipEols()

  --(2) create op
  tok.value = "{}"
  op = PackOp.new(tok)
  exp:insert(op)

  --(3) read * if specified for {*} or {*,field,...}
  tok = lex:advance()

  if tok:isSymbol("*") or tok:isSymbol("**") then
    clone = true
    table.insert(op.children, {visib = ".", name = lex:nextSymbol().value, value = nil})
    if not (lex:skipSymbol(",") or lex:skipEol()) and not lex:advance():isSymbol("}") then
      self:_raise("',', end of line or '}' expected.", lex:advance())
    end
  else
    clone = false
  end

  --(4) read fields
  if not lex:advance():isSymbol("}") then
    while true do
      self:_skipEols()

      if lex:advance():isSymbol("}") then
        break
      end

      if lex:skipSymbol("...") then
        tok = lex:current()

        local val = Exp.new(tok.line, tok.col)
        tok.value = "{}"
        local pack = PackOp.new(tok)
        val:insert(pack)

        tok = lex:nextName()
        pack:insert(Terminal.new(TerminalType.NAME, {line=tok.line, col=tok.col, value=tok.value}))

        table.insert(op.children, {visib=".", name=nil, value=val, remove=false, rename=false})
      elseif lex:skipSymbol("{") then
        local name, val, dot

        name = lex:nextId()
        lex:nextSymbol("}")
        lex:nextSymbol("=")
        val = self:_readExp()

        dot = BinOp.new({line=name.line, col=name.col, value="."})
        val:insert(dot)
        dot:insert(Terminal.new(TerminalType.NAME, {line=name.line, col=name.col, value=name.value}))

        table.insert(op.children, {visib=".", name=name.value, value=val, remove=false, rename=false})
      else
        local visib, name, val, rm, rename

        --remove the field?
        rm = (clone and lex:skipSymbol("-"))
        rename = false

        --visibility?
        tok = lex:advance()

        if tok:isSymbol() and tablex.find({".", ":", "!"}, tok.value) then
          lex:next()
          visib = tok.value
        else
          visib = "."
        end

        --name
        name = lex:nextId()

        --value if needed
        if rm then
          val = nil
        else
          if lex:skipSymbol("=") then
            val = self:_readExp()
          elseif lex:skipSymbol("=>") then
            rename = true
            val = lex:nextId().value
          else
            if clone then --{*,field}
              val = Exp.new(name.line, name.col)
              val:insert(Terminal.new(TerminalType.NAME, {line=name.line, col=name.col, value=name.value}))
            else          --{field}
              val = nil
            end
          end
        end

        --insert into fields
        table.insert(op.children, {visib=visib, name=name.value, value=val, remove=rm, rename=rename})
      end

      --end?
      if lex:advance():isSymbol("}") then
        break
      end

      --comma as separator
      if not lex:skipSymbol(",") then
        if not lex:skipEol() then
          break
        end
      end
    end
  end

  --(5) read }
  lex:nextSymbol("}")
  op.finished = true
end

--Read an update op: Exp.{} or Exp:{} or Exp!{}.
function ExpParser:_readUpdateOp(exp)
  local lex = self._.lexer
  local tok, op

  --(1) read .{ or :{ or !{
  tok = lex:next()

  if tok.value == "." then
    tok.value = ".{}"
    op = UpdateOp.new(tok, ".")
  elseif tok.value == ":" then
    tok.value = ".{}"
    op = UpdateOp.new(tok, ":")
  else
    tok.value = ".{}"
    op = UpdateOp.new(tok, "!")
  end

  lex:nextSymbol("{")

  --(2) insert op in exp
  exp:insert(op)

  --(3) read fields
  self:_skipEols()

  while true do
    local name, type, value, assign

    --id, {id...} or (id...)
    tok = lex:advance()

    if tok:isSymbol() and (tok.value == "{" or tok.value == "(") then
      type = (tok.value == "{" and "mapped" or "extended")
      lex:next()
      name = {}

      while true do
        table.insert(name, lex:nextId().value)

        tok = lex:advance()
        if tok:isSymbol(",") then
          lex:next()
        else
          break
        end
      end

      lex:nextSymbol(type == "mapped" and "}" or ")")
    else
      type = nil
      name = lex:nextId().value
    end

    --=, ::=, .=, ?=
    tok = lex:advance()

    if tok:isSymbol() and tablex.find({"=", "::=", ".=", "?="}, tok.value) then
      lex:next()
      assign = tok.value
      value = self:_readExp()
    else
      value, assign = nil, nil
    end

    --add field
    table.insert(op.children, {name=name, type=type, assign=assign, value=value})

    --end or next?
    tok = lex:advance()

    if tok:isSymbol(",") then
      lex:nextSymbol(",")
      self:_skipEols()
    elseif tok:isNewline() then
      self:_skipEols()

      tok = lex:advance()
      if tok:isSymbol("}") then
        break
      end
    elseif tok:isSymbol("}") then
      break
    else
      self:_raise("',' or '}' expected.", tok)
    end
  end

  --(4) read }
  lex:nextSymbol("}")
  op.finished = true
end

--Read a XML expression.
--
--@return Exp
function ExpParser:_readXmlExp()
  local lex = self._.lexer

  --(1) pre: #!react set in the file previously
  if not self._.parser._.options.react then
    self:_raise("XML only when #!react specified.", lex:advance())
  end

  --(2) read
  local tok = lex:advance()
  return XmlExp.new(tok.line, tok.col, self:_readLiteralXml())
end

--Read a literal XML: <e>...</e> or <e/>.
--
--@return LiteralXml
function ExpParser:_readLiteralXml()
  local lex = self._.lexer
  local tok, ln, col, ele, props, body

  --(1) read <
  tok = lex:nextSymbol("<")
  ln, col = tok.line, tok.col

  --(2) read name
  ele = self:_nextPath()

  --(3) read props
  props = {}

  while true do
    local name, val

    --skip end of line
    lex:skipEol()

    --end?
    tok = lex:advance()
    if tok and tok:isSymbol(">") or tok:isSymbol("/>") then
      break
    end

    --name or ...name
    if lex:skipSymbol("...") then
      if lex:advance():isSymbol("(") then
        val = self:_readSubExp()
      else
        val = Terminal.new(TerminalType.NAME, lex:nextId())
      end

      name = nil
    else
      local unpack

      if lex:skipSymbol("{") then
        unpack = true
        name = lex:nextId()
        lex:skipSymbol("}")
      else
        unpack = false
        name = lex:nextId()
      end

      --value
      if lex:skipSymbol("=") then
        tok = lex:advance()

        if tok:isSymbol("{") then
          val = Exp.new(tok.line, tok.col)
          val:insert(self:_readLiteralMapWithBrackets())
        elseif tok:isSymbol("[") then
          val = Exp.new(tok.line, tok.col)
          val:insert(self:_readLiteralList())
        elseif tok:isKeyword("fn") or tok:isKeyword("async") then
          val = Exp.new(tok.line, tok.col)
          val:insert(self:_readFn())
        elseif tok:isKeyword("true") then
          lex:next()
          val = Exp.new(tok.line, tok.col)
          val:insert(Terminal.new(TerminalType.TRUE, tok))
        elseif tok:isKeyword("false") then
          lex:next()
          val = Exp.new(tok.line, tok.col)
          val:insert(Terminal.new(TerminalType.FALSE, tok))
        elseif tok:isNum() then
          lex:next()
          val = Exp.new(tok.line, tok.col)
          val:insert(Terminal.new(TerminalType.NUM, tok))
        elseif tok:isText() then
          lex:next()
          val = Exp.new(tok.line, tok.col)
          val:insert(Terminal.new(TerminalType.TEXT, tok))
        elseif tok:isId() then
          lex:next()
          val = Exp.new(tok.line, tok.col)
          val:insert(Terminal.new(TerminalType.NAME, tok))
        else
          lex:nextSymbol("(")
          val = self:_readExp()
          lex:nextSymbol(")")
        end
      else
        val = Exp.new(name.line, name.col)
        val:insert(Terminal.new(TerminalType.NAME, {line = name.line, col = name.col, value = name.value}))
      end

      if unpack then
        local op = BinOp.new({line=name.ln, col=name.col, value = "."})
        val:insert(op)
        op:insert(Terminal.new(TerminalType.NAME, {line=name.line, col=name.col, value=name.value}))
      end
    end

    --insert
    table.insert(props, {name=name and name.value or nil, value=val})
  end

  --(4) read content and/or end
  body = {}

  tok = lex:advance()
  if tok:isSymbol("/>") then
    lex:nextSymbol("/>")
  else  --if tok:isSymbol(">") then
    lex:nextSymbol(">")
    self:_skipEols()

    tok = lex:advance()
    if tok:isSymbol("</") then
      lex:nextSymbol("</")
    elseif tok:isSymbol("<") or tok:isSymbol("(") then
      while not lex:skipSymbol("</") do
        tok = lex:advance()
        if tok:isSymbol("<") then
          table.insert(body, self:_readLiteralXml())
        elseif tok:isSymbol("(") then
          table.insert(body, self:_readSubExp())
        else
          self:_raise("'<' or '(' expected.", tok)
        end

        self:_skipEols()
      end
    else
      table.insert(body, self:_readExp())
      self:_skipEols()
      lex:nextSymbol("</")
    end

    self:_nextPath(ele)
    lex:nextSymbol(">")
  end

  --(5) return
  return LiteralXml.new(ln, col, ele, props, body)
end
