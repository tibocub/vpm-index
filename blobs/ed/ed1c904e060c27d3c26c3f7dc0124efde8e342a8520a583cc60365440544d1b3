  return CatchFn.new(ln, col, exp)
end

--Read an await() terminal:
--await(exp1), await(exp1, exp2, ...) or await(...exp).
--
--@return AwaitFn when only one argument passed; MawaitFn when multiple.
function ExpParser:_readAwait()
  local lex = self._.lexer
  local tok, ln, col, call

  --(1) read
  tok = lex:nextKeyword("await")
  ln, col = tok.line, tok.col
  lex:nextSymbol("(")
  self:_skipEols()

  tok = lex:advance()
  if tok:isSymbol("...") then
    lex:nextSymbol("...")
    call = MawaitFn.new(ln, col, {self:_readExp()})
  else
    local args = self:_readPositionalArgs(1)

    if #args == 1 then
      call = AwaitFn.new(ln, col, args[1])
    else
      call = MawaitFn.new(ln, col, args)
    end
  end

  self:_skipEols()
  lex:nextSymbol(")")

  --(2) return
  return call
end

--Read an pawait() terminal:
--pawait(exp1), pawait(exp1, exp2, ...) or pawait(...exp).
--
--@return PawaitFn when only one argument passed; MpawaitFn when multiple.
function ExpParser:_readPawait()
  local lex = self._.lexer
  local tok, ln, col, call

  --(1) read
  tok = lex:nextKeyword("pawait")
  ln, col = tok.line, tok.col
  lex:nextSymbol("(")
  self:_skipEols()

  tok = lex:advance()
  if tok:isSymbol("...") then
    lex:nextSymbol("...")
    call = MpawaitFn.new(ln, col, {self:_readExp()})
  else
    local args = self:_readPositionalArgs(1)

    if #args == 1 then
      call = PawaitFn.new(ln, col, args[1])
    else
      call = MpawaitFn.new(ln, col, args)
    end
  end

  self:_skipEols()
  lex:nextSymbol(")")

  --(2) return
  return call
end


--Read the function call arguments.
--
--@param atLeast:number Minimum number of arguments expected.
--@return a list with the argument expressions.
function ExpParser:_readPositionalArgs(atLeast)
  local lex = self._.lexer
  local args = {}

  --(1) read arguments
  self:_skipEols()

  while true do
    if lex:advance():isSymbol(")") then
      break
    end

    table.insert(args, self:_readExp())

    if not (lex:skipSymbol(",") or lex:skipEol()) then
      break
    end

    self:_skipEols()
  end

  if atLeast > #args then
    self:_raise(
      string.format("%s argument(s) expected. Received: %s.", atLeast, #args),
      lex:advance()
    )
  end

  --(2) return
  return args
end

