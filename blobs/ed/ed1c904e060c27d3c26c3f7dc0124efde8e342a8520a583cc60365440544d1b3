--Read an overload() terminal.
--
--@return OverloadFn
function ExpParser:_readOverload()
  local lex = self._.lexer
  local tok, ln, col, params

  --(1) read
  tok = lex:nextKeyword("overload")
  ln, col = tok.line, tok.col
  lex:nextSymbol("(")

  --(2) read parameters
  params = {}

  tok = lex:advance()
  if not tok:isSymbol(")") then
    while true do
      table.insert(params, self:_readOverloadParam())

      if not lex:skipSymbol(",") then
        break
      end
    end
  end

  --(3) read end of call
  lex:nextSymbol(")")

  --(4) return
  return OverloadFn.new(ln, col, params)
end

function ExpParser:_readOverloadParam()
  local lex = self._.lexer
  local kind, type

  --(1) read
  if lex:skipSymbol("...") then
    kind = "..."
  else
    kind = not not lex:skipSymbol("?") and "optional"  or "mandatory"
    type = self:_readDataType()
  end

  --(2) return
  return OverloadParam.new(kind, type)
end

