do
   local function fail(ps, i, msg)
      if not ps.tokens[i] then
         local eof = ps.tokens[#ps.tokens]
         table.insert(
         ps.errs,
         {
            filename = ps.filename,
            y = eof.y,
            x = eof.x,
            msg = msg or "unexpected end of file",
         })

         return #ps.tokens
      end
      table.insert(
      ps.errs,
      {
         filename = ps.filename,
         y = ps.tokens[i].y,
         x = ps.tokens[i].x,
         msg = assert(msg, "syntax error, but no error message provided"),
      })

      return math.min(#ps.tokens, i + 1)
   end

   local function end_at(node, tk)
      node.yend = tk.y
   end

   local function verify_tk(ps, i, tk)
      if ps.tokens[i].tk == tk then
         return i + 1
      end
      return fail(ps, i, "syntax error, expected '" .. tk .. "'")
   end

   local function verify_end(
      ps, i, istart, node)

      if ps.tokens[i].tk == "end" then
         local endy, endx = ps.tokens[i].y, ps.tokens[i].x
         node.yend = endy
         if node.kind ~= "function" and endy ~= node.y and endx ~= node.x then
            if not ps.end_alignment_hint then
               ps.end_alignment_hint = {
                  filename = ps.filename,
                  y = node.y,
                  x = node.x,
                  msg = "syntax error hint: construct starting here is not aligned with its 'end' at " ..
                  ps.filename ..
                  ":" ..
                  endy ..
                  ":" ..
                  endx ..
                  ":",
               }
            end
         end
         return i + 1
      end
      end_at(node, ps.tokens[i])
      if ps.end_alignment_hint then
         table.insert(ps.errs, ps.end_alignment_hint)
         ps.end_alignment_hint = nil
      end
      local location = ps.filename ..
      ":" ..
      ps.tokens[istart].y ..
      ":" ..
      ps.tokens[istart].x ..
      ":"
      return fail(
      ps,
      i,
      "syntax error, expected 'end' to close construct started at " .. location)

   end

   local node_mt = {
      __tostring = function(n)
         return n.f .. ":" .. n.y .. ":" .. n.x .. " " .. n.kind
      end,
   }

   local function new_node(ps, i, kind)
      local t = ps.tokens[i]
      return setmetatable(
      {
         f = ps.filename,
         y = t.y,
         x = t.x,
         tk = t.tk,
         kind = kind or (t.kind),
      },
      node_mt)

   end

   local function new_type(ps, i, typename)
      local token = ps.tokens[i]
      local t = setmetatable({}, type_mt)
      t.typeid = new_typeid()
      t.f = ps.filename
      t.x = token.x
      t.y = token.y
      t.typename = typename
      return t
   end

   local function split_source_lines(input)
      local lines = {}
      local start = 1

      while true do
         local newline = input:find("\n", start, true)
         if newline == nil then
            table.insert(lines, input:sub(start))
            break
         end

         table.insert(lines, input:sub(start, newline - 1))
         start = newline + 1
      end

      if #lines == 0 then
         table.insert(lines, "")
      end

      return lines
   end

   local function new_first_order_type(
      ps, i, tn)

      return new_type(ps, i, tn)
   end

   local function new_generic(
      ps, i, typeargs, typ)

      local gt = new_type(ps, i, "generic")
      gt.typeargs = typeargs
      gt.t = typ
      return gt
   end

   local function new_typedecl(
      ps, i, def)

      local t = new_type(ps, i, "typedecl")
      t.def = def
      return t
   end

   local function new_tuple(
      ps, i, types, is_va)

      local t = new_type(ps, i, "tuple")
      t.is_va = is_va
      t.tuple = types or {}
      return t, t.tuple
   end

   local function new_nominal(ps, i, name)
      local t = new_type(ps, i, "nominal")
      if name then
         t.names = { name }
      end
      return t
   end

   local function verify_kind(
      ps, i, kind, node_kind)

      if ps.tokens[i].kind == kind then
         return i + 1, new_node(ps, i, node_kind)
      end
      return fail(ps, i, "syntax error, expected " .. kind)
   end





   local function fork(ps, required_modules)
      return {
         filename = ps.filename,
         tokens = ps.tokens,
         errs = {},
         source_lines = ps.source_lines,
         required_modules = required_modules or ps.required_modules,
         macro_params = ps.macro_params,
         allow_bare_type = ps.allow_bare_type,
      }
   end

   local function skip(
      ps, i, skip_fn)

      return skip_fn(fork(ps, {}), i)
   end

   local function failskip(
      ps, i, msg, skip_fn, starti)

      local skip_i = skip(ps, starti or i, skip_fn)
      fail(ps, i, msg)
      return skip_i
   end

   local function parse_type_body(
      ps, i, istart, node, tn)

      local typeargs
      local def
      i, typeargs = parse_typeargs_if_any(ps, i)

      def = new_first_order_type(ps, istart, tn)

      local ok
      i, ok = parse_type_body_fns[tn](ps, i, def)
      if not ok then
         return fail(ps, i, "expected a type")
      end

      i = verify_end(ps, i, istart, node)

      if typeargs then
         return i, new_generic(ps, istart, typeargs, def)
      end

      return i, def
   end

   local function skip_type_body(ps, i)
      local tn = ps.tokens[i].tk
      i = i + 1
      assert(parse_type_body_fns[tn], tn .. " has no parse body function")
      local ii, tt = parse_type_body(ps, i, i - 1, {}, tn)
      return ii, not not tt
   end

   local function parse_table_value(ps, i)
      local next_word = ps.tokens[i].tk
      if next_word == "record" or next_word == "interface" then
         local skip_i, e = skip(ps, i, skip_type_body)
         if e then
            fail(
            ps,
            i,
            next_word == "record" and
            "syntax error: this syntax is no longer valid; declare nested record inside a record" or "syntax error: cannot declare interface inside a table; use a statement")

            return skip_i, new_node(ps, i, "error_node")
         end
      elseif next_word == "enum" and ps.tokens[i + 1].kind == "string" then
         i = failskip(
         ps,
         i,
         "syntax error: this syntax is no longer valid; declare nested enum inside a record",
         skip_type_body)

         return i, new_node(ps, i - 1, "error_node")
      end

      local e
      i, e = parse_expression(ps, i)
      if not e then
         e = new_node(ps, i - 1, "error_node")
      end
      return i, e
   end

   local get_attached_comments


   local take_same_line_comments
   local take_all_token_comments
   local partition_separator_trivia



   local function token_yend(tk)
      if tk.kind == "string" or tk.kind == "`" then
         local _, line_breaks = tk.tk:gsub("\n", "\n")
         return tk.y + line_breaks
      end
      return tk.y
   end

   local function parse_table_item(
      ps, i, n)

      local node = new_node(ps, i, "literal_table_item")
      local comments = get_attached_comments(ps.tokens[i], ps.tokens[i - 1])
      if comments then
         node.leading_comments = comments
      end
      if ps.tokens[i].kind == "$EOF$" then
         return fail(ps, i, "unexpected eof")
      end

      if ps.tokens[i].tk == "[" then
         node.key_parsed = "long"
         i = i + 1
         i, node.key = parse_expression_and_tk(ps, i, "]")
         i = verify_tk(ps, i, "=")
         i, node.value = parse_table_value(ps, i)
         node.yend = token_yend(ps.tokens[i - 1])
         return i, node, n
      elseif ps.tokens[i].kind == "identifier" then
         if ps.tokens[i + 1].tk == "=" then
            node.key_parsed = "short"
            i, node.key = verify_kind(ps, i, "identifier", "string")
            node.key.conststr = node.key.tk
            node.key.tk = '"' .. node.key.tk .. '"'
            i = verify_tk(ps, i, "=")
            set_inline_trivia(
            node,
            "after_opener",
            take_same_line_comments(ps.tokens[i], ps.tokens[i - 1].y))

            i, node.value = parse_table_value(ps, i)
            node.yend = token_yend(ps.tokens[i - 1])
            return i, node, n
         elseif ps.tokens[i + 1].tk == ":" then
            node.key_parsed = "short"
            local orig_i = i
            local try_ps = fork(ps)
            i, node.key = verify_kind(try_ps, i, "identifier", "string")
            node.key.conststr = node.key.tk
            node.key.tk = '"' .. node.key.tk .. '"'
            i = verify_tk(try_ps, i, ":")
            i, node.itemtype = parse_type(try_ps, i)
            if node.itemtype and ps.tokens[i].tk == "=" then
               i = verify_tk(try_ps, i, "=")
               i, node.value = parse_table_value(try_ps, i)
               if node.value then
                  for _, e in ipairs(try_ps.errs) do
                     table.insert(ps.errs, e)
                  end
                  node.yend = token_yend(ps.tokens[i - 1])
                  return i, node, n
               end
            end

            node.itemtype = nil
            i = orig_i
         end
      end

      node.key = new_node(ps, i, "integer")
      node.key_parsed = "implicit"
      node.key.constnum = n
      node.key.tk = tostring(n)
      i, node.value = parse_expression(ps, i)
      if not node.value then
         return fail(ps, i, "expected an expression")
      end
      node.yend = token_yend(ps.tokens[i - 1])
      return i, node, n + 1
   end





   local function is_block_comment(comment)
      return comment.text:match("^%-%-%[=*%[") ~= nil
   end

   local function all_block_comments(comments)
      for _, comment in ipairs(comments) do
         if not is_block_comment(comment) then
            return false
         end
      end
      return true
   end




   local function same_line_comments_all_block(token, line)
      local lc_list = token.comments
      if lc_list == nil then
         return false
      end
      local found = false
      for _, lc in ipairs(lc_list) do
         if lc.y == line then
            if not (lc.text:match("^%-%-%[=*%[")) then
               return false
            end
            found = true
         end
      end
      return found
   end

   local function append_trailing_comments(node, comments)
      if #comments == 0 then
         return
      end
      if node.trailing_comments == nil then
         node.trailing_comments = comments
      else
         for _, comment in ipairs(comments) do
            table.insert(node.trailing_comments, comment)
         end
      end
   end

   local function parse_list(
      ps,
      i,
      list,
      close,
      sep,
      parse_item)

      local n = 1
      local pending_leading = {}
      while ps.tokens[i].kind ~= "$EOF$" do
         if close[ps.tokens[i].tk] then
            end_at(list, ps.tokens[i])
            break
         end
         local item
         local oldn = n
         i, item, n = parse_item(ps, i, n)
         n = n or oldn
         if item then
            if #pending_leading > 0 then
               set_inline_trivia(item, "leading", pending_leading)
               pending_leading = {}
            end








            local is_separator = ps.tokens[i].tk == "," or ps.tokens[i].tk == ";"
            local item_line = item.yend or item.y
            local sep_trailing = {}
            if is_separator then
               local before_sep
               sep_trailing, before_sep = partition_separator_trivia(
               ps.tokens[i], ps.tokens[i + 1], item_line)

               set_inline_trivia(item, "before_separator", before_sep)
            end
            local comment_token = (is_separator and ps.tokens[i + 1]) or
            ps.tokens[i]
            local next_same_line = take_same_line_comments(comment_token, item_line)
            local next_token = ps.tokens[i + 1]
            local has_next_item = is_separator and
            next_token.kind ~= "$EOF$" and
            not close[next_token.tk]
            if
has_next_item and
               #sep_trailing == 0 and
               #next_same_line > 0 and
               all_block_comments(next_same_line) then

               pending_leading = next_same_line
            elseif #sep_trailing == 0 then
               item.trailing_comments = next_same_line
            else
               item.trailing_comments = sep_trailing
               for _, c in ipairs(next_same_line) do
                  table.insert(item.trailing_comments, c)
               end
            end
         end
         table.insert(list, item)
         if ps.tokens[i].tk == "," then
            i = i + 1
            if sep == "sep" and close[ps.tokens[i].tk] then
               fail(ps, i, "unexpected '" .. ps.tokens[i].tk .. "'")
               return i, list
            end
         elseif sep == "term" and ps.tokens[i].tk == ";" then
            i = i + 1
         elseif not close[ps.tokens[i].tk] then
            local options = {}
            for k, _ in pairs(close) do
               table.insert(options, "'" .. k .. "'")
            end
            table.sort(options)
            local first = options[1]:sub(2, -2)
            local msg
            if first == ")" and ps.tokens[i].tk == "=" then
               msg = "syntax error, cannot perform an assignment here (did you mean '=='?)"
               i = failskip(ps, i, msg, parse_expression, i + 1)
            else
               table.insert(options, "','")
               msg = "syntax error, expected one of: " ..
               table.concat(options, ", ")
               fail(ps, i, msg)
            end
            if first ~= "}" and ps.tokens[i].y ~= ps.tokens[i - 1].y then
               table.insert(
               ps.tokens,
               i,
               {
                  tk = first,
                  y = ps.tokens[i - 1].y,
                  x = ps.tokens[i - 1].x + 1,
                  kind = "keyword",
               })

               return i, list
            end
         end
      end
      return i, list
   end

   local function parse_bracket_list(
      ps,
      i,
      list,
      open,
      close,
      sep,
      parse_item)

      i = verify_tk(ps, i, open)
      i = parse_list(ps, i, list, { [close] = true }, sep, parse_item)
      i = verify_tk(ps, i, close)
      return i, list
   end

   local function parse_table_literal(ps, i)
      local node = new_node(ps, i, "literal_table")
      node.leading_comments = get_attached_comments(ps.tokens[i], ps.tokens[i - 1])
      i, node = parse_bracket_list(ps, i, node, "{", "}", "term", parse_table_item)
      node.dangling_comments = get_attached_comments(
      ps.tokens[i - 1], ps.tokens[i - 2])

      node.trailing_comma = #node > 0 and
      (ps.tokens[i - 2].tk == "," or ps.tokens[i - 2].tk == ";")
      local items = node
      local previous_end = nil
      for _, item in ipairs(items) do
         local leading = item.leading_comments or {}
         if #leading > 0 then
            previous_end = leading[#leading].yend
         end
         if previous_end ~= nil then
            item.blank_line_before = item.y > previous_end + 1
         end
         previous_end = item.yend
      end
      return i, node
   end





   local function attempt(
      ps, i, parse_item)

      local try_ps = fork(ps)
      local tryi, item = parse_item(try_ps, i)
      if not item then
         return i
      end
      for _, e in ipairs(try_ps.errs) do
         table.insert(ps.errs, e)
      end
      return tryi, item
   end







   local function thread_separator(
      ps, i, current)

      local item_line = ps.tokens[i - 1].y
      if current.kind ~= nil then
         local sep_trailing, before_sep = partition_separator_trivia(
         ps.tokens[i], ps.tokens[i + 1], item_line)

         set_inline_trivia(current, "before_separator", before_sep)



         if
#sep_trailing == 0 and
            ps.tokens[i + 1].kind ~= "$EOF$" and
            same_line_comments_all_block(ps.tokens[i + 1], item_line) then

            return take_same_line_comments(ps.tokens[i + 1], item_line)
         end
         append_trailing_comments(current, sep_trailing)
         return {}
      end
      set_inline_trivia(
      current,
      "before_separator",
      take_same_line_comments(ps.tokens[i], item_line))

      return take_same_line_comments(ps.tokens[i + 1], ps.tokens[i].y)
   end







   local function thread_list(
      ps,
      i,
      list,
      parse_item,
      sep,
      ret_lookahead)

      local pending_leading = {}
      while
ps.tokens[i].tk == sep and
         (
         not ret_lookahead or
         not (
         ps.tokens[i + 1].kind == "identifier" and
         ps.tokens[i + 2] and
         ps.tokens[i + 2].tk == ":")) do



         pending_leading = thread_separator(ps, i, list[#list])
         i = i + 1
         local item
         i, item = parse_item(ps, i)
         if not item then
            local last = list[#list]
            if #pending_leading > 0 and last.kind ~= nil then
               append_trailing_comments(last, pending_leading)
            end
            break
         end
         if #pending_leading > 0 then
            set_inline_trivia(item, "leading", pending_leading)
         end
         pending_leading = {}
         table.insert(list, item)
      end
      return i
   end




   local function parse_trying_list(
      ps, i, list, parse_item)

      local item
      i, item = attempt(ps, i, parse_item)
      if not item then
         return i, list
      end
      table.insert(list, item)
      i = thread_list(ps, i, list, parse_item, ",")
      return i, list
   end



   local function set_last_before_separator(
      ps, i, list)

      if #list > 0 then
         set_inline_trivia(
         list[#list],
         "before_separator",
         take_same_line_comments(ps.tokens[i], ps.tokens[i - 1].y))

      end
   end

   local function parse_anglebracket_list(
      ps, i, parse_item)

      local second = ps.tokens[i + 1]
      if second.tk == ">" then
         return fail(ps, i + 1, "type argument list cannot be empty")
      elseif second.tk == ">>" then
         second.tk = ">"
         fail(ps, i + 1, "type argument list cannot be empty")
         return i + 1
      end

      local angle_line = ps.tokens[i].y
      i = verify_tk(ps, i, "<")
      local types = {}
      local leading = take_same_line_comments(ps.tokens[i], angle_line)
      local first
      i, first = parse_item(ps, i)
      if first then
         set_inline_trivia(first, "leading", leading)
         table.insert(types, first)
         i = thread_list(ps, i, types, parse_item, ",")
      end
      set_last_before_separator(ps, i, types)
      if ps.tokens[i].tk == ">" then
         i = i + 1
      elseif ps.tokens[i].tk == ">>" then
         ps.tokens[i].tk = ">"
      else
         return fail(ps, i, "syntax error, expected '>'")
      end
      return i, types
   end

   local function parse_typearg(
      ps, i)

      local name = ps.tokens[i].tk
      local constraint
      local t = new_type(ps, i, "typearg")
      i = verify_kind(ps, i, "identifier")
      if ps.tokens[i].tk == "is" then
         i = i + 1
         i, constraint = parse_interface_name(ps, i)
      end
      t.typearg = name
      t.constraint = constraint
      return i, t
   end

   local function parse_return_types(ps, i)
      local iprev = i - 1
      local t
      i, t = parse_type_list(ps, i, "rets")
      if #t.tuple == 0 then
         t.x = ps.tokens[iprev].x
         t.y = ps.tokens[iprev].y
      end
      return i, t
   end

   parse_typeargs_if_any = function(ps, i)
      if ps.tokens[i].tk == "<" then
         return parse_anglebracket_list(ps, i, parse_typearg)
      end
      return i
   end

   local function parse_function_type(
      ps, i)

      local istart = i
      local typeargs
      local typ = new_type(ps, i, "function")
      i = i + 1

      i, typeargs = parse_typeargs_if_any(ps, i)
      if ps.tokens[i].tk == "(" then
         i, typ.args, typ.maybe_method, typ.min_arity = parse_argument_type_list(
         ps, i)

         i, typ.rets = parse_return_types(ps, i)
      else
         typ.bare = true
         typ.args = new_tuple(ps, i, { new_type(ps, i, "any") }, true)
         typ.rets = new_tuple(ps, i, { new_type(ps, i, "any") }, true)
         typ.is_method = false
         typ.min_arity = 0
      end
      typ.yend = ps.tokens[i - 1].y

      if typeargs then
         return i, new_generic(ps, istart, typeargs, typ)
      end

      return i, typ
   end

   local function parse_simple_type_or_nominal(
      ps, i)

      local tk = ps.tokens[i].tk
      local st = simple_types[tk]
      if st and ps.tokens[i + 1].tk ~= "." then
         return i + 1, new_type(ps, i, tk)
      end

      local typ = new_nominal(ps, i, tk)
      i = i + 1
      while ps.tokens[i].tk == "." do
         i = i + 1
         if ps.tokens[i].kind == "identifier" then
            table.insert(typ.names, ps.tokens[i].tk)
            i = i + 1
         else
            return fail(ps, i, "syntax error, expected identifier")
         end
      end

      if ps.tokens[i].tk == "<" then
         i, typ.typevals = parse_anglebracket_list(ps, i, parse_type)
      end
      return i, typ
   end

   local function parse_base_type(
      ps, i)

      local tk = ps.tokens[i].tk
      if ps.tokens[i].kind == "identifier" then
         return parse_simple_type_or_nominal(ps, i)
      elseif tk == "{" then
         local istart = i
         local brace_line = ps.tokens[i].y
         i = i + 1
         local leading = take_same_line_comments(ps.tokens[i], brace_line)
         local t
         i, t = parse_type(ps, i)
         if not t then
            return i
         end
         set_inline_trivia(t, "leading", leading)
         if ps.tokens[i].tk == "}" then
            local decl = new_type(ps, istart, "array")
            set_inline_trivia(
            t,
            "before_separator",
            take_same_line_comments(ps.tokens[i], ps.tokens[i - 1].y))

            decl.elements = t
            end_at(decl, ps.tokens[i])
            i = verify_tk(ps, i, "}")
            return i, decl
         elseif ps.tokens[i].tk == "," then
            local decl = new_type(ps, istart, "tupletable")
            decl.types = { t }
            i = thread_list(ps, i, decl.types, parse_type, ",")
            set_last_before_separator(ps, i, decl.types)
            end_at(decl, ps.tokens[i])
            i = verify_tk(ps, i, "}")
            return i, decl
         elseif ps.tokens[i].tk == ":" then
            local decl = new_type(ps, istart, "map")
            decl.keys = t
            set_inline_trivia(
            t,
            "before_separator",
            take_same_line_comments(ps.tokens[i], ps.tokens[i - 1].y))

            i = i + 1
            local value_leading = take_same_line_comments(
            ps.tokens[i], ps.tokens[i - 1].y)

            i, decl.values = parse_type(ps, i)
            if not decl.values then
               return i
            end
            set_inline_trivia(decl.values, "leading", value_leading)
            set_inline_trivia(
            decl.values,
            "before_separator",
            take_same_line_comments(ps.tokens[i], ps.tokens[i - 1].y))

            end_at(decl, ps.tokens[i])
            i = verify_tk(ps, i, "}")
            return i, decl
         end
         return fail(ps, i, "syntax error; did you forget a '}'?")
      elseif tk == "function" then
         return parse_function_type(ps, i)
      elseif tk == "nil" then
         return i + 1, new_type(ps, i, "nil")
      end
      return fail(ps, i, "expected a type")
   end

   parse_type = function(ps, i)
      if ps.tokens[i].tk == "(" then
         i = i + 1
         local t
         i, t = parse_type(ps, i)
         i = verify_tk(ps, i, ")")
         if t then
            t.paren = true
         end
         return i, t
      end

      local bt
      local istart = i
      i, bt = parse_base_type(ps, i)
      if not bt then
         return i
      end
      if ps.tokens[i].tk == "|" then
         local u = new_type(ps, istart, "union")
         u.types = { bt }
         i = thread_list(ps, i, u.types, parse_base_type, "|")
         bt = u
      end
      return i, bt
   end

   parse_type_list = function(
      ps, i, mode)

      local t, list = new_tuple(ps, i)

      local first_token = ps.tokens[i].tk


      local first_leading = {}
      if mode == "rets" or mode == "decltuple" then
         if first_token == ":" then
            local colon_line = ps.tokens[i].y
            i = i + 1
            first_leading = take_same_line_comments(ps.tokens[i], colon_line)
         else
            return i, t
         end
      end

      local optional_paren = false
      if ps.tokens[i].tk == "(" then
         optional_paren = true
         local paren_line = ps.tokens[i].y
         i = i + 1
         for _, comment in ipairs(
            take_same_line_comments(ps.tokens[i], paren_line)) do

            table.insert(first_leading, comment)
         end
      end



      local first_type
      i, first_type = attempt(ps, i, parse_type)
      if not first_type then
         if ps.tokens[i].tk ~= ")" then
            fail(ps, i - 1, "expected a type list")
         end

         set_inline_trivia(t, "after_opener", first_leading)
      else
         set_inline_trivia(first_type, "leading", first_leading)
         table.insert(list, first_type)
         i = thread_list(ps, i, list, parse_type, ",", mode == "rets")
      end

      if mode == "rets" and ps.tokens[i].tk == "..." then
         i = i + 1
         local nrets = #list
         if nrets > 0 then
            t.is_va = true
         else
            fail(ps, i, "unexpected '...'")
         end
      end

      if optional_paren then
         set_last_before_separator(ps, i, list)
         i = verify_tk(ps, i, ")")
         t.paren = true
      end

      return i, t
   end

   local function parse_function_args_rets_body(
      ps, i, node)

      local istart = i - 1
      i, node.typeargs = parse_typeargs_if_any(ps, i)
      i, node.args, node.min_arity = parse_argument_list(ps, i)
      i, node.rets = parse_return_types(ps, i)
      set_inline_trivia(
      node, "head", take_same_line_comments(ps.tokens[i], ps.tokens[i - 1].y))

      i, node.body = parse_statements(ps, i)
      end_at(node, ps.tokens[i])
      i = verify_end(ps, i, istart, node)
      return i, node
   end

   local function parse_function_value(ps, i)
      local node = new_node(ps, i, "function")
      i = verify_tk(ps, i, "function")
      return parse_function_args_rets_body(ps, i, node)
   end

   local function unquote(str)
      local f = str:sub(1, 1)
      if f == '"' or f == "'" then
         return str:sub(2, -2), false
      end
      f = str:match("^%[=*%[")
      local l = #f + 1
      return str:sub(l, -l), true
   end

   local function parse_literal(ps, i)
      local tk = ps.tokens[i].tk
      local kind = ps.tokens[i].kind
      if kind == "identifier" then
         return verify_kind(ps, i, "identifier", "variable")
      elseif kind == "string" then
         local node = new_node(ps, i, "string")
         node.conststr, node.is_longstring = unquote(tk)
         node.yend = token_yend(ps.tokens[i])
         return i + 1, node
      elseif kind == "`" then


         local node = new_node(ps, i, "macro_quote")
         node.yend = token_yend(ps.tokens[i])
         return i + 1, node
      elseif kind == "number" or kind == "integer" then
         local n = tonumber(tk)
         local node
         i, node = verify_kind(ps, i, kind)
         node.constnum = n
         return i, node
      elseif tk == "true" then
         return verify_kind(ps, i, "keyword", "boolean")
      elseif tk == "false" then
         return verify_kind(ps, i, "keyword", "boolean")
      elseif tk == "nil" then
         return verify_kind(ps, i, "keyword", "nil")
      elseif tk == "function" then
         return parse_function_value(ps, i)
      elseif tk == "{" then
         return parse_table_literal(ps, i)
      elseif kind == "..." then
         return verify_kind(ps, i, "...")
      elseif kind == "$ERR$" then
         return fail(ps, i, "invalid token")
      end
      return fail(ps, i, "syntax error")
   end

   local function node_is_require_call_or_pcall(n)
      local r = node_is_require_call(n)
      if r then
         return r
      end
      if
node_is_funcall(n) and
         n.e1 and
         n.e1.tk == "pcall" and
         n.e2 and
         #n.e2 == 2 and
         n.e2[1].kind == "variable" and
         n.e2[1].tk == "require" and
         n.e2[2].kind == "string" and
         n.e2[2].conststr then

         return n.e2[2].conststr
      end
      return nil
   end

