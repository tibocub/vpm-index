-- fq_codel: fair queue controlled delay.
Registry.register("qdisc", "fq_codel", {
    description = "FQ-CoDel AQM",
    params = {
        limit = "max packets in queue",
        flows = "number of flow buckets",
        target = "target sojourn time",
        interval = "moving time window",
        quantum = "bytes dequeued per round",
        ecn = "enable ECN marking (bool)",
        noecn = "disable ECN marking (bool)",
    },
    generate = function(p)
        local out = {}
        for _, key in ipairs({ "limit", "flows", "target", "interval", "quantum", "ecn", "noecn" }) do
            if p[key] ~= nil then
                local val = str(p[key])
                if (key == "ecn" or key == "noecn") and isTruthy(val) then
                    out[#out + 1] = key
                else
                    out[#out + 1] = key
                    out[#out + 1] = val
                end
            end
        end
        return out
    end,
    validate = function(_p)
        return {}
    end,
})

-- prio: priority scheduler.
Registry.register("qdisc", "prio", {
    description = "Priority scheduler",
    params = {
        bands = "number of priority bands (2-16)",
        priomap = "16-value priority-to-band map",
    },
    generate = function(p)
        local out = {}
        if p.bands ~= nil then
            out[#out + 1] = "bands"
            out[#out + 1] = str(p.bands)
        end
        if p.priomap ~= nil then
            out[#out + 1] = "priomap"
            for w in tostring(p.priomap):gmatch("%S+") do
                out[#out + 1] = w
            end
        end
        return out
    end,
    validate = function(p)
        local errs = {}
        if p.bands ~= nil then
            local b = tonumber(p.bands)
            if b == nil or b < 2 or b > 16 then
                errs[#errs + 1] = "prio bands must be 2-16, got " .. tostring(p.bands)
            end
        end
        if p.priomap ~= nil then
            local n = 0
            for _ in tostring(p.priomap):gmatch("%S+") do
                n = n + 1
            end
            if n ~= 16 then
                errs[#errs + 1] = "priomap must have exactly 16 values, got " .. n
            end
        end
        return errs
    end,
})

-- hfsc: hierarchical fair service curve.
Registry.register("qdisc", "hfsc", {
    description = "HFSC service curves",
    params = {
        default = "default class minor number",
    },
    generate = function(_p)
        return {}
    end,
    validate = function(_p)
        return {}
    end,
})

return M
