local M = {}

local function finite_number(value)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function duration_label(seconds)
    if not finite_number(seconds) or seconds <= 0 or seconds % 1 ~= 0 then return nil end
    local units = { { 604800, "w" }, { 86400, "d" }, { 3600, "h" }, { 60, "m" }, { 1, "s" } }
    local parts = {}
    for _, unit in ipairs(units) do
        if seconds >= unit[1] then
            local amount = math.floor(seconds / unit[1])
            parts[#parts + 1] = tostring(amount) .. unit[2]
            seconds = seconds % unit[1]
            if #parts == 2 then break end
        end
    end
    return table.concat(parts)
end

local function reset_value(value)
    if finite_number(value) and value > 0 then return value end
    if type(value) == "string" and value ~= "" then return value end
end

local function add_window(windows, label, window)
    if type(window) ~= "table" or (not finite_number(window.used_percent) or window.used_percent < 0) then return end
    local item = { label = label, used_percent = window.used_percent }
    item.resets_at = reset_value(window.reset_at)
    windows[#windows + 1] = item
end

local function add_rate_windows(windows, rate, prefix)
    if type(rate) ~= "table" then return end
    for _, name in ipairs({ "primary_window", "secondary_window" }) do
        local window = rate[name]
        if type(window) == "table" then
            local label = duration_label(window.limit_window_seconds) or "window"
            if prefix then label = prefix .. " " .. label end
            add_window(windows, label, window)
        end
    end
end

function M.parse(data)
    local windows = {}
    if type(data) ~= "table" then return windows end

    add_rate_windows(windows, data.rate_limit)
    if type(data.additional_rate_limits) == "table" then
        for _, bucket in ipairs(data.additional_rate_limits) do
            if type(bucket) == "table" then
                local prefix = type(bucket.limit_name) == "string" and bucket.limit_name ~= ""
                    and bucket.limit_name or "additional"
                local rate = bucket.rate_limit or bucket
                if type(rate) == "table" and (rate.primary_window or rate.secondary_window) then
                    add_rate_windows(windows, rate, prefix)
                else
                    local window = type(rate) == "table" and rate.used_percent ~= nil and rate or bucket
                    local label = duration_label(window.limit_window_seconds) or "window"
                    add_window(windows, prefix .. " " .. label, window)
                end
            end
        end
    end

    local individual = type(data.spend_control) == "table" and data.spend_control.individual_limit
    if type(individual) == "table" then add_window(windows, "spend", individual) end
    return windows
end

local function make_request(auth)
    return {
        url = "https://chatgpt.com/backend-api/wham/usage",
        -- The host resolves the named OAuth auth and derives ChatGPT-Account-Id
        -- from its account_id_jwt_claim; Lua never sees the token or claim.
        auth = auth,
        auth_token = "access",
        headers = {
            ["Accept"] = "application/json",
            ["OpenAI-Beta"] = "responses=experimental",
            ["originator"] = "codex_cli_rs",
        },
        timeout_ms = 15000,
        max_bytes = 262144,
    }
end

local POLL_MS, TURN_THROTTLE_MS = 60000, 10000
local BACKOFF_BASE_MS, BACKOFF_MAX_MS = 30000, 900000

function M.activate(ext, auth_names, footer, uv)
    if type(ext) ~= "table" or type(ext.on) ~= "function" or type(footer) ~= "table"
        or type(footer.publish) ~= "function" or type(auth_names) ~= "table" or #auth_names == 0 then
        return
    end

    local accounts = {}
    for _, auth in ipairs(auth_names) do
        if type(auth) == "string" and auth ~= "" then
            accounts[#accounts + 1] = {
                auth = auth,
                key = "panto-codex:" .. auth,
                label = #auth_names > 1 and ("Codex (" .. auth .. ")") or "Codex",
                windows = {},
                has_snapshot = false,
                failures = 0,
                retry_after = 0,
            }
        end
    end
    if #accounts == 0 then return end

    local function publish(account, status)
        pcall(footer.publish, ext, account.key, account.label, account.windows, status)
    end

    if type(ext.http_request) ~= "function" then
        for _, account in ipairs(accounts) do publish(account, "unavailable") end
        return
    end

    local alive, busy, timer, request_handle = true, false, nil, nil
    local generation, last_poll_started = 0, nil
    local function now()
        if uv and type(uv.now) == "function" then return uv.now() end
        return os.time() * 1000
    end

    local function close_timer()
        local old = timer
        timer = nil
        if not old then return end
        pcall(old.stop, old)
        pcall(old.close, old)
    end

    local function failed(account)
        account.failures = math.min(account.failures + 1, 10)
        local delay = math.min(BACKOFF_BASE_MS * 2 ^ (account.failures - 1), BACKOFF_MAX_MS)
        account.retry_after = now() + delay
        publish(account, account.has_snapshot and "stale" or "unavailable")
    end

    local function succeeded(account, body)
        local json = ext.json
        if type(json) ~= "table" or type(json.decode) ~= "function" or type(body) ~= "string" then
            failed(account)
            return
        end
        local ok, data = pcall(json.decode, body)
        if not ok or type(data) ~= "table" then
            failed(account)
            return
        end
        local windows = M.parse(data)
        if #windows == 0 then failed(account); return end
        account.windows = windows
        account.has_snapshot = true
        account.failures, account.retry_after = 0, 0
        publish(account)
    end

    local busy_accounts, busy_index
    local next_request
    local function complete(account, response, request_error)
        request_handle = nil
        if not alive then return end
        if request_error ~= nil or type(response) ~= "table"
            or not finite_number(response.status) or response.status < 200 or response.status >= 300 then
            failed(account)
        else
            succeeded(account, response.body)
        end
        next_request()
    end

    local function options_for(account)
        return make_request(account.auth)
    end

    next_request = function()
        if not alive then busy = false; return end
        generation = generation + 1
        local request_generation = generation
        local account = busy_accounts and busy_accounts[busy_index]
        if not account then
            busy, busy_accounts, busy_index = false, nil, nil
            return
        end
        busy_index = busy_index + 1

        local invoking, sync_result, settled = true, nil, false
        local function callback(response, request_error)
            if settled or not alive or request_generation ~= generation then return end
            settled = true
            if invoking then
                sync_result = { response = response, request_error = request_error }
            else
                complete(account, response, request_error)
            end
        end
        local ok, handle, err = pcall(ext.http_request, options_for(account), callback)
        invoking = false
        if not ok then
            if not settled then settled = true; complete(account, nil, handle) end
        elseif settled then
            complete(account, sync_result.response, sync_result.request_error)
        elseif not handle then
            settled = true
            complete(account, nil, err or "request unavailable")
        else
            request_handle = handle
        end
    end

    local function poll(force)
        if not alive or busy then return end
        local time = now()
        if not force and last_poll_started and time - last_poll_started < TURN_THROTTLE_MS then return end
        local selected = {}
        for _, account in ipairs(accounts) do
            if time >= account.retry_after then selected[#selected + 1] = account end
        end
        if #selected == 0 then return end
        busy, busy_accounts, busy_index = true, selected, 1
        last_poll_started = time
        next_request()
    end

    local function subscribe(name, handler)
        pcall(ext.on, name, handler)
    end

    subscribe("session_ready", function()
        if not alive then return end
        if not timer and uv and type(uv.new_timer) == "function" then
            local ok, created = pcall(uv.new_timer)
            if ok and created then
                timer = created
                if type(timer.unref) == "function" then pcall(timer.unref, timer) end
                local started = pcall(timer.start, timer, POLL_MS, POLL_MS, function()
                    if alive then pcall(poll, true) end
                end)
                if not started then close_timer() end
            end
        end
        poll(true)
    end)
    subscribe("turn_end", function() poll(false) end)
    subscribe("session_end", function()
        if not alive then return end
        alive = false
        generation = generation + 1
        close_timer()
        local old = request_handle
        request_handle = nil
        if old and type(old.cancel) == "function" then pcall(old.cancel, old) end
    end)
end

return M
