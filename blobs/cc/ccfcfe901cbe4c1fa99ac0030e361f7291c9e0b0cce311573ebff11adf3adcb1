--- Searchers for readable strings, longer than 3 characters, ending on zero
---@param bin any
function M.strings(bin, patterns)
	local block

	local strings = {}
	local curstr

	local file = assert(sfs.read(bin, true))

	return coroutine.wrap(function()
		for i, pat in ipairs(patterns) do
			for str in file:gmatch(pat) do
				coroutine.yield(i, str)
			end
		end
	end)
end

if false then
	local strs = log.assert(M.strings(...))

	for _, str in ipairs(strs) do
		print(str)
	end
	return
end

M.preprocess = function(header, inc, defs)
	header = M.defaultdefs()..'\n'..header
	return cpreprocessor(header, inc, defs)
end

---@return table<string, string>
function M.newenv(deduplicate)
	local self = {}
	if deduplicate then
		self._LRV_DEDUPVARS = "1"
	end

	---@diagnostic disable-next-line
	return setmetatable(self, ENVIRON)
end
M.ENV = M.newenv()

local DEFAULT_CC = {
	gnu = 'gcc',
	msvc = 'cl',
}

---@param userargs lrocket.TargetSpec
---@param cfg lrocket.FinalConf
function M.configure(cfg, userargs)
	cfg.windows_gui = userargs.windows_gui
	cfg.link_sibling_deps = userargs.link_sibling_deps

	M.ENV = cfg.env

	if not cfg.toolchain then
		local CC = M.ENV.CC or M.ENV.VSINSTALLDIR and 'cl' or 'gcc'

		if M.ENV.VSINSTALLDIR and not CC or CC == 'cl' or CC == 'cl.exe' then
			cfg.toolchain = 'msvc'
			M.ENV.CC = CC or 'cl'
		else
			cfg.toolchain = 'gnu'
			M.ENV.CC = CC or 'gcc'
		end
	else
		M.ENV.CC = M.ENV.CC or DEFAULT_CC[cfg.toolchain]
	end

	if cfg.target then
		if not cfg.toolchain and M.TARGET.sys:find 'windows' then
			cfg.toolchain = 'msvc'
		end
	end

	M.SYSROOT = cfg.sysroot
	M.TOOLCHAIN = cfg.toolchain

	local modname = "lrocket.toolchain."..cfg.toolchain
	local internal = {
		gnu = true,
		msvc = true,
	}
	if not internal[cfg.toolchain] then
		abi.report(abi.validatemodule(modname, string.format("toolchain '%s'", cfg.toolchain)))
	end
	---@class lrocket.Toolchain
	tc = require(modname)
	tc.SYSROOT = M.SYSROOT
	tc.ENV = M.ENV
	tc.targettripplet = M.targettripplet

	M.__index = tc
	tc.configure(cfg, userargs)

	cfg.env = tc.ENV

	tc.ENV.CFLAGS   = table.concat(tc.bakeargs('c', cfg.cconf), ' ')
	tc.ENV.LDFLAGS  = table.concat(tc.bakeargs('l', cfg.cconf), ' ')

	if tc.ENV.CFLAGS == "" then tc.ENV.CFLAGS = nil end
	if tc.ENV.LDFLAGS == "" then tc.ENV.LDFLAGS = nil end

	tc.ENV.CXXFLAGS = tc.ENV.CFLAGS

	cfg.host = M.targettripplet(tc.HOST)
end

function M.iswindows(target)
	return target.sys:find 'win' or target.sys:find 'mingw'
end

return M

