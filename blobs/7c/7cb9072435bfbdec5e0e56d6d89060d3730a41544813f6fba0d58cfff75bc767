local dir = require "pl.dir"
local path = require "pl.path"
local vips = require "vips"

local pkar = require "pocket_archive"
local logger = pkar.logger


M = { fn = {} }

setmetatable(M, {
    __index = function(t, k)
        if k == "conf" then
            if not rawget(t, "_conf") then
                rawset(
                    t, "_conf",
                    dofile(path.join(pkar.config_path, "transformers.lua"))
                )
            end
        end
        return rawget(t, "_conf")
    end,
})


--[[-- Process selector.
Find a matching process configuration for the given mime type and target.

@tparam string mimetype MIME type of the file.
@tparam string target Processing target.

@treturn table Process configuration.
@treturn nil If no match was found.
@treturn string Error message if no match was found.
]]
function M.find(mimetype, target)
    for _, pconf in ipairs(M.conf) do
        if mimetype:find(pconf.mime) then
            if pconf.targets[target] then
                -- Merge the general transformer config with the target's.
                out = { render_as = pconf.render_as }
                for k, v in pairs(pconf.targets[target]) do out[k] = v end
                return out
            else return nil, "MIME match found but no target match." end
        end
    end

    return nil, "No transformer configured for this MIME type and target."
end

--[[-- Process executor.

@tparam table conf Configuration obtained with @{find()}..
@tparam string src Source file path.
@tparam string dest_base Destination file path without the file extension. This
    will be appended by the transformer configuration or, if not defined, it
    will match the source extension.

@treturn bool True if successful.
@treturn string Destination path if successful.
@treturn bool False If an error occurred.
@treturn err Error message if an error occurred.
]]
M.process = function(conf, src, dest_base)
    local dest = dest_base .. (conf.ext or path.extension(src))
    return pcall(M.fn[conf.fn], src, dest, table.unpack(conf))
end


--
-- Processing functions
