    return dest
end


--- Convert a text file to a thumbnail.
M.fn.text_to_img = function(src, dest, length, size)
    local fh = assert(io.open(src), "r")
    local txt = fh:read(length)
    fh:close()
    local ok, img
    --[[ Unicode text could be cut by `length` in the middle of a multi-byte
    sequence. That makes the text invalid for the Vips transform.
    Run up to 7 attempts, each time cutting one byte off the end (any given
    Unicode symbol can be up to 8 bytes long) until a code point boundary is
    met and the text is valid for conversion.
    ]]
    for i = 1, 7 do
        if i > 1 then
            logger:info(("Text decoding failed. Try #%d..."):format(i))
        end
        ok, img = pcall(function()
            return vips.Image.text(txt, {
                width = size,
                height = size,
                font = "sans 16",
                --dpi = 120,
            }):invert()
        end)
        if ok then break end
        txt = txt:sub(1, -2)
    end
    assert(ok, img)

    img:write_to_file(dest)

    return dest
end


-- Straight copy with no transformation.
M.fn.copy = function(src, dest)
    dir.makepath(path.dirname(dest))
    dir.copyfile(src, dest)

    return dest
end


return M
