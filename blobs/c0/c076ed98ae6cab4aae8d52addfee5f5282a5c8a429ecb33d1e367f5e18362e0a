    local key=fire and ('fire:'..self.sequence) or ('id:'..tostring(message.id))
    local effective={era=opts.era or self.era,protocol_version=opts.protocol_version or self.protocol_version,
        method=opts.method or message.method,name=opts.name,param_headers=opts.param_headers,arguments=opts.arguments}
    if opts.era then self.era=opts.era end
    if opts.protocol_version then self.protocol_version=opts.protocol_version end
    local handshake_notification=effective.era=='legacy' and message.method=='notifications/initialized'
    local state={key=key,message=message,opts=effective,fire_and_forget=fire,handshake_notification=handshake_notification,cancelled=false,done=false,got_response=false}
    if handshake_notification then
        state.handshake_future=async.future()
        function state:await() return self.handshake_future:await() end
    end
    self.active[key]=state
    if effective.era=='legacy' and message.method=='initialize' then self.initialize_params=message.params or {} end
