end
local function cancel_state(self,id,handle,notify)
    local state=self.active['id:'..tostring(id)] or handle
    if not state then return end
    local was_legacy=state.opts.era=='legacy'
    local method=state.message and state.message.method
    local version=state.opts.protocol_version or self.protocol_version
    state.cancelled=true; self.active[state.key]=nil
    local op=state.op; if op then async.close(op.idle_timer); async.close(op.fire_timer); cancel_handle(op.handle) end
    if notify and was_legacy and state.op and state.op.session_generation==self.session_generation and
        method and method~='initialize' and method~='notifications/cancelled' and not self.closed then
        self:send({jsonrpc='2.0',method='notifications/cancelled',params={requestId=id,reason='request cancelled'}},
            {era='legacy',protocol_version=version,method='notifications/cancelled'})
    end
end
function Transport:open_notification_stream()
    if self.closed or self.notification_stream then return false end
    local headers=M.headers(self.cfg,{era='legacy',protocol_version=self.protocol_version or '2025-11-25'},self.session_id)
    headers.Accept='text/event-stream'
    headers['Content-Type']=nil
    local stream={status=0,ignore=false,handle=nil,parser=nil}
    self.notification_stream=stream
