        if self.notification_stream~=stream then return end
        self.notification_stream=nil
        if stream.status~=405 and not self.closed and self.on_notification_stream_end then
            pcall(self.on_notification_stream_end,stream.status)
        end
    end
    local options={url=self.cfg.url,method='GET',auth=self:auth_name(),headers=headers,
        timeout_ms=0,idle_timeout_ms=0}
    options.on_head=function(head)
        if self.closed or self.notification_stream~=stream then return end
        stream.status=head.status or 0
        if stream.status<200 or stream.status>=300 then
            stream.ignore=true
            cancel_handle(stream.handle)
            finish()
            return
        end
        stream.opened=true
        stream.parser=M.sse_parser(function(data)
            local message=decode_message(data)
            if message and self.on_message and not self.closed then self.on_message(message) end
        end,MAX_BODY)
    end
