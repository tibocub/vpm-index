end
function Transport:cancel_request(id,handle) cancel_state(self,id,handle,false) end
function Transport:cancel(id,handle) cancel_state(self,id,handle,true) end
function Transport:fail(err)
    if self.closed then return end
    self.closed=true
    if self.notification_stream then self:close_notification_stream() end
    for _,state in pairs(self.active) do
        state.cancelled=true
        if state.handshake_future then self:_finish_handshake(state,nil,'HTTP transport closed') end
        if state.op then async.close(state.op.idle_timer); async.close(state.op.fire_timer); cancel_handle(state.op.handle) end
    end
