    stream.handle=handle
    if self.closed or self.notification_stream~=stream or stream.ignore then cancel_handle(handle); return false end
    return true
end
function Transport:close_notification_stream()
    local stream=self.notification_stream
    if not stream then return end
    self.notification_stream=nil; stream.ignore=true
