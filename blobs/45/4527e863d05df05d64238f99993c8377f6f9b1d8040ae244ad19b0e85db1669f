-- nysiis/init.lua

Nysiis = {}

function Nysiis.new()
    local self = setmetatable({}, { __index = Nysiis })
    self.vowels = {
        A = true,
        E = true,
        I = true,
        O = true,
        U = true
    }
    return self
end

function Nysiis:preprocessName(name)
    name = string.upper(name)
    name = string.gsub(name, '[^A-Z]', '')
    return name
end

function Nysiis:translate_first_characters(name)
    if string.sub(name, 1, 3) == "MAC" then
        name = "MCC" .. string.sub(name, 4)
    elseif string.sub(name, 1, 2) == "KN" then
        name = "NN" .. string.sub(name, 3)
    elseif string.sub(name, 1, 1) == "K" then
        name = "C" .. string.sub(name, 2)
    elseif string.sub(name, 1, 2) == "PH" then
        name = "FF" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "PF" then
        name = "FF" .. string.sub(name, 3)
    elseif string.sub(name, 1, 3) == "SCH" then
        name = "SSS" .. string.sub(name, 4)
    elseif string.sub(name, 1, 2) == "GB" then
        name = "J" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "KP" then
        name = "P" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "NW" then
        name = "W" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "TS" then
        name = "S" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "SH" then
        name = "S" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "BH" then
        name = "B" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "DH" then
        name = "D" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "GH" then
        name = "G" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "JH" then
        name = "J" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "KH" then
        name = "K" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "PH" then
        name = "F" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "TH" then
        name = "T" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "CH" then
        name = "C" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "GH" then
        name = "G" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "KH" then
        name = "K" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "SH" then
        name = "S" .. string.sub(name, 3)
    elseif string.sub(name, 1, 2) == "ZH" then
        name = "J" .. string.sub(name, 3)
    end
    return name
end

function Nysiis:translate_last_characters(name)
    local lastTwoChars = name:sub(-2)

    if lastTwoChars == "EE" or lastTwoChars == "IE" then
        name = name:sub(1, -3) .. "Y"
    elseif lastTwoChars == "DT" or lastTwoChars == "RT" or lastTwoChars == "RD" or lastTwoChars == "NT" or lastTwoChars == "ND" then
        name = name:sub(1, -3) .. "D"
    end
    return name
end

function Nysiis:generateKey(name)
    local key = string.sub(name, 1, 1)
    local prevChar = string.sub(name, 1, 1)

    for i = 2, string.len(name) do
        local char = string.sub(name, i, i)
        if self.vowels[char] then
            char = 'A'
        end

        char = self:translateChar(char, name, i)
        char = self:handleVowelHarmony(char, prevChar)
        char = self:ignoreTonalDifferences(char)

        if char ~= prevChar then
            key = key .. char
        end

        prevChar = char
    end

    key = self:removeTrailingS(key)
    key = self:translateAY(key)
    key = self:removeTrailingA(key)
    key = self:truncateKey(key)

    return key
end

function Nysiis:translateChar(char, name, i)
    if char == "E" and i+2 <= #name and name:sub(i+2,i+2) == "V" then
        char = "A"
    elseif char == "Q" then
        char = "G"
    elseif char == "Z" then
        char = "S"
    elseif char == "M" then
        char = "N"
    elseif char == "K" then
        if i+2 <= #name and name:sub(i+2,i+2) == "N" then
            char = name:sub(i+1,i+1)
        else
            char = "C"
        end
    elseif char == "S" and i+3 <= #name and name:sub(i+1,i+1+3) == "SCH" then
        char = "S"
    elseif char == "P" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "F"
    elseif char == "H" and (i == 1 or i+2 == #name+1 or not self.vowels[name:sub(i,i)] or not self.vowels[name:sub(i+2,i+2)]) then
        char = name:sub(i,i)
    elseif char == "W" and i > 1 and self.vowels[name:sub(i,i)] then
        char = name:sub(i,i)
    elseif char == "G" and i+2 <= #name and name:sub(i+2,i+2) == "B" then
        char = "J"
    elseif char == "K" and i+2 <= #name and name:sub(i+2,i+2) == "P" then
        char = "P"
    elseif char == "N" and i+2 <= #name and name:sub(i+2,i+2) == "W" then
        char = "W"
    elseif char == "T" and i+2 <= #name and name:sub(i+2,i+2) == "S" then
        char = "S"
    elseif char == "S" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "S"
    elseif char == "B" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "B"
    elseif char == "D" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "D"
    elseif char == "G" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "G"
    elseif char == "J" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "J"
    elseif char == "K" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "K"
    elseif char == "P" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "F"
    elseif char == "T" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "T"
    elseif char == "C" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "C"
    elseif char == "Z" and i+2 <= #name and name:sub(i+2,i+2) == "H" then
        char = "J"
    end
    return char
end

function Nysiis:handleVowelHarmony(char, prevChar)
    if self.vowels[char] and self.vowels[prevChar] then
        if prevChar == 'A' or prevChar == 'O' or prevChar == 'U' then
            if char == 'E' or char == 'I' then
                char = 'A'
            end
        elseif prevChar == 'E' or prevChar == 'I' then
            if char == 'A' or char == 'O' or char == 'U' then
                char = 'E'
            end
        end
    end
    return char
end

function Nysiis:ignoreTonalDifferences(char)
    if char >= 'A' and char <= 'Z' then
        char = string.upper(char)
    end
    return char
end

function Nysiis:removeTrailingS(key)
    if #key > 1 and key:sub(-1) == 'S' then
        key = key:sub(1, -2)
    end
    return key
end

function Nysiis:translateAY(key)
    if #key > 2 and key:sub(-2) == 'AY' then
        key = key:sub(1, -3) .. 'Y'
    end
    return key
end

function Nysiis:removeTrailingA(key)
    if #key > 1 and key:sub(-1) == 'A' then
        key = key:sub(1, -2)
    end
    return key
end

function Nysiis:truncateKey(key)
    if #key > 6 then
        key = key:sub(1, 6)
    end
    return key
end

function Nysiis:Encode(name)
    if name == "" then
        return ""
    end

    name = self:preprocessName(name)

    if #name < 2 then
        return name
    end

    name = self:translate_first_characters(name)
    name = self:translate_last_characters(name)
    key = self:generateKey(name)

    return key
end

return Nysiis