local CC = {
	["$ctcp"] = string.char(0x01),
	["$c"] = string.char(0x03),
	["$hc"] = string.char(0x04),
	["$b"] = string.char(0x02),
	["$i"] = string.char(0x1D),
	["$u"] = string.char(0x1F),
	["$s"] = string.char(0x1E),
	["$m"] = string.char(0x11),
	["$rc"] = string.char(0x16),
	["$r"] = string.char(0x0F),
}

-- format a text.
---@param s string
---@return string
local function format(s)
	s = s:gsub("%%", "%%")
	s = s:gsub("%$ctcp", CC["$ctcp"])
	s = s:gsub("%$hc", CC["$hc"])
	s = s:gsub("%$rc", CC["$rc"])
	s = s:gsub("%$([biusmcr])", function(ch)
		return CC["$" .. ch]
	end)

	return s
end

return format
