  return self[keys.remote_addr].v or ""
end

---@return string timestamp
function ReqMsg:Timestamp()
  local v = self[keys.timestamp]
  if type(v) == "table" then
    return v.v
  end

  return v
end

---@return string moduleInfo
function ReqMsg:ModuleInfo()
  local v = self[keys.module_info]
  if v then
    return v.v or ""
  end
  return ""
end

