---@param r HTTPRequestInterface
---@param module_info string? optional module info key-value string
---@param max_body_size integer? max body bytes to capture (default DEFAULT_MAX_BODY_SIZE)
---@return ReqMsg
local function newReqMsg(r, module_info, max_body_size)
  -- Guard against nil or a negative override: a negative size would make
  -- chunk:sub(1, max_body_size) index from the end and fail to truncate, so fall
  -- back to the default rather than capture an unbounded body. A resolved profile
  -- may legitimately set 0 ("capture nothing"); keep it (chunk:sub(1, 0) == "").
  if not max_body_size or max_body_size < 0 then
    max_body_size = DEFAULT_MAX_BODY_SIZE
  end

  local headerKeys = {}
  local headerValues = {}

  -- Prefer wire-ordered headers when the implementation can supply them (Kong via
  -- raw_header); this preserves order + duplicates, which order-sensitive rules
  -- (header-analysis) depend on. Fall back to the unordered get_headers() hash.
  local ordered = r:get_ordered_headers()
  if ordered then
    for _, pair in ipairs(ordered) do
      table.insert(headerKeys, newCBORString(pair[1]))
      table.insert(headerValues, newCBORString(pair[2]))
    end
  else
    for k, v in pairs(r:get_headers()) do
      for _, vv in ipairs(type(v) == "table" and v or { v }) do
        table.insert(headerKeys, newCBORString(k))
        --- vv is a string.
        ---@diagnostic disable-next-line: param-type-mismatch
        table.insert(headerValues, newCBORString(vv))
      end
    end
  end

  local truncatedBody = false
  local body = {}
  local read = 0
  repeat
    local chunk, more = r:get_body_chunk()
    if not chunk then
      break
    end

    if #chunk > max_body_size then
      chunk = chunk:sub(1, max_body_size)
      truncatedBody = true
      table.insert(body, chunk)
      break
    end

    local remaining = max_body_size - read
    if #chunk > remaining then
      chunk = chunk:sub(1, remaining)
      truncatedBody = true
    end

    read = read + #chunk
    table.insert(body, chunk)
  until not more or read >= max_body_size

  local res = {
    [keys.tls]            = string.lower(r:get_scheme()) == "https",
    [keys.host]           = newCBORString(r:get_host()),
    [keys.method]         = newCBORString(r:get_method()),
    [keys.truncated_body] = truncatedBody,
    [keys.body]           = table.concat(body),
    [keys.header_keys]    = headerKeys,
    [keys.header_values]  = headerValues,
    [keys.cookie_keys]    = {},
    [keys.cookie_values]  = {},
    [keys.url_path]       = newCBORString(r:get_path()),
    [keys.url_raw_query]  = newCBORString(r:get_raw_query()),
    [keys.remote_addr]    = newCBORString(r:get_remote_ip()),
    [keys.timestamp]      = newCBORString(currentTimestamp(r:get_now())),
  }

  -- Add module_info if provided
  if module_info and module_info ~= "" then
    res[keys.module_info] = newCBORString(module_info)
  end

  return setmetatable(res, ReqMsg)
end

function ReqMsg:encode()
  return cbor.encode(self)
end

