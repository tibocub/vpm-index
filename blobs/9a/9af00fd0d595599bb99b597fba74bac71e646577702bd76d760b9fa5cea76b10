---@class ResMsg
local ResMsg = { __tocbor = cbor.type_encoders.ordered_map }
ResMsg.__index = ResMsg

---@return boolean truncatedBody
function ResMsg:TruncatedBody()
  return self[keys.truncated_body]
end

---@return string requestID
function ResMsg:RequestID()
  return self[keys.request_id].v or ""
end

---@return string body
function ResMsg:Body()
  return self[keys.body]
end

---@return string[] headerKeys
function ResMsg:HeaderKeys()
  local headerKeys = self[keys.header_keys]
  local res = {}
  for _, v in ipairs(headerKeys) do
    table.insert(res, v.v)
  end
  return res
end

---@return string[] headerValues
function ResMsg:HeaderValues()
  local headerValues = self[keys.header_values]
  local res = {}
  for _, v in ipairs(headerValues) do
    table.insert(res, v.v)
  end
  return res
end

---@return integer statusCode
function ResMsg:StatusCode()
  return self[keys.status_code]
end

---@param r HTTPResponseInterface
---@param requestID string
---@param max_body_size integer? max body bytes to capture (default DEFAULT_MAX_BODY_SIZE)
---@return ResMsg
local function newResMsg(r, requestID, max_body_size)
  -- See newReqMsg: guard against nil or a negative override; 0 means "capture
  -- nothing" and is kept.
  if not max_body_size or max_body_size < 0 then
    max_body_size = DEFAULT_MAX_BODY_SIZE
  end

  local headerKeys = {}
  local headerValues = {}

  for k, v in pairs(r:get_headers()) do
    for _, vv in ipairs(type(v) == "table" and v or { v }) do
      table.insert(headerKeys, newCBORString(k))
      --- vv is a string.
      ---@diagnostic disable-next-line: param-type-mismatch
      table.insert(headerValues, newCBORString(vv))
    end
  end

  local truncatedBody = false
  local body = {}
  local read = 0
  repeat
    local chunk, more = r:get_body_chunk()
    if not chunk then
      break
    end

    if #chunk > max_body_size then
      chunk = chunk:sub(1, max_body_size)
      truncatedBody = true
      table.insert(body, chunk)
      break
    end

    local remaining = max_body_size - read
    if #chunk > remaining then
      chunk = chunk:sub(1, remaining)
      truncatedBody = true
    end

    read = read + #chunk
    table.insert(body, chunk)
  until not more or read >= max_body_size

  local res = {
    [keys.truncated_body] = truncatedBody,
    [keys.body] = table.concat(body),
    [keys.header_keys] = headerKeys,
    [keys.header_values] = headerValues,
    [keys.status_code] = r:get_status(),
    [keys.request_id] = newCBORString(requestID),
  }


  return setmetatable(res, ResMsg)
end


function ResMsg:encode()
  return cbor.encode(self)
end

