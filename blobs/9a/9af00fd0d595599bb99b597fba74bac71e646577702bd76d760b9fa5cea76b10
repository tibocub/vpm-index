--- SettingsMsg is the body a module sends after the 16-byte SettingsRPC header.
--- It carries the module's last-known profiles hash so the Inspector can skip
--- re-sending an unchanged profile set (a conditional, 304-style fetch). Mirrors
--- the Go sdk.SettingsRPCRequest ({ "profiles_hash": "<hex>" }).
---@class SettingsMsg
local SettingsMsg = {}
SettingsMsg.__index = SettingsMsg

function SettingsMsg:encode()
  return cbor.encode(self)
end

---@param profilesHash string? the last-known profiles hash (empty/nil on first
---   fetch or after an inline correction, forcing a full resend)
---@return SettingsMsg
local function newSettingsMsg(profilesHash)
  local res = {
    [keys.profiles_hash] = newCBORString(profilesHash or ""),
  }

  return setmetatable(res, SettingsMsg)
end

--- @class SettingsRPCResponse
--- @field profiles_hash string the hash of the Inspector's current profile set
--- @field profiles table[]? the profile list; absent when the sent hash matched
local SettingsRPCResponse = {}

-- True for a Lua table whose keys are exactly 1..#t (an array, possibly empty).
-- A CBOR array decodes to such a table; a CBOR map does not. Used to reject a
-- map-shaped `profiles` that would otherwise empty the cache via ipairs().
local function isArrayLike(t)
  local n = 0
  for k in pairs(t) do
    if type(k) ~= "number" or k % 1 ~= 0 or k < 1 then
      return false
    end
    n = n + 1
  end

  return n == #t
end

--- Decode a SettingsRPC response body. Returns the raw decoded table (with
--- snake_case keys mirroring sdk.SettingsRPCResponse / sdk.InspectionProfile);
--- the profiles resolver consumes the plain profile tables directly.
---@param b string the encoded response body
---@return SettingsRPCResponse? res
---@return string? err
local function decodeSettingsResponse(b)
  local success, decoded = pcall(cbor.decode, b)
  if not success then
    return nil, decoded
  end

  -- Guard against a malformed or misaligned read: setmetatable would raise on a
  -- scalar, and a table-shaped-but-wrong payload could be mistaken for a valid
  -- response and leave the poller on stale settings. profiles_hash is always
  -- present in a real SettingsRPCResponse, so require it as a string.
  if type(decoded) ~= "table" or type(decoded.profiles_hash) ~= "string" then
    return nil, "malformed settings response (missing profiles_hash)"
  end

  -- profiles, when present, must be an array (the Inspector sends a CBOR array).
  -- Reject a non-array (e.g. a CBOR map) so ProfileCache:replace's ipairs() can't
  -- silently empty the cache on a misaligned read.
  if decoded.profiles ~= nil and not (type(decoded.profiles) == "table" and isArrayLike(decoded.profiles)) then
    return nil, "malformed settings response (profiles is not an array)"
  end

  return setmetatable(decoded, { __index = SettingsRPCResponse }), nil
end

