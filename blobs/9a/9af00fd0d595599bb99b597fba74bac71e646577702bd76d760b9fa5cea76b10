local cbor = require "cbor"

-- Default maximum number of body bytes captured into an inspection RPC message
-- (request or response). The body is truncated to this size and the message's
-- truncated_body flag is set. Callers can override per-call via the
-- max_body_size argument to newReqMsg/newResMsg (e.g. from a plugin config);
-- 10 KB matches the platform's `api` inspection profile.
local DEFAULT_MAX_BODY_SIZE = 10000

--- Current time as an RFC3339 string with microsecond resolution and a 'Z'
--- (UTC) suffix, matching the nginx module's ngx_impart_get_time_literal and
--- the platform's microsecond timestamp standard. A caller may inject the current
--- time as (sec, usec) for a runtime whose clock the generic SDK should not reach
--- for directly (e.g. the HAProxy plugin's core.now()); otherwise OpenResty/Kong's
--- ngx.now() supplies sub-second precision and plain Lua falls back to os.time()
--- at second resolution.
---@param sec integer? injected epoch seconds (skips ngx/os.time when provided)
---@param usec integer? injected microseconds (defaults to 0)
---@return string
local function currentTimestamp(sec, usec)
  if not sec then
    if ngx and ngx.now then
      local t = ngx.now()
      sec = math.floor(t)
      usec = math.floor((t - sec) * 1000000 + 0.5)
      -- Guard the rare rounding carry into the next whole second.
      if usec >= 1000000 then
        sec = sec + 1
        usec = 0
      end
    else
      sec = os.time()
      usec = 0
    end
  end

  return string.format("%s.%06dZ", os.date("!%Y-%m-%dT%H:%M:%S", sec), usec or 0)
end

---@class CBORString_mt
local CBORString_mt = {
  __tocbor = function(s) return cbor.type_encoders.utf8string(s.v) end,
  __tostring = function(s) return s.v end,
  __eq = function(a, b) return a.v == b.v end,
  __lt = function(a, b) return a.v < b.v end,
  __le = function(a, b) return a.v <= b.v end,
  __concat = function(a, b) return a.v .. b.v end,
  __len = function(s) return #s.v end,

}

---@param v string
---@return CBORString_mt
local function newCBORString(v)
  return setmetatable({ v = v }, CBORString_mt)
end

local keys = {
  body = newCBORString("body"),
  cookie_keys = newCBORString("cookie_keys"),
  cookie_values = newCBORString("cookie_values"),
