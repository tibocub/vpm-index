---@class whop.products.Options
---@field api_key? string|distilled.Secret|fun(host: table): (string|distilled.Secret|nil, distilled.Error?) Required; from $WHOP_API_KEY
---@field api_version_date? string from $WHOP_API_VERSION_DATE; default 2026-09-25
---@field base_url? string from $WHOP_API_BASE_URL; default https://api.whop.com/api/v1
---@field host? table The host seams: transport, sleep, now, exec, random, getenv, epoch
---@field transport? fun(request: table): (table?, distilled.Error?)
---@field sleep? fun(seconds: number)
---@field now? fun(): number
---@field retry? string|table A retry preset or policy fields
---@field deadline_s? number Wall-clock budget for one call, sleeps included
---@field tracing? "off"|"operation"|"debug"|table
---@field validation? "lenient"|"additional"|"strict"
---@field [string] any

---@class whop.products.Module
local Module = {}

---@param options? whop.products.Options
---@return whop.products.Client
function Module.new(options) end

---@class whop.products.Client
local Client = {}

---A client sharing this one's budget, credentials cache and tracer, with overrides.
---@param options whop.products.Options
---@return whop.products.Client
function Client:with(options) end

---Flush spans and release what the client holds.
function Client:close() end

---Create Product
---
---Creates a new product for an account.
---
---`POST /products`
---Errors: Conflict.
---@param input whop.products.CreateProductRequest
---@return whop.products.Product? value
---@return distilled.Error? err
function Client:create_product(input) end

---Delete Product
---
---Deletes a product. Only products with no memberships, entries, reviews, or invoices can be deleted.
---
---`DELETE /products/{id}`
---Errors: NotFound.
---@param input whop.products.DeleteProductRequest
---@return whop.products.DeleteProductResponse? value
---@return distilled.Error? err
function Client:delete_product(input) end

---Retrieve Product
---
---Retrieves a product. Public — no credentials.
---
---`GET /products/{id}`
---Errors: NotFound.
---@param input whop.products.GetProductRequest
---@return whop.products.Product? value
---@return distilled.Error? err
function Client:get_product(input) end

---List Products
---
---Returns a paginated list of products. Omit `account_id` to search the public marketplace.
---
---`GET /products`
---Errors: BadRequest.
---@param input? whop.products.ListProductsRequest
---@return whop.products.ListProductsResponse? value
---@return distilled.Error? err
function Client:list_products(input) end

---List Products
---
---Returns a paginated list of products. Omit `account_id` to search the public marketplace.
---
---Every page, fetched as the loop asks for it.
---
---`GET /products`
---Errors: BadRequest.
---@param input? whop.products.ListProductsRequest
---@return distilled.Iterator<whop.products.ListProductsResponse>
function Client:list_products_pages(input) end

---List Products
---
---Returns a paginated list of products. Omit `account_id` to search the public marketplace.
---
---Every item of every page (`data`).
---
---`GET /products`
---Errors: BadRequest.
---@param input? whop.products.ListProductsRequest
---@return distilled.Iterator<whop.products.ProductListItem>
function Client:list_products_items(input) end

---Publish Product
---
---Submits a product to the whop.com marketplace for review. The product moves to `pending_review`; a Whop reviewer approves it before it goes live. Requires a logo, a headline, and at least one gallery image or video; the request fails naming whichever is missing.
---
---`POST /products/{id}/publish`
---Errors: NotFound, Conflict.
---@param input whop.products.PublishProductRequest
---@return whop.products.Product? value
---@return distilled.Error? err
function Client:publish_product(input) end

---Unpublish Product
---
---Removes a product from the whop.com marketplace. The product moves to `not_available`.
---
---`POST /products/{id}/unpublish`
---Errors: NotFound, Conflict.
---@param input whop.products.UnpublishProductRequest
---@return whop.products.Product? value
---@return distilled.Error? err
function Client:unpublish_product(input) end

---Update Product
---
---Updates an existing product.
---
---`PATCH /products/{id}`
---Errors: NotFound.
---@param input whop.products.UpdateProductRequest
---@return whop.products.Product? value
---@return distilled.Error? err
function Client:update_product(input) end

return Module
