-- λabc.acb              C    Cardinal              Moses Schönfinkel    1924
functional.C = function(a)
   return function(b)
      return function(c)
         return a(b)(c)
      end
   end
end

-- λa.aa                 M    Mockingbird           Raymond Smullyan     1985
functional.M = function(a)
   return a(a)
end

-- λabc.a(bc)            B    Bluebird              Moses Schönfinkel    1924
functional.B = function(a)
   return function(b)
      return function(c)
         return a(b(c))
      end
   end
end

-- λabcd.a(bcd)          B₁   Blackbird             Haskell Curry        1931
functional.B1 = function(a)
   return function(b)
      return function(c)
         return function(d)
            return a(b(c)(d))
         end
      end
   end
end

-- λab.ba                T    Thrush
functional.T = function(a)
   return function(b)
      return b(a)
   end
end

-- λabc.cab              V    Vireo
functional.V = function(a)
   return function(b)
      return function(c)
         return c(a)(b)
      end
   end
end

-- Fixed-point combinator
-- Y=λf.(λx.f(xx))(λx.f(xx))
-- For eager languages like Lua:
-- Z=λf.(λx.f(λy.xxy))(λx.f(λy.xxy))
functional.Y = function(f)
   return (function(x)
      return f(function(...)
         return x(x)(...)
      end)
   end)(function(x)
      return f(function(...)
         return x(x)(...)
      end)
   end)
end

-- This works too
functional.YY = function(f)
   return (function(x)
      return x(x)
   end)(function(x)
      return f(function(...)
         return x(x)(...)
      end)
   end)
end

