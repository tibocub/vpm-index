--- Maps a function to a table
-- function map
-- tparam function f the function to map
-- tparam table seq input table
-- return the table mapped
-- usage local table = functional.map(function (x) return x + a end, { 1, 2})
--

--- Hola
-- @function map
-- @tparam function f function to map
-- @param seq something that can be iterated
function functional.map(f, seq)
   return fun.totable(fun.map(f, seq))
end

function functional.map_reduce(f, g, init, seq)
   return fun.reduce(g, init, fun.map(f, seq))
end

function functional.prepend(prefix, list)
   assert(prefix)
   if list == nil then
      return ""
   else
      local result = table.concat(
         fun.totable(fun.map(function(x)
            return ("%s %s"):format(prefix, x)
         end, list)),
         " "
      )
      return result
   end
end

function functional.reverse_table(t)
   return fun.reduce(function(acc, x)
      table.insert(acc, 1, x)
      return acc
   end, {}, t)
end

function functional.trampoline(f, ...)
   local result = f(...)
   while type(result) == "function" do
      result = result()
   end
   return result
end

--- converts a boolean into yes or no
-- @function yon
---@tparam boolean predicate
function functional.yon(predicate)
   if predicate then
      return "y"
   else
      return "n"
   end
end

--- binds parameters to a function
-- @function bind
-- @tparam function function
function functional.bind(f, ...)
   local bound_args = table.pack(...)
   local number_of_bound_args = bound_args.n
   return function(...)
      local actual_args = table.pack(...)
      local number_of_actual_args = actual_args.n
      local calling_args = {}
      local number_of_calling_args = number_of_bound_args + number_of_actual_args
      fun.each(function(i)
         if i <= number_of_bound_args then
            calling_args[i] = bound_args[i]
         else
            calling_args[i] = actual_args[i - number_of_bound_args]
         end
      end, fun.range(number_of_calling_args))
      return f(table.unpack(calling_args, 1, number_of_calling_args))
   end
end

--- Complement Functor
-- @param predicate
-- @return complement of predicate
function functional.complement(predicate)
   return function(...)
      return not predicate(...)
   end
end

--- Compositor Functor
-- @param list of functions: f1, f2, f3, ..., fn-1, fn
-- @return function fn(fn-1(...(f3(f2(f1))))))
function functional.compose(...)
   local list_of_functions = { ... }
   -- Can be written using function name
   return functional.Y(function(rec)
      return function(...)
         local args = { ... }
         -- return functional.Y(function(rec)
         local result = table.pack(list_of_functions[1](table.unpack(args)))
         table.remove(list_of_functions, 1)
         if #list_of_functions == 0 then
            return table.unpack(result)
         else
            return rec(table.unpack(result))
         end
      end
   end)
end

function functional.memoize(f)
   local cache = {}
   --- TODO: use hash to compute index for various parameters
   --return function(...)
   return function(x)
      if cache[x] == nil then
         cache[x] = f(x)
      end
      return cache[x]
   end
end

-- Combinators

-- λa.a                  I    Identity              Moses Schönfinkel    1924
functional.I = function(a)
   return a
end

-- λab.a                 K    Kestrel               Moses Schönfinkel    1924
functional.K = function(a)
   return function(_)
      return a
   end
end

-- λab.b                 κ    Kite
functional.Ki = function(_)
   return function(b)
      return b
   end
end

-- λab.abb               W    Warbler               Haskell Curry        1931
