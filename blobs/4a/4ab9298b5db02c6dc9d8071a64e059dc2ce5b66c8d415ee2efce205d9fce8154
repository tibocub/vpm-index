local functional = {}

--- Concatenate a list of tables
-- @int a The first number
-- @int b The second number
-- @return a table contatenated
-- @usage local table = functional.contatenate_tables({ 1, 2}, { 3, 4})
function functional.concatenate_tables(...)
   local function _concat(t1, t2)
      for _, v in ipairs(t2) do
         t1[#t1 + 1] = v
      end
      return t1
   end
   return fun.reduce(_concat, {}, { ... })
end

--- extracts keys from a map and sort them in a map
-- @function sorted_keys
-- @tparam table the map
function functional.sorted_keys(t)
   local sorted_keys = {}
   for k, _ in pairs(t) do
      table.insert(sorted_keys, k)
   end
   table.sort(sorted_keys, function(a, b)
      return tostring(a) < tostring(b)
   end)
   return sorted_keys
end

function functional.iter_sorted(t)
   local sorted_keys = functional.sorted_keys(t)
   -- print(inspect(sorted_keys))
   return fun.map(function(k)
      return k, t[k]
   end, sorted_keys)
end

