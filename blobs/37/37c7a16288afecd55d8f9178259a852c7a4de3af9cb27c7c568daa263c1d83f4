---
--- Creates a new object-based Random instance.
---
--- Initializes a deterministic pseudo-random number generator (PRNG)
--- using the provided seed. If the seed is nil or zero, a new 32-bit
--- seed is generated automatically.
---
--- @param initial_seed number?  Optional seed for deterministic behavior.
--- @return Random instance  Newly created Random object.
---
--- @usage
--- local rng = Random.new(12345)
--- 
--- @usage
--- local rng = Random.new() -- to Auto-generated seed
---
-----------------------------------------------------------------------
function M.Random.new(initial_seed)
    local self = setmetatable({
        perm = nil,
        seed = initial_seed or M.Random.defaults.seed,
        prng = nil,
    }, M.Random)
    if self.seed == 0 or self.seed == nil then
        self.seed = generate_32bit_seed()
    end
    self.prng = generate_prng(self.seed)
    return self
end

return M