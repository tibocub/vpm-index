-----------------------------------------------------------------------
---
--- Computes 2D Perlin noise at the given coordinates.
---
--- Generates smooth gradient noise using the classic Perlin noise
--- algorithm. The function determines surrounding grid corners,
--- computes gradient dot products, and interpolates them using
--- the Perlin fade curve for smooth transitions.
---
--- A permutation table is used for gradient hashing and may be
--- supplied manually or generated automatically if absent.
---
--- @param x number                 X coordinate input.
--- @param y number                 Y coordinate input.
--- @param permutable table?        Optional permutation table used for hashing. If nil, the instance's internal table is used or generated automatically.
--- @param args PerlinArguments?    Optional configuration table.
--- @return number value            The resulting Perlin noise value
---
--- @usage
--- local value = rng:perlin_noise2(10.5, 20.25)
--- 
--- @usage
--- local scaled = rng:perlin_noise2(10, 20, nil, { scale = 0.1 })
---
-----------------------------------------------------------------------
function M.Random:perlin_noise2(x, y, permutable, args)
    local scale = 1.0
    if args then scale = args["scale"] or scale end
    permutable = permutable or self.perm
    if not permutable then self:generate_permutable(PERMUTABLE_DEFAULT) end
    x = (x + .0) * scale
    y = (y + .0) * scale
    local perm_size = #permutable / 2
    local floored_x = math.floor(x) + .0
    local floored_y = math.floor(y) + .0
    local xf0 = x - floored_x
    local yf0 = y - floored_y
    local xf1 = xf0 - 1.0
    local yf1 = yf0 - 1.0
    local xi = floored_x % perm_size + 1
    local yi = floored_y % perm_size + 1
    local u = M.Random.perlin_fade(xf0)
    local v = M.Random.perlin_fade(yf0)
    local bottom_left = permutable[permutable[xi + 0] + yi + 0]
    local bottom_right = permutable[permutable[xi + 1] + yi + 0]
    local top_left = permutable[permutable[xi + 0] + yi + 1]
    local top_right = permutable[permutable[xi + 1] + yi + 1]
    local dot_bottom_left = M.Random.perlin_hashing2(bottom_left, xf0, yf0)
    local dot_bottom_right = M.Random.perlin_hashing2(bottom_right, xf1, yf0)
    local dot_top_left = M.Random.perlin_hashing2(top_left, xf0, yf1)
    local dot_top_right = M.Random.perlin_hashing2(top_right, xf1, yf1)
    local m = lerp(dot_bottom_left, dot_bottom_right, u)
    local n = lerp(dot_top_left, dot_top_right, u)
    return lerp(m, n, v)
end

-----------------------------------------------------------------------
---
--- Generates 2D fractal Perlin noise using multiple octaves.
---
--- Combines several layers (octaves) of 2D Perlin noise to produce
--- richer and more detailed patterns. Each octave modifies the
--- amplitude and frequency according to persistence and lacunarity.
--- The final result is normalized by the total accumulated amplitude
--- to keep output values within a predictable range.
---
--- @param x number                 X coordinate input.
--- @param y number                 Y coordinate input.
--- @param permutable table?        Optional permutation table used for hashing. If nil, the instance's internal table is used or generated automatically.
--- @param octaves integer          Number of noise layers to combine.
--- @param args table?              Optional configuration table.
--- @return number value            The normalized fractal noise value.
---
--- @usage
--- local value = rng:fractal_perlin2(10, 20, nil, 4)
--- 
--- @usage
--- local detailed = rng:fractal_perlin2(10, 20, nil, 6, {
---     persistence = 0.5,
---     lacunarity = 2.0,
---     scale = 0.1
--- })
