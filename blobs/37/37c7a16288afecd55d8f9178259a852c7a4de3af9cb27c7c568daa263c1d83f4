function M.Random:fractal_perlin2(x, y, permutable, octaves, args)
    permutable = permutable or self.perm
    if not permutable then self:generate_permutable(PERMUTABLE_DEFAULT) end
    local persistence = 0.5
    local lacunarity = 2.0
    if args then
        persistence = args["persistence"] or persistence
        lacunarity = args["lacunarity"] or lacunarity
    end
    local total = 0.0
    local freq = 1.0
    local amplitude = 1.0
    local max_amp = 0.0
    for i = 1, octaves do
        total = total + self:perlin_noise2(x, y, permutable, args)
        max_amp = max_amp + amplitude
        amplitude = amplitude * persistence
        freq = freq * lacunarity
    end
    return total / max_amp
end

