local build = {}

local fs = require("luarocks.fs")
local util = require("luarocks.util")
local cfg = require("luarocks.core.cfg")

local builtin = require 'luarocks.build.builtin'

function build.run(rockspec, no_install)
    assert(rockspec:type() == "rockspec")

    local build = rockspec.build

    util.variable_substitutions(build, rockspec.variables)

    local env = {
        CC = cfg.variables.CC,
    }

    -- 1. run build command
    if build.build_command then
        util.printout(build.build_command)
        if not fs.execute_env(env, build.build_command) then
            return nil, "Failed building."
        end
    end

    -- 2. run builtin build and install
    local ok, err = builtin.run(rockspec, no_install)
    if not ok then
        return nil, err
    end

    -- 3. run install command
    if build.install_command and not no_install then
        util.printout(build.install_command)
        if not fs.execute_env(env, build.install_command) then
            return nil, "Failed installing."
        end
    end
    return true
end

return build
