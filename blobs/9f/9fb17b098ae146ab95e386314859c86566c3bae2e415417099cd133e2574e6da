-- agent.commands: layered Lua and Markdown slash commands.
--
-- One `commands/` directory per config layer (from `panto.ext.dirs`),
-- searched lowest priority first:
--
--     base:    <XDG_DATA_HOME>/panto/agent/commands
--     user:    <XDG_CONFIG_HOME>/panto/commands
--     project: <cwd>/.panto/commands
--     local:   <cwd>/.panto/local/commands

local uv = require("luv")
local panto = require("panto")

-- See init.lua: `panto-agent.commands` installed, plain `commands` when the
-- directory is scanned. Derive the sibling prefix from our own module name.
local frontmatter = require(((...) or ""):match("^(.-)[^.]*$") .. "frontmatter")

local M = { name = "agent.commands" }

local function await(label, arm)
    local co = assert(coroutine.running(), label .. ": await must run inside a coroutine")
    local res
    arm(function(...)
        res = table.pack(...)
        local ok, err = coroutine.resume(co)
        if not ok then error(err, 0) end
    end)
    coroutine.yield()
    return table.unpack(res, 1, res.n)
end

local function fs_open(path) return await("fs_open", function(done) uv.fs_open(path, "r", 0, done) end) end
local function fs_fstat(fd) return await("fs_fstat", function(done) uv.fs_fstat(fd, done) end) end
local function fs_read(fd, size) return await("fs_read", function(done) uv.fs_read(fd, size, 0, done) end) end
local function fs_close(fd) return await("fs_close", function(done) uv.fs_close(fd, done) end) end
local function fs_scandir(path) return await("fs_scandir", function(done) uv.fs_scandir(path, done) end) end

local function read_all(path)
    local _, fd = fs_open(path)
    if not fd then return nil end
    local _, stat = fs_fstat(fd)
    local _, text
    if stat and stat.type == "file" then _, text = fs_read(fd, stat.size) end
    fs_close(fd)
    return text
end

local function list_dir(path)
    local _, req = fs_scandir(path)
    if not req then return {} end
    local names = {}
    while true do
        local name, kind = uv.fs_scandir_next(req)
        if not name then break end
        if kind == "file" and (name:match("%.lua$") or name:match("%.md$")) then
            names[#names + 1] = name
        end
    end
    table.sort(names)
    return names
end

local function metadata(text)
    local meta, body = frontmatter.parse(text)
    return type(meta) == "table" and meta or {}, body
end

--- A frontmatter value only counts when YAML gave us a non-empty string:
--- `name: 3` parses to a number, and coercing it would invent a command name.
local function str(value)
    return type(value) == "string" and value ~= "" and value or nil
end

function M.parse_markdown(text, filename)
    local meta, body = metadata(text)
    local fallback = filename:match("^(.*)%.md$")
    local name = str(meta.name) or fallback
    return {
        name = name,
        description = str(meta.description) or "Submit this prompt.",
        handler = function(args)
            local prompt = body:gsub("%$ARGUMENTS", function() return args end)
            panto.ext.agent:submit(prompt)
        end,
    }
end

--- Each config layer's `commands/`, lowest priority first.
function M.command_dirs()
    local dirs = {}
    for _, layer in ipairs(panto.ext.dirs.layers) do
        dirs[#dirs + 1] = layer.dir .. "/commands"
    end
    return dirs
end

local function load_command(path, filename)
    local text = assert(read_all(path), "failed to read " .. path)
    if filename:match("%.md$") then return M.parse_markdown(text, filename) end
    local chunk = assert(load(text, "@" .. path))
    return chunk()
end

function M.discover(dirs)
    local commands = {}
    for _, dir in ipairs(dirs) do
        local layer = {}
        for _, filename in ipairs(list_dir(dir)) do
            local path = dir .. "/" .. filename
            local command = load_command(path, filename)
            assert(type(command) == "table", path .. " must return a command table")
            assert(type(command.name) == "string" and command.name ~= "",
                path .. " has no command name")
            assert(not layer[command.name],
                "duplicate command '" .. command.name .. "' in " .. dir)
            layer[command.name] = true
            commands[command.name] = command
        end
    end
    return commands
end

function M.activate()
    local commands = M.discover(M.command_dirs())
    local names = {}
    for name in pairs(commands) do names[#names + 1] = name end
    table.sort(names)
    for _, name in ipairs(names) do panto.ext.register_command(commands[name]) end
end

return M
