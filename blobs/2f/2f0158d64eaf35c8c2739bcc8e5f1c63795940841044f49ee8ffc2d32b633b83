local function blend(base, accent, percent)
    local q = 100 - percent
    return {
        r = math.floor((base.r * q + accent.r * percent) / 100),
        g = math.floor((base.g * q + accent.g * percent) / 100),
        b = math.floor((base.b * q + accent.b * percent) / 100),
    }
end

local function fg(color)
    return string.format("\27[38;2;%d;%d;%dm", color.r, color.g, color.b)
end

local function bg(color)
    return string.format("\27[48;2;%d;%d;%dm", color.r, color.g, color.b)
end

local function derive(p)
    local values = {
        canvas_fg = fg(p.canvas_fg),
        canvas_bg = bg(p.canvas_bg),
        dim = fg(p.muted),
        assistant = fg(p.canvas_fg),
        user = fg(p.canvas_fg),
        tool = fg(p.accent),
        footer = fg(p.muted),
        tool_text = fg(p.canvas_fg),
        tool_pending = fg(p.muted),
        tool_success = fg(p.success),
        tool_error = fg(p.err),
        compaction_header = fg(p.warn),
        thinking_header = fg(p.purple),
        cursor = "\27[7m",
        err = fg(p.err),
        welcome = fg(p.accent),
        waiting_peak = fg(p.canvas_fg),
        waiting_near = fg(p.secondary),
        waiting_far = fg(p.muted),
        err_diff = fg(p.err),
        add_diff = fg(p.success),
        thinking = fg(p.muted),
        compaction = fg(p.muted),

        user_bg = bg(p.surface),
        tool_pending_bg = bg(p.surface),
        tool_success_bg = bg(blend(p.canvas_bg, p.success, 20)),
        tool_error_bg = bg(blend(p.canvas_bg, p.err, 20)),
        diff_remove_bg = bg(p.diff_remove_bg or blend(p.canvas_bg, p.err, 20)),
        diff_add_bg = bg(p.diff_add_bg or blend(p.canvas_bg, p.success, 20)),
        user_text = fg(p.canvas_fg),
        tool_header = fg(p.accent),

        syntax_base = fg(p.canvas_fg),
        syntax_comment = fg(p.muted),
        syntax_string = fg(p.syntax_string),
        syntax_number = fg(p.syntax_number),
        syntax_keyword = fg(p.syntax_keyword),
        syntax_function = fg(p.syntax_function),
        syntax_type = fg(p.syntax_type),
        syntax_variable = fg(p.syntax_variable),
        syntax_tag = fg(p.syntax_tag),

        reset = "\27[0m",
    }
    return values
end

local M = {}

function M.activate()
    local panto = require("panto")
    for _, item in ipairs(palettes) do
        local exists = pcall(panto.ext.style, item.name)
        if not exists then
            panto.ext.style(item.name, derive(item.palette))
        end
    end
end

function M.values(name)
    for _, item in ipairs(palettes) do
        if item.name == name then
            return derive(item.palette)
        end
    end
end

return { name = "themes.popular", activate = M.activate, values = M.values }
