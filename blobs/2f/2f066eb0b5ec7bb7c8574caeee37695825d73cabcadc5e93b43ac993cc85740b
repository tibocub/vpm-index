    [18] = decode_string,       -- Assigned Client Identifier
    [19] = decode_2byte,        -- Server Keep Alive
    [21] = decode_string,       -- Authentication Method
    [22] = decode_binary,       -- Authentication Data
    [23] = decode_byte,         -- Request Problem Information
