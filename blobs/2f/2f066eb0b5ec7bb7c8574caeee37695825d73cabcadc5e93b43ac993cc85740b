        end
    end
end

function mt:_hangup (reason_code, msg)
    self:_send_disconnect(reason_code, {})
    if self.logger then
        self.logger:error('MQTT HANGUP: ' .. msg)
    end
    local sock = self.socket
    sock:close()
    self.socket = nil
    return nil, msg
end

