local shape_chunks = {}
for i = 1, 5 do
  shape_chunks[i] = MODULE .. string.format(".shapes_%03d", i)
end

local where -- shape name -> file number, built on the first lookup

-- The registry: a lookup of a shape not loaded yet loads its whole file. An unknown name is nil. A
-- missing file raises, as a missing module does.
local shapes = setmetatable({}, {
  __index = function(registry, name)
    if where == nil then
      where = {}
      for file, shape in string.gmatch(SHAPES, "(%d+) ([^\n]+)") do
        where[shape] = file
      end
      SHAPES = nil
    end
    local file = where[name]
    if file == nil then
      return nil
    end
    for k, node in pairs(require(MODULE .. ".shapes_" .. file)) do
      rawset(registry, k, node)
    end
    return rawget(registry, name)
  end,
})

local classes = {}

classes.Forbidden = errors.define({
  tag = "Forbidden",
  categories = { "AuthError" },
  matchers = { { status = 403 } },
  fields = { "message", "body" },
})
classes.NotFound = errors.define({
  tag = "NotFound",
  categories = { "BadRequestError" },
  matchers = { { status = 404 } },
  fields = { "message", "body" },
})
classes.PaymentRequired = errors.define({
  tag = "PaymentRequired",
  categories = { "QuotaError" },
  matchers = { { status = 402 } },
  fields = { "message", "body" },
})
classes.VerificationRequired = errors.define({
  tag = "VerificationRequired",
  categories = {},
  matchers = { { status = 451 } },
  fields = { "message", "body" },
})

local ops = {}
for i = 1, 1 do
  for name, op in pairs(require(MODULE .. string.format(".ops_%03d", i))) do
    ops[name] = op
  end
end

return {
  name = "coinflow.merchant",
  shapes = shapes,
  errors = classes,
  ops = ops,
  shape_chunks = shape_chunks,
  telemetry = {
    system = "coinflow-api",
    prefix = "Coinflow",
    service = "Merchant",
    labels = "coinflow",
    propagate = "w3c",
    response_headers = {
      { header = "x-request-id", name = "http.response.header.x-request-id", transform = "list" },
      { header = "request-id", name = "http.response.header.request-id", transform = "list" },
    },
  },
}
