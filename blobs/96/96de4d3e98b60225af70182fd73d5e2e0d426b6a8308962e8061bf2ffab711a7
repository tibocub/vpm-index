classes.DeletionProtectionEnabled = errors.define({
  tag = "DeletionProtectionEnabled",
  categories = { "ConflictError" },
  matchers = { { status = 409, message = { includes = "Deletion protection is enabled" } } },
  fields = { "message" },
})
classes.FeatureUnavailable = errors.define({
  tag = "FeatureUnavailable",
  categories = { "AuthError" },
  matchers = {
    { status = 403, message = { includes = "pricing package" } },
    { status = 403, message = { includes = "is not enabled for this organization" } },
    { status = 403, message = { includes = "early access API endpoint" } },
  },
  fields = { "message" },
})
classes.InstanceLimitReached = errors.define({
  tag = "InstanceLimitReached",
  categories = { "ConflictError" },
  matchers = { { status = 409, message = { includes = "INSTANCE_LIMIT_REACHED" } } },
  fields = { "message" },
})
classes.ServiceNotIdle = errors.define({
  tag = "ServiceNotIdle",
  categories = { "BadRequestError" },
  matchers = {
    { status = 400, message = { includes = "Service must be in idle state to awake" } },
  },
  fields = { "message" },
})
classes.ServiceNotTerminable = errors.define({
  tag = "ServiceNotTerminable",
  categories = { "ConflictError" },
  matchers = { { status = 409, message = { includes = "can be terminated" } } },
  fields = { "message" },
})

