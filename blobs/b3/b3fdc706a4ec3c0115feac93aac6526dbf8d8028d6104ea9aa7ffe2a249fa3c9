--- Request builder for the Azure REST API.
-- @module resty.azure.api.request.build
local cjson = require("cjson.safe")

--- Builds a request object to be used with the Azure REST API.
-- @tparam string method The HTTP method to use for the request.
-- @tparam table body The request body to send with the request.
-- @tparam string token The Azure access token to use for authentication.
-- @tparam[opt=true] boolean ssl Whether or not to use SSL for the request.
-- @tparam[opt] table proxy_opts Optional proxy configuration options.
-- @treturn table The request object to be used with the Azure REST API.
local function build_request(method, body, token, ssl, proxy_opts, extra_headers)
  assert(method, "no method defined")
  assert(token, "no token defined")
  assert(method == "GET" or
    method == "POST" or
    method == "PUT" or
    method == "PATCH" or
    method == "DELETE",
    "invalid HTTP method")

  local ssl_verify = ssl ~= false

  local headers = {
    ["Authorization"] = "Bearer " .. token,
    ["Content-Type"] = "application/json; charset=utf-8"
  }
  if extra_headers then
    for k, v in pairs(extra_headers) do
      headers[k] = v
    end
  end

  local body_str
  local content_type = headers["Content-Type"]
  if type(body) == "table" and content_type and content_type:find("application/json", 1, true) then
    body_str = cjson.encode(body)
  else
    body_str = body
  end

  local request = {
    method = method,
    headers = headers,
    body = body_str,
    ssl_verify = ssl_verify
  }

  -- Add proxy options if provided
  if type(proxy_opts) == "table" then
    request.proxy_opts = proxy_opts
  end

  return request
end

return build_request
