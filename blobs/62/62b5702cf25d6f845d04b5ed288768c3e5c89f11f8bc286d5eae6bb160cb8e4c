-- ============================================================
-- Shiva Num
-- Number utility library.
-- ============================================================

local Num = {}

--- Clamp a number between min and max
---@param n number
---@param min number
---@param max number
---@return number
function Num.clamp(n, min, max)
    if n < min then return min end
    if n > max then return max end
    return n
end

--- Round to specified decimal places
---@param n number
---@param decimals? integer Default: 0
---@return number
function Num.round(n, decimals)
    decimals = decimals or 0
    local mult = 10 ^ decimals
    return math.floor(n * mult + 0.5) / mult
end

--- Format as currency string
---@param n number
---@param symbol? string Default: '$'
---@return string
function Num.currency(n, symbol)
    symbol = symbol or '$'
    local negative = n < 0
    n = math.abs(n)
    local formatted = string.format('%.2f', n)
    -- Add comma separators
    local int, dec = formatted:match('(%d+)(%.%d+)')
    int = int:reverse():gsub('(%d%d%d)', '%1,'):reverse():gsub('^,', '')
    local result = symbol .. int .. dec
    if negative then result = '-' .. result end
    return result
end

--- Format with comma separators
---@param n number
---@return string
function Num.format(n)
    local formatted = string.format('%d', math.floor(n))
    ---@diagnostic disable-next-line: redundant-return-value
    return formatted:reverse():gsub('(%d%d%d)', '%1,'):reverse():gsub('^,', '')
end

--- Format as percentage
---@param n number Value between 0 and 1
---@param decimals? integer Default: 0
---@return string
function Num.percent(n, decimals)
    decimals = decimals or 0
    return string.format('%.' .. decimals .. 'f%%', n * 100)
end

--- Format as compact (1K, 1M, 1B)
---@param n number
---@param decimals? integer Default: 1
---@return string
function Num.compact(n, decimals)
    decimals = decimals or 1
    local abs = math.abs(n)
    local sign = n < 0 and '-' or ''
    if abs >= 1e9 then
        return sign .. string.format('%.' .. decimals .. 'fB', abs / 1e9)
    elseif abs >= 1e6 then
        return sign .. string.format('%.' .. decimals .. 'fM', abs / 1e6)
    elseif abs >= 1e3 then
        return sign .. string.format('%.' .. decimals .. 'fK', abs / 1e3)
    end
    return sign .. tostring(math.floor(abs))
end

--- Linear interpolation
---@param a number Start value
---@param b number End value
---@param t number Progress (0-1)
---@return number
function Num.lerp(a, b, t)
    return a + (b - a) * Num.clamp(t, 0, 1)
end

--- Inverse linear interpolation (find t given a value between a and b)
---@param a number Start value
---@param b number End value
---@param value number
---@return number t Progress (0-1)
function Num.inverseLerp(a, b, value)
    if a == b then return 0 end
    return Num.clamp((value - a) / (b - a), 0, 1)
end

--- Map a value from one range to another
---@param value number
---@param fromMin number
---@param fromMax number
---@param toMin number
---@param toMax number
---@return number
function Num.map(value, fromMin, fromMax, toMin, toMax)
    local t = Num.inverseLerp(fromMin, fromMax, value)
    return Num.lerp(toMin, toMax, t)
end

--- Check if number is between min and max (inclusive)
---@param n number
---@param min number
---@param max number
---@return boolean
function Num.between(n, min, max)
    return n >= min and n <= max
end

--- Calculate percentage of a total
---@param part number
---@param total number
---@return number Percentage (0-100)
function Num.percentOf(part, total)
    if total == 0 then return 0 end
    return (part / total) * 100
end

--- Random integer between min and max (inclusive)
---@param min integer
---@param max integer
---@return integer
function Num.random(min, max)
    return math.random(min, max)
end

--- Random float between min and max
---@param min number
---@param max number
---@return number
function Num.randomFloat(min, max)
    return min + math.random() * (max - min)
end

--- Convert meters to feet
---@param meters number
---@return number
function Num.metersToFeet(meters)
    return meters * 3.28084
end

--- Convert km/h to mph
---@param kmh number
---@return number
function Num.kmhToMph(kmh)
    return kmh * 0.621371
end

--- Convert mph to km/h
---@param mph number
---@return number
function Num.mphToKmh(mph)
    return mph * 1.60934
end

return Num
