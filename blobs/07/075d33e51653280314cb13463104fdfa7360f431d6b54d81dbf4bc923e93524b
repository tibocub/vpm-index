-- nvim-vale-tools/lua/config.lua

local M = {}
local utils = require("nvim_vale_tools.utils")
local vale_utils = require("nvim_vale_tools.vale_utils")

--- Default Vale configuration.
M.default_config = {
	-- Move Vale directory to stdpath("data")/vale-tools/
	vale_dir = vim.fs.joinpath(vim.fn.stdpath("data"), "vale-tools"),

	-- Main configuration file name
	config_file = ".vale.ini",

	-- Packages to sync (downloaded by `vale sync` into StylesPath)
	packages = {
		"RedHat",
		"alex",
	},

	-- File-specific rules (e.g., for .md files)
	file_rules = {
		["*.md"] = {
			["RedHat.GitLinks"] = "NO",
			["RedHat.Symbols"] = "NO",
		},
	},

	-- Core options for .vale.ini
	config_options = {
		-- Use absolute path for StylesPath (inside stdpath("data"))
		StylesPath = vim.fs.joinpath(vim.fn.stdpath("data"), "vale-tools", "styles"),
		MinAlertLevel = "suggestion",
	},

	-- Automatically set VALE_CONFIG_PATH
	set_env_var = true,
}

--- Get merged configuration (default + user).
---@param user_config table|nil Optional user configuration
---@return table Merged configuration
function M.get_config(user_config)
	return vim.tbl_deep_extend("force", M.default_config, user_config or {})
end

--- Create Vale configuration directory and files.
---@param config table Configuration to apply
function M.create_vale_config(config)
	local vale_dir = config.vale_dir
	local config_file = vim.fs.joinpath(vale_dir, config.config_file)

	-- Create ~/.config/vale directory if it doesn't exist (to avoid Vale errors)
	local legacy_vale_dir = vim.fn.expand("~/.config/vale")
	if vim.fn.isdirectory(legacy_vale_dir) == 0 then
		vim.fn.mkdir(legacy_vale_dir, "p")
	end

	-- Check if Vale directory already exists and has files
	if vim.fn.isdirectory(vale_dir) == 1 then
		local files = vim.fn.readdir(vale_dir)
		if #files > 0 then
			vim.notify(
				string.format(
					"Vale directory '%s' already exists\nand is not empty. Skipping setup",
					vale_utils.shorten_path(vale_dir)
				),
				vim.log.levels.WARN
			)
			return false
		end
	end

	-- Create Vale directory if it doesn't exist or is empty
	utils.ensure_dir(vale_dir)

	-- Write .vale.ini
	local config_content = M._generate_config_file(config)
	utils.write_file(config_file, config_content)

	-- Create styles directory (Vale sync will populate it)
	local styles_dir = config.config_options.StylesPath
	utils.ensure_dir(styles_dir)

	-- Set VALE_CONFIG_PATH to the .vale.ini file
	if config.set_env_var then
		vale_utils.set_vale_config_path(config_file)
	end

	-- Run 'vale sync' automatically after setup
	if vim.fn.executable("vale") == 1 then
		vale_utils.sync_vale_packages(vale_dir, config_file)
	else
		vim.notify("'vale' executable not found.\nInstall Vale first, then run ':Vale sync'", vim.log.levels.WARN)
	end

	return true
end

--- Generate content for .vale.ini.
---@param config table Configuration table
---@return string File content
function M._generate_config_file(config)
	local lines = {
		"; Vale configuration file",
		"; Generated by nvim-vale-tools",
		"",
		-- Core options first (StylesPath, MinAlertLevel)
		string.format("StylesPath = %s", config.config_options.StylesPath),
		string.format("MinAlertLevel = %s", config.config_options.MinAlertLevel),
		"",
		-- Packages to sync
		string.format("Packages = %s", table.concat(config.packages, ", ")),
		"",
		-- Global section
		"[*]",
		-- Include "Vale" in BasedOnStyles (it's built-in)
		string.format("BasedOnStyles = Vale, %s", table.concat(config.packages, ", ")),
	}

	-- Add file-specific rules (e.g., for .md files)
	for file_pattern, rules in pairs(config.file_rules) do
		table.insert(lines, "")
		table.insert(lines, string.format("[%s]", file_pattern))
		for rule, value in pairs(rules) do
			table.insert(lines, string.format("%s = %s", rule, value))
		end
	end

	return table.concat(lines, "\n")
end

return M
