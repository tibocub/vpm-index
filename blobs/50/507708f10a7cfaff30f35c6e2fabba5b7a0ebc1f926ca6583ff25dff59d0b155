-- nvim_vale_tools/lua/init.lua

local M = {}

local config = require("nvim_vale_tools.config")
local commands = require("nvim_vale_tools.commands")

--- Setup the plugin.
---@param user_config table|nil Optional user configuration
function M.setup(user_config)
	local vale_config = config.get_config(user_config)
	commands.setup_commands(vale_config)
end

return M
