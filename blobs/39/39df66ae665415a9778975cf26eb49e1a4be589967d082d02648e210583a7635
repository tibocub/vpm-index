local NetaceaCookies = require 'netacea_cookies'
local constants = require 'netacea_constants'
local ingest = require 'ingest'
local util = require 'netacea_util'

-- Session: everything captured from the request, plus the protector verdict
-- once it's fetched (see netacea_protector.lua). Built once per request by
-- parse() and carried into the http-res phase via txn:set_priv()/get_priv()
-- so it can be read again without round-tripping each field through a
-- stringified txn variable.

local session_mod = {}

-- Determines NetaceaUserIdCookieStatus for the ingest record: NEW when
-- there's no session cookie to evaluate, VALID/EXPIRED from decoding it when
-- an encryption key is configured. Without a key the cookie can't be
-- decrypted/verified at all, so it's treated as NEW rather than guessed at.
-- Also returns the user id embedded in the cookie (for VALID/EXPIRED) so the
-- ingest record's UserId can reuse it instead of minting a new one. Also
-- returns should_revalidate: the inverse of parseNetaceaSessionCookie's
-- valid flag, i.e. false only when the cookie is still within its grace
-- period and the request's IP still matches the one it was issued for. Also
-- returns the match/mitigate/captcha verdict embedded in the cookie when
-- it's valid, so a still-fresh cookie's verdict can be reused as-is.
local function cookie_status(cookie_value, cookie_encryption_key, client_ip)
    if cookie_value == "" or not cookie_encryption_key then
        return constants.userIdCookieStatus.NEW, nil, true
    end

    local parsed = NetaceaCookies.parseNetaceaSessionCookie(cookie_value, cookie_encryption_key, client_ip)
    local should_revalidate = not parsed.valid

    if parsed.valid then
        return constants.userIdCookieStatus.VALID, parsed.user_id, should_revalidate,
            parsed.data.mat, parsed.data.mit, parsed.data.cap
    elseif parsed.reason == constants.issueReasons.EXPIRED_SESSION then
        return constants.userIdCookieStatus.EXPIRED, parsed.user_id, should_revalidate
    end

    return constants.userIdCookieStatus.NEW, nil, should_revalidate
end

function session_mod.parse(txn, config, mode)
    local cookie_name = config.cookie_name or "netacea_session"
    local cookie_encryption_key = config.cookie_encryption_key
    local customer_session_id_header_name = config.customer_session_id_header_name
    local req_headers = txn.http:req_get_headers()

    local function hdr(name)
        local value = req_headers[name]
        return value and value[0] or ""
    end

    -- HAProxy exposes repeated occurrences of the same header as a
    -- zero-based array (req_headers[name][0], [1], ...). A trusted proxy
    -- appending its own X-Forwarded-For as a second occurrence rather than
    -- extending the first would otherwise have its value discarded by
    -- hdr()'s [0]-only lookup, letting an attacker-controlled first
    -- occurrence be selected instead. Joining every occurrence in order
    -- before splitting on commas keeps real_ip_header_index (esp. the
    -- default -1) referring to the last value appended by any hop.
    local function all_hdr(name)
        local value = req_headers[name]
        if not value then
            return ""
        end
        local parts = {}
        local i = 0
        while value[i] ~= nil do
            parts[#parts + 1] = value[i]
            i = i + 1
        end
        return table.concat(parts, ",")
    end

    local cookie_header = hdr("cookie")
    local cookie_value = util.extract_cookie_value(cookie_header, cookie_name)
    local source_ip = util.safe_call(function() return txn.f:src() end) or ""
    local client_ip = util.resolve_client_ip(all_hdr, source_ip, config.real_ip_header, config.real_ip_header_index)
    local status, user_id, should_revalidate, match, mitigate, captcha =
        cookie_status(cookie_value, cookie_encryption_key, client_ip)

    local customer_session_id
    if customer_session_id_header_name and customer_session_id_header_name ~= "" then
        local value = hdr(customer_session_id_header_name:lower())
        customer_session_id = value ~= "" and value or nil
    end

    local session = {
        mode = mode,
        start_time = util.now(),
        cookie_name = cookie_name,
        client_ip = client_ip,
        had_session = util.find_cookie(cookie_header, cookie_name) ~= nil,
        cookie_status = status,
        should_revalidate = should_revalidate,
        user_id = user_id,
        user_agent = hdr("user-agent"),
        customer_session_id = customer_session_id,
        match = match or constants.idTypes.NONE,
        mitigate = mitigate or constants.mitigationTypes.NONE,
        captcha = captcha or constants.captchaStates.NONE,
    }

    -- Ingest data is captured for every request regardless of protection
    -- mode - INGEST mode only means "don't call the protector API", it
    -- doesn't gate whether the request/response gets sent to Kinesis. Skip
    -- the capture entirely when ingest is disabled, since none of it would
    -- be read.
    if ingest.enabled then
        session.ingest = {
            method = util.safe_call(function() return txn.f:method() end) or "",
            path = util.safe_call(function() return txn.f:path() end) or "",
            query = util.safe_call(function() return txn.f:query() end) or "",
            protocol = "HTTP/" .. (util.safe_call(function() return txn.f:req_ver() end) or "1.1"),
            host = util.safe_call(function() return txn.f:hdr("host") end) or "",
            client_ip = client_ip,
            user_agent = session.user_agent,
            xff = hdr("x-forwarded-for"),
            referer = hdr("referer"),
        }
    end

    return session
end

-- Builds a Set-Cookie value for the session's current verdict, or nil if
-- cookie issuance isn't configured (no encryption key set). Reuses
-- session.user_id when the request already carried one (from a valid or
-- expired cookie) so the id stays stable across reissues; mints a fresh one
-- otherwise and stores it back on the session so the ingest record's UserId
-- matches the id actually placed in the cookie.
function session_mod.build_set_cookie(session, config)
    local cookie_encryption_key = config.cookie_encryption_key
    if not cookie_encryption_key then
        return nil
    end

    session.user_id = session.user_id or NetaceaCookies.newUserId()

    local issue_reason = session.had_session and constants.issueReasons.FORCED_REVALIDATION
        or constants.issueReasons.NO_SESSION

    local is_blocking = session.mitigate == constants.mitigationTypes.BLOCKED
        or session.mitigate == constants.mitigationTypes.HARDBLOCKED
        or session.mitigate == constants.mitigationTypes.MONETISED
    -- A protector_error means the verdict baked into this cookie is just the
    -- NONE default, not a real verdict, so the cookie must not grant a grace
    -- period that lets the next request skip Protector on the strength of
    -- it. Still issue the cookie (with a non-positive grace period) so a
    -- first-time visitor gets a stable user id; parseNetaceaSessionCookie
    -- treats a non-positive grace period as already-expired, so the next
    -- request's should_revalidate comes back true and Protector is retried.
    local grace_period = (is_blocking or session.protector_error) and -60 or 60

    local cookie_value = NetaceaCookies.generateNewCookieValue(
        cookie_encryption_key,
        session.client_ip,
        session.user_id,
        NetaceaCookies.newUserId(),
        issue_reason,
        os.time(),
        grace_period,
        session.match,
        session.mitigate,
        session.captcha
    )

    return NetaceaCookies.createSetCookieValues(session.cookie_name, cookie_value.session_jwe, 86400)
end

return session_mod
