local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; local pcall = _tl_compat and _tl_compat.pcall or pcall; local string = _tl_compat and _tl_compat.string or string; local table = _tl_compat and _tl_compat.table or table; local lfs = require("lfs")

local file_discovery = {}

local function is_directory(path)
   local mode, _ = lfs.attributes(path, "mode")
   return mode == "directory"
end

local function collect_tl_files_in_dir(dir, out, errors)
   local results = { pcall(lfs.dir, dir) }
   local ok = results[1]
   if not ok or type(results[2]) ~= "function" then
      local reason = ok and "unexpected lfs.dir failure" or tostring(results[2])
      table.insert(
      errors, string.format("cannot read directory '%s': %s", dir, reason))

      return
   end
   local iter = results[2]
   local state = results[3]
   local names = {}
   for name in iter, state do
      if name:sub(1, 1) ~= "." then
         table.insert(names, name)
      end
   end
   table.sort(names)
   for _, name in ipairs(names) do
      local child = dir .. "/" .. name
      if is_directory(child) then
         collect_tl_files_in_dir(child, out, errors)
      elseif child:sub(-3) == ".tl" then
         table.insert(out, child)
      end
   end
end

function file_discovery.expand_paths(paths)
   local all_files = {}
   local errors = {}
   for _, path in ipairs(paths) do
      if is_directory(path) then
         collect_tl_files_in_dir(path, all_files, errors)
      else
         table.insert(all_files, path)
      end
   end
   return all_files, errors
end

return file_discovery
