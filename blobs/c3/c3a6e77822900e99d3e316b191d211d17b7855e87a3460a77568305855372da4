local typedefs = require "kong.db.schema.typedefs"

local PLUGIN_NAME = "authz"

local schema = {
  name = PLUGIN_NAME,
  fields = {
    { consumer = typedefs.no_consumer },
    { protocols = typedefs.protocols_http },
    { config = {
        type = "record",
        fields = {
          {
            authorization = typedefs.header_name {
              required = true,
              default = "Authorization"
            }
          },
          {
            username = {
              type = "string",
              required = true,
              unique = true
            },
          },
          {
            password = {
              type = "string",
              required = true
            },
          },
          {
            authz_endpoint = typedefs.url {
              required = true
            }
          },
        },
      },
    },
  }
}

return schema
