local http = require "resty.http"
local utils = require "kong.tools.utils"
local json = require "cjson"

local find = string.find
local sub = string.sub
local unpack = table.unpack

local user_id
local company_id
local body_response

local Authz = {
  PRIORITY = 1000,
  VERSION = "1.0.1",
}

local function tokenize(str, div, len)
  local result, pos = {}, 0

  local iter = function()
    return find(str, div, pos, true)
  end

  for st, sp in iter do
    result[#result + 1] = sub(str, pos, st-1)
    pos = sp + 1
    len = len - 1
    if len <= 1 then
      break
    end
  end

  result[#result + 1] = sub(str, pos)
  return result
end

function Authz:access(conf)
  local auth = kong.request.get_header(conf.authorization)
  local access_token = auth:gsub("Bearer ", "")
  local header_64, claims_64, signature_64 = unpack(tokenize(access_token, ".", 3))

  local data = json.decode(ngx.decode_base64(claims_64))
  user_id = data["user_id"]
  company_id = data["company_id"]

  if not user_id then
    kong.log.err("user_id not found in JWT token")
    return kong.response.exit(401, { message = "user_id not found in token" })
  end

  if not company_id then
    kong.log.err("company_id not found in JWT token")
    return kong.response.exit(401, { message = "company_id not found in token" })
  end

  local username = conf.username 
  local password = conf.password

  local basic_auth = "Basic " .. ngx.encode_base64(username .. ":" .. password)

  local httpc = http.new()
  local res, err = httpc:request_uri(conf.authz_endpoint .. "/users/" .. user_id .. "/roles" .. "?company_id=" .. company_id, {
    method = "GET",
    ssl_verify = false,
    headers = {
      ["Content-Type"] = "application/json",
      ["Authorization"] = basic_auth
    }
  })

  kong.log.notice(basic_auth)

  if not res then
      kong.log.err("failed to call authz endpoint: ", err)
      return kong.response.exit(500, err)
  end

  if res.status ~= 200 then
    kong.log.err("failed to call authz endpoint")
    return kong.response.exit(res.status, res.body)
  end
  
  body_response = json.decode(res.body)
  local roles = body_response["data"]["roles"]
  local return_roles = ""

  for k,v in pairs(roles) do
    if (k == 1)
    then
      return_roles = v
    else
      return_roles = return_roles .. "," .. v
    end
  end
  kong.log.notice(return_roles)
  kong.service.request.set_header("X-Consumer-Roles", return_roles)
  kong.service.request.set_header("X-Company-Id", tostring(company_id))
  kong.service.request.set_header("X-User-Id", tostring(user_id))
end

return Authz
