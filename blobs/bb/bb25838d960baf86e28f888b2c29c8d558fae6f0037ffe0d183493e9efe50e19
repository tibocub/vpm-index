local access = require "kong.plugins.google-storage-adapter.access"
local header_filter = require "kong.plugins.google-storage-adapter.header_filter"

local GoogleStorageAdapterHandler = {
  VERSION = "3.21.0",
  PRIORITY = 901,
}

function GoogleStorageAdapterHandler:access(conf)
  access.execute(conf)
end

function GoogleStorageAdapterHandler:header_filter(conf)
  header_filter.execute(conf)
end

return GoogleStorageAdapterHandler