#!/usr/bin/env lua5.3

local unix = require "unix"
local notify = require "cqueues.notify"


local _methods = {}

---
-- Setups a scratch file to enqueue.
--
-- This isn't strictly necessary; almost anything will do. But
-- this safely handles creating the new file, as well as giving it
-- a name that will assist with proper queue sorting.
--
function _methods.setup( this )

	local rfile = assert(io.open("/dev/urandom", "r"))
	local rand = 0

	for i = 1, 4 do
		rand = rand + (string.byte(rfile:read(1)) * 256^i)
	end

	rfile:close()

	local now = unix.gettimeofday()
	local name =  string.format("%.6f-%d", now, rand)
	local path = this.path .. '/temp/' .. name
	local f = assert(io.open(path, "w"))

	return string.match(path, "%/([^%/]*)$"), f

end


---
-- Enqueues a file.
--
function _methods.enqueue( this, file )

	assert(file, "No filename provided")

	local cur = this.path .. '/temp/' .. file
	local dest = this.path .. '/enqueued/' .. file

	local fd = assert( io.open( cur, "r" ) )
	unix.rename(cur, dest)
	unix.fsync(fd)
	fd:close()

end


---
-- Pulls a file from the queue for processing.
--
-- Returns either a valid file, or nil if nothing processable is
-- in the queue.
--
-- If 'explicit' is specified, it must be a valid file pending in
-- the queue. The specified file will be dequeued, or nil and an
-- error message is returned.
--
-- If 'explicit' is nil, the first queued file will be dequeued and
-- returned, unless there are not processable files, in which case
-- dqueue() will return nil. It is possible in certain race conditions
-- hat nil could be returned even if there are processable files: for
-- correct usage, call dequeue(), and if nil, check the count of list()
-- and repeat.
--
-- In any case or use mode, it is still necessary to call cleanup()
-- on the returned file name later, or else queue's work directory
-- will fill up with stale files.
--
function _methods.dequeue( this, explicit )

	local file
	local status

	repeat

		local in_queue, queue_err = this:list()

		if not in_queue then
			return nil, queue_err
		end

		if explicit then
			for i, item in ipairs(in_queue) do	-- luacheck: ignore 213
				if item == explicit then
					file = item
					break
				end
			end

			if not file then
				return nil, "Requested file not in queue"
			end
		else
			if #in_queue <= 0 then
				return nil, "Queue Empty"
			end

			file = in_queue[1]
		end


		local old_spot = this.path .. '/enqueued/' .. file
		local new_spot = this.path .. '/process/' .. file
		local err, ecode  -- luacheck: ignore 231

		-- atomic on POSIX-compliant filesystems, and "more" atomic on
		-- NFS than rename
		status, err, ecode = unix.link( old_spot, new_spot )

		if status then
			unix.unlink(old_spot)
		end

		--
		-- If it's already in 'processed', it's being worked,
		-- and shouldn't be in the queue directory.
		--
		-- So cleanup.
		--
		if ecode == unix.EEXIST then
			unix.unlink(old_spot)
		end

	until status

	return file

end


---
-- Make sure the last bits of the file, now processed, are removed.
--
function _methods.cleanup( this, file )

	local f = this.path .. '/process/' .. file
	assert(unix.unlink(f))

end


---
-- Show what's currently in the queue, sorted in priority order.
--
function _methods.list( this )

	local valid_files = {}
	local dir, err = unix.opendir( this.path .. '/enqueued' )

	if not dir then
		return nil, err
	end

	local function add_if_valid( file )
		-- skip NFS lockfiles generated on some systems
		if string.match(file.name, "%.nfs%w+") then
			return
		end

		local s = unix.stat( this.path .. '/enqueued/' .. file.name)

		-- race condition: if a different process/thread pulls a file
		-- while we enumerate, stat may fail. silently drop the entry
		-- as it is no longer in the queue.
		if not s then
			return
		end

		if not unix.S_ISREG(s.mode) then
			return
		end

		valid_files[ #valid_files + 1 ] = {
			name = file.name,
			age = s.mtime
		}
	end

	local function add_all()
		for queued_file in dir:files() do
			add_if_valid(queued_file)
		end

		unix.closedir( dir )
	end

	local res, err2 = pcall(add_all)
	if not res then
		-- Very difficult to trip but sometimes happens in the
		-- real world.
		-- luacov: disable
		return nil, err2
		-- luacov: enable
	end

	table.sort(valid_files, function(a, b)
		if a.age == b.age then
			return a.name < b.name
		end

		return a.age < b.age
	end)

	local ret = {}
	for i, v in ipairs(valid_files) do
		ret[i] = v.name
	end

	return ret

end


--
-- Wait until a new object enters the queue.
--
function _methods.wait( this, timeout )

	--
	-- Skip calling cqueues if we already have a queued task
	--
	if #(this:list()) > 0 then
		return
	end

	for change in this.notify:changes(timeout) do
		--
		-- XXX: NetBSD returns "Modify" in all cases,
		-- whereas Linux is more specific. So we'll fire
		-- every time except DELETE.
		--
		-- Well behaved users of diskqueue.lua know that,
		-- because of race conditions, you aren't guarenteed
		-- a file when diskqueue:wait() returns. And thus, the
		-- design decision to return too often instead of
		-- too little.
		--
		if notify[change] ~= 'DELETE' then
			return
		end
	end

end


---
-- Open a task file, either enqueued or not.
--
function _methods.open_task( this, filename, mode )

	local flags

	if mode == 'r' then
		flags = unix.O_RDONLY
	elseif mode == 'w' then
		flags = unix.O_RDWR
	elseif mode == nil then
		flags = unix.O_RDWR
	else
		error("Unknown mode")
	end

	local path = this.path .. '/temp/' .. filename
	local f = unix.open( path, flags )

	if f then
		return unix.fdopen(f)
	end

	path = this.path .. '/process/' .. filename
	local f2, err = unix.open( path, flags )

	if f2 then
		return unix.fdopen(f2)
	end

	return nil, err

end


---
-- Open a task file currently in an enqueued state. Limited to
-- read-only.
--
function _methods.peek( this, filename )

	local path = this.path .. '/enqueued/' .. filename
	local f, err = unix.open( path, unix.O_RDONLY )

	if f then
		return unix.fdopen(f)
	end

	return nil, err

end


---
-- Close a queue. This is to free associated OS level file
-- handles, such as the notify() listener.
--
function _methods.close( this )

	--
	-- XXX: cqueues doesn't seem to have a way to do this yet.
	-- Hopefully this will speed up garbage collection
	--
	this.notify = nil	--

end


---
-- The following make diskqueue a fully cqueues compatible object.
--
function _methods.pollfd( this )
	return this.notify:pollfd()
end

function _methods.events( this )
	return this.notify:events()
end

function _methods.timeout( this )
	return this.notify:timeout()
end



local _M = {}

---
-- Create a new queue.
--
-- The queue path must not exist, or be an existing queue. The
-- necessary directory structure will be created if the queue does not
-- exist.
--
function _M.open( queue_path )

	unix.mkpath( queue_path .. '/temp' )
	unix.mkpath( queue_path .. '/enqueued' )
	unix.mkpath( queue_path .. '/process' )

	local ret = {
		path = queue_path,
		notify = notify.opendir( queue_path .. '/enqueued' )
	}

	return setmetatable(ret, { __index = _methods })

end

return _M
