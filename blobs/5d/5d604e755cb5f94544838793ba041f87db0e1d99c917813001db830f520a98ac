function db:update(row,recno)
  if row.html and row.html ~= '' then
    row.plain = string.gsub(row.html,"<br>","\r\n")
    row.plain = string.gsub(row.plain,"<[^>]*>","")
  end
end

function db:menu(row)
  local recno = row and row.rowid
  local menu = {}
  if recno then
    if string.len(row.html or "") > 0 then
      tins(menu,{'mails','Html',{act="show",html="true",recno=recno} })
      if self.conf.cli then
        tins(menu,{'mails','Raw',{act="show",html="raw",recno=recno} })
      end
    end
    if tonumber(row.status) == 1 then
      tins(menu,{"mails",'Reply',{act="new",reply=recno} })
      tins(menu,{"mails",'Info',{act="info",recno=recno} })
    end
    if tonumber(row.status) == 2 then
      tins(menu,{"mails",'Send',{act="send",recno=recno} })
    end
  elseif self.conf.cli then
    tins(menu,{"mails",'Get',{act="checkbox",login=params.login,status=params.status}})
    if params.status == 0 then
      tins(menu,{"mails",'Fetch',{act="show",status=10}})
    end
    if self.user.admin and params.login then
      tins(menu,{"mails",'List',{act="boxes",login=params.login}})
      tins(menu,{"mails",'Shell',{act="imap",login=params.login}})
    end

  else
    tins(menu,{"mails",'Get',{act="checkbox",edfrm="fndfrm"}})
  end

  return menu
end

function db:gethtml(recno)
  local qry = concat{"select html,plain from mail.mails where rowid = '",recno,"'"}
  for html,plain in self.conn:urows(qry) do
    if html and #html > 0 then
      html = string.gsub(html,"(src[\"'=%s]*)cid:([^\"'%s]+)",
            function(src,cid)
              return concat{src,self.conf.idx,"?mod=mails&act=cid&cid=",cid,"&recno=",recno}
            end)
      return html
    elseif plain and #plain > 0 then
      return plain:gsub("\n","<br/>")
    end
  end
  return ""
end

