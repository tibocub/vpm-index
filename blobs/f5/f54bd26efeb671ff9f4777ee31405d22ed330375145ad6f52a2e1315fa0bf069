local function inventory()
    local profiles = require("subagents.spawn").profiles()
    local workflows = require("subagents.toml_workflows").workflows()
    local lines = { "# Discovered subagents", "", "Subagent profiles:" }
    local function entries(list, workflow_entries)
        if #list == 0 then lines[#lines + 1] = "  (none)" end
        for _, entry in ipairs(list) do
            local detail = workflow_entries and entry.definition or entry
            local description = detail and detail.description
            lines[#lines + 1] = "  " .. entry.name ..
                (entry.error and (" — unavailable: " .. entry.error) or
                (description and description ~= "" and (" — " .. description) or ""))
        end
    end
    local function warnings(heading, found)
        if #found == 0 then return end
        lines[#lines + 1] = ""
        lines[#lines + 1] = heading
        for _, warning in ipairs(found) do lines[#lines + 1] = "  " .. warning end
    end
    entries(profiles.list)
    warnings("Profile warnings:", profiles.warnings)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "Workflow profiles:"
    entries(workflows.list, true)
    warnings("Workflow warnings:", workflows.warnings)
    return table.concat(lines, "\n")
end

return setmetatable({}, {
    __index = function(_, topic)
        if not require("subagents.namespace").called_by_primary() then return nil end
        if topic == "inventory" then return inventory() end
        return topics[topic]
    end,
    __newindex = function() error("subagents docs are read-only", 2) end,
    __metatable = false,
})
