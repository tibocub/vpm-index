local topics = {
    recipes = [=[
# Orchestration recipes

Use `subagents.run` for one background delegation. It returns a name such as `agent-1` immediately; completion wakes you with its output. Use `std.lua` scripts for dynamic fan-out, branching, or staged waves.

A `std.lua` script has access to `subagents.workflow`, `subagents.workflows`, and `subagents.agents`. Pass workflow-local inline profiles as the second argument; they shadow discovered profiles only for that workflow. Put the complete, specific context each worker needs in that worker's `prompt`. Start a background workflow and save its returned record:

```lua
return subagents.workflow(function(ctx)
  local a = ctx:agent{name="api", system_prompt="Research APIs.", prompt="Inspect the API surface."}
  local b = ctx:agent{name="tests", system_prompt="Research tests.", prompt="Inspect test coverage."}
  local research = ctx:await({a, b}, "all")

  local implementation = ctx:agent{
    name="implement",
    system_prompt="Implement focused changes.",
    prompt="Implement using this research:\n" .. research[1].output .. "\n" .. research[2].output,
  }:await()

  local reviewers = {
    ctx:agent{name="correctness", system_prompt="Review correctness.", prompt=implementation.output},
    ctx:agent{name="simplicity", system_prompt="Review for simplicity.", prompt=implementation.output},
  }
  local reviews = ctx:await(reviewers, "all")
  return reviews[1].output .. "\n\n" .. reviews[2].output
end)
```

Workflow callbacks run in background coroutines, not registered tool-handler coroutines, so they cannot call `panto.ext.call_tool`, `panto.ext.start_tool`, or `tools.*`. Use those only in the top-level `std.lua` script.

**Program, don't transcribe.** A `std.lua` script is a program, not a transcript: write each piece of text once and let code produce the variations. Templates are the one mechanism: a `[[long string]]` with `{name}` placeholders, filled by `template:gsub("{([%w_]+)}", vars)` where `vars` is a table. Do not use `string.format`, `..` chains, or any other placeholder style. Near-identical prompts come from a loop over a data table, never copy-pasted per child; a shared system prompt goes in `profiles` once, not in every `ctx:agent`. Children share your workspace, so a prompt can name a file to read instead of quoting its contents. If the script is mostly quoted text, that is the signal to factor it.

```lua
local brief = [[
Audit the {area} module under {root} for unchecked errors. Read-only.
Report as a bullet list; end with RESULT={"issues":<count>}
]]
return subagents.workflow(function(ctx)
  local workers = {}
  for _, area in ipairs({"auth", "billing", "search"}) do
    workers[#workers + 1] = ctx:agent{name=area, profile="auditor",
      prompt=brief:gsub("{([%w_]+)}", {area=area, root="src/"})}
  end
  local out = {}
  for _, r in ipairs(ctx:await(workers, "all")) do out[#out + 1] = r.output end
  return table.concat(out, "\n\n")
end, { profiles = {
  { name = "auditor", system_prompt = "Audit one area carefully." },
} })
```

**Deterministic code drives; agents advise.** A workflow is code you control wrapped around judgment you cannot. Put every decision that can be nailed down into Lua — loops, counts, ordering, retries, pass/fail gates — and spend agents only on discovery and judgment. When Lua needs a fact an agent found (a list to fan out over, a verdict, a chosen option), tell that agent to end its report with one machine-parseable line, parse it, and let the parsed value shape the rest of the graph. `json.encode(value)` and `json.decode(text)` are available; invalid JSON makes `json.decode` raise, and JSON `null` decodes to the truthy `json.null` sentinel.

```lua
return subagents.workflow(function(ctx)
  local found = ctx:agent{
    name="inventory",
    system_prompt="Inventory work items. Read-only.",
    prompt="List every open PR in owner/repo. End with exactly one line: RESULT={\"prs\":[<numbers>]}",
  }:await()

  local line = found.output and found.output:match("RESULT=([^\n]+)")
  local items
  if line then
    local ok, decoded = pcall(json.decode, line)
    if ok and decoded ~= json.null then items = decoded end
  end
  if type(items) ~= "table" or not items.prs then return "inventory produced no parseable RESULT line" end

  local reviewers = {}
  for _, pr in ipairs(items.prs) do
    reviewers[#reviewers + 1] = ctx:agent{
      name = "review-" .. pr,
      system_prompt = "Review one pull request.",
      prompt = "Review PR #" .. pr .. " in owner/repo.",
    }
  end

  local reviews, out = ctx:await(reviewers, "all"), {}
  for _, review in ipairs(reviews) do out[#out + 1] = review.output end
  return table.concat(out, "\n\n")
end)
```

Every `ctx:agent` needs a non-empty `name` unique within that workflow. A workflow callback must return a string. Inspect a running or finished workflow with a later `std.lua` script, for example:

```lua
local w = subagents.workflows["workflow-1"]
return w.status .. (w.result and ("\n" .. w.result) or "")
```

Agent fields are `name`, `status`, `output`, `error`, and `id`; `agent:cancel()` requests cancellation and returns true only while it is running. Workflow fields are `id`, `status`, `result`, `error`, and `agents`; `workflow:cancel()` requests cancellation of every running agent. All records are read-only.

**Children wake you; never wait for them.** Completion arrives as a new turn carrying the agent's output or the workflow's result (or the error), for `subagents.run`, `std.lua`, and `subagents.workflow` (including workflows the user starts with `/workflow:<name>`); inspect the corresponding table only for more, such as individual workers inside a workflow or a truncated report. There is no need to keep the tool-call loop alive until then: do not run `sleep` via `shell` or re-inspect `subagents.agents`/`subagents.workflows` in a loop, since those calls burn tokens and delay nothing but your own response. If you have other useful work, do it; otherwise end your turn.
