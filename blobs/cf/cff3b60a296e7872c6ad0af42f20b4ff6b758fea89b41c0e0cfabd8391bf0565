    function tglpopup(img){
      var max = '800px';

      var div = $(img).parent();
      var pp = $("#imgpopup");
      var ppp = $("#imgpopupcontent");

      if($(img).css('max-width') == max){
        div.html();
        div.parent().css('display','none');
        return;
      }

      var pos = $(img).position();
      pp.css('top',pos.top - 70);

      if(pp.css('display') == 'none'){

        ppp.html(div.html());
        var ppimg = ppp.children();

        ppimg.css('max-width',max);
        ppimg.css('max-height',max);
        ppimg.css('min-width',20);

        pp.css('display','block');
      }else{
        pp.html();
        pp.css('display','none');
      }

    }

    function dragImg(img) {
      var imgdiv = img.parentElement.parentElement;
      var pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
      if (document.getElementById(imgdiv.id + "header")) {
        document.getElementById(imgdiv.id + "header").onmousedown = dragMouseDown;
      } else {
        imgdiv.onmousedown = dragMouseDown;
      }

      function dragMouseDown(e) {
        e = e || window.event;
        e.preventDefault();
        pos3 = e.clientX;
        pos4 = e.clientY;
        document.onmouseup = closeDragElement;
        document.onmousemove = elementDrag;
      }

      function elementDrag(e) {
        e = e || window.event;
        e.preventDefault();
        pos1 = pos3 - e.clientX;
        pos2 = pos4 - e.clientY;
        pos3 = e.clientX;
        pos4 = e.clientY;
        imgdiv.style.top = (imgdiv.offsetTop - pos2) + "px";
        imgdiv.style.left = (imgdiv.offsetLeft - pos1) + "px";
      }

      function closeDragElement(e) {
        document.onmouseup = null;
        document.onmousemove = null;
      }

      //resize
      $('#imgpopupresize').mousedown(function(e) {
        e.preventDefault();
        $(document).mousemove(function(e) {
            $("#imgpopupcontent img").css("width", e.pageX - imgdiv.offsetLeft + 2);
        })
      });

      $(document).mouseup(function(e) {
        $(document).unbind('mousemove');
      });

    };


  ]],
  columns=3,
}


