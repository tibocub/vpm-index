function db:main(out)
  --self.conn:exec(concat{"attach database '",self.conf.db,".files' as files"})
  local act = params.act
  local sort = params.sort
  if act == 'show' and self.user.guest then
    db.view = view
  elseif self.conf.onepage_off and (not act or act == "") and self.user.guest then
    db.list = images
  elseif sort then
    if sort == 'name' then
        db.list.order = 'name asc'
    elseif sort == 'last' then
        db.list.order = 'rowid desc'
    elseif sort == 'desc' then
        db.list.order = 'name desc'
    end
  elseif act == 'zip' then
    local recno = params.recno
    local zip = require("zip")
    local dir = 'gallery'
    local file = concat{dir,recno,"-",tostring(os.time()):sub(-3),'.zip'}
    local name = concat{self.conf.data,"/out/",file}

    local ar = zip.open(name,zip.OR(zip.CREATE, zip.EXCL))

    local qry = concat{[[select rowid,type,filename,fsize
      from file.files
      where files.folder = ']],recno,"'"}
    for row in self.conn:nrows(qry) do
      if true then
         ar:add(concat{dir,"/",row.rowid,"-",row.filename or 'file'},"string",row.rowid)
      end
    end

    ar:close()

    local out = io.open(name,'rb')
    local content = out:read('*a')
    os.remove(name)

    local fname = concat{"attachment;filename=\"",file,"\""}
    header("Content-Disposition",fname)
    header("Content-Type","application/zip")
    return {content}
  end
end

return db

