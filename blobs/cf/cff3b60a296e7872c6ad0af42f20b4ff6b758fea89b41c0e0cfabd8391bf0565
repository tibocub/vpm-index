function db:menu(row)
    if not row then
      local sort = params.sort
      local sel = "selected='selected'"
      local sels = {
        last = sort == 'last' and sel or '',
        name = sort == 'name' and sel or '',
        desc = sort == 'desc' and sel or '',
      }
      local menu = {
          {'',concat{format([[<select name="opt" 
                    onchange="acall('images',{'sort':this.value})" style="width:100px;">
                  <option value="last" %s>Last</option>
                  <option value="name" %s>A-Z</option>
                  <option value="desc" %s>Z-A</option>
              </select>]],sels.last,sels.name,sels.desc),js},
                              {act='nav'}}
      }
      local order = 'images.rowid desc'
      if sort == 'name' then
        order = 'images.name asc'
      elseif sort == 'last' then
        order = 'images.rowid desc'
      elseif sort == 'desc' then
        order = 'images.name desc'
      end
      local qry = concat{[[select images.name,images.rowid,files.count from images 
                           left join (select count(*) as count,folder from files 
                           group by folder) as files on images.rowid = files.folder order by ]], order}
      for name,recno,count in self.conn:urows(qry) do
          menu[#menu+1] = {"images",concat{name," (",count or 0,")"},{act="show",recno=recno}}
      end
      return menu
    end
end

