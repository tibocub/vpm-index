function db:update(row,recno)

  local fname = "noname"
  local ftype = "application/x-unknown"
  local fsize = nil
  local content = nil
  local filename = params['filename']

  if uploads and uploads.filename then -- php
    fname = uploads.filename.name or "noname"
    fsize = uploads.filename.size
    ftype = uploads.filename.type
    local file = uploads.filename.tmp_name
    local fin = io.open(file)
    if fin then
      content = fin:read("*a")
      os.remove(file)
    end
  elseif filename then
    if type(filename) == "table" then -- cgi
      fname = filename.name or "noname"
      fsize = filename.size
      ftype = filename['content-type']
      content = filename.contents
    else
      local pfile = self.conf.cli and concat{self.conf.data,"/out/",params.filename} or
        params.filename
      local fin = io.open(pfile)
      if fin then  -- lwt beta or cli
        content = fin:read("*a")
        fsize = string.len(content or "")
        fname = params.filename
      else  -- ttcb
        fsize = params["filename_sz"]
        ftype = params["filename_ct"]
        fname = params.filename
        content = getfile and getfile() or nil
      end
    end
  elseif params.content and params.ftype then -- ajax update
    local base64 = require("ee5_base64")
    content = base64.decode(params.content)
    ftype = params.ftype
    row.type = ftype
    fname = params.fname
    fsize = string.len(content) --params.fsize
    row.fsize = fsize
  end
  --fname = string.sub(fname,string.find(fname,"[^\\]+$"))
  if fsize then
    if fname then row.filename = fname end
    if ftype then row.type = ftype end
    row.fsize = fsize
  end

  if row.filename == '' then row.filename = nil end

  if not content or content == '' then
    return
  end

  if content and type(content)=="string" then
    row.data = content
  end

end

