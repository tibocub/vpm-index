local function download(self,recno)
    local mime = "application/x-unknown"
    local fn = recno
    local qry = concat{[[select rowid,type,filename,data,fsize
      from file.files
      where rowid = ']],recno,"'"}
    for row in self.conn:nrows(qry) do
      if row.type and row.type ~= "" then mime = row.type end
      if row.filename then fn = row.filename end
      if self.conf.cli then
        local ftype = string.match(fn,"%.(.*)",-5) or string.match(mime,"/(.*)",-5)
        local tmp = concat{self.conf.data,"/.tmp.",row.rowid,".",ftype}
        local fd = io.open(tmp,"wb")
        if fd then
          fd:write(row.data)
          fd:flush()
          self.term.menu:view(tmp,ftype,true)
          os.remove(tmp)
        end
      else
        return fn,mime,row.data
      end
    end
end

function db:main(out)
  if params.act == "download" then
    local recno = params.recno
    local dispos="attachment;filename=\""
    local mime = "application/x-unknown"
    local fname = recno
    local file = nil

    local zip,dir,tmp,ar,name = nil
    if not params.img and false then --todo base check if files have subfiles for zip
      local qry = concat{[[select rowid,type,filename,data,fsize,files.user as user
        from file.files
        where rowid = ]],recno}

      for row in self.conn:nrows(qry) do

        --if not self:access('files',recno,row.user,"view") then -- todo
        -- return {'No access'}
        --end

        if not zip then --todo base
          zip = require("zip")
          dir = concat{'tar',recno}
          fname = concat{dir,"-",tostring(os.time()):sub(-3),'.zip'}
          tmp = concat{self.conf.data,"/out/",fname}
          ar = zip.open(tmp,zip.OR(zip.CREATE, zip.EXCL))
        end
        _,_,file = download(self,row.rowid)
        ar:add(concat{dir,"/",row.rowid,"-",row.filename or 'file'},"string",file)
      end
    end
    if not zip then
      fname,mime,file = download(self,recno)
    elseif ar then
      name,_,file = download(self,recno)
      ar:add(concat{dir,"/",recno,"-",name or 'file'},"string",file)
      ar:close()
      local out = io.open(tmp,'rb')
      file = out:read('*a')
      mime = "application/zip"
      os.remove(tmp)
    end

    if file then
      dispos = concat{dispos,fname,"\""}
      header("Content-Disposition",dispos)
      header("Content-Type",mime)
      return {file}
    end
  end
end

function db:convert(file,name)
  if not string.match(string.lower(name or ""),"%.pdf$") then return '' end
  local from = concat{self.conf.data,"/out/from"}
  local to = concat{self.conf.data,"/out/to"}
  local tmp = io.open(from,'w')
  tmp:write(file)
  tmp:close()
  local cmd  = concat{"pdf2txt.py -o ",to," ",from}
  local exe = io.popen(cmd)
  local text = ''
  if exe then
    exe:close()
    local fd = io.open(to)
    if fd then
      text = fd:read("*a")
      fd:close()
    end
  end
  os.remove(from)
  os.remove(to)
  return text
end

