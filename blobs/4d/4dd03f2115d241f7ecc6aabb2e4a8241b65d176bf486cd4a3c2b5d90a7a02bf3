-- usage : local Math = require 'mytestpkg'
local Math = {}

Math.sin = {}

-- Function to compute sine of an angle given in degrees
function Math.sin.deg(x)
  return math.sin(x * math.pi / 180) -- Convert degrees to radians and calculate sine
end

-- Function to compute sine of an angle given in radians
function Math.sin.rad(x)
  return math.sin(x) -- Simply use math.sin for radians
end

