-- CLI entry point for htb.
--
-- `main(argv)` parses arguments and drives the pipeline:
--   load TOML -> resolve -> generate script (and optionally show/apply).
--
-- Argument parsing is a small, dependency-free parser (no argparse rock needed).

local htb = require("htb")

local HELP = [[
Usage: htb [options] CONFIG

Generate Linux tc (traffic control) rules from a TOML configuration file.

Options:
  --version            Show version and exit
  --list               List all available qdisc, filter, and action types
  --show               Display a graphical representation (requires graphviz)
  --check              Validate the configuration without generating output
  --auto               Auto-generate a config for the default gateway interface
  --speed DL/UL        Override measured speeds in Mbit (with --auto), e.g. 950/100
  --timeout N          Speed test timeout in seconds (with --auto, default 60)
  --no-lan             (with --auto) Do not add LAN bypass; shape all traffic
  --lan-subnet CIDR    (with --auto) LAN subnet(s) to run at line rate, e.g.
                       192.168.1.0/24; comma-separated for several
  --apply              Apply the generated rules (sudo when not root)
  -o, --output FILE    Write output to a file instead of stdout
  -h, --help           Show this help
]]

local SHORT = { h = "help", o = "output" }
local VALUE_FLAGS = { speed = true, timeout = true, output = true, ["lan-subnet"] = true }

local function parseArgs(argv)
    local flags = {}
    local values = {}
    local positional = {}
    local i = 1
    while i <= #argv do
        local a = argv[i]
        if a == "--" then
            for j = i + 1, #argv do
                positional[#positional + 1] = argv[j]
            end
            break
        elseif a:sub(1, 2) == "--" then
            local key = a:sub(3)
            if VALUE_FLAGS[key] then
                values[key] = argv[i + 1]
                i = i + 1
            else
                flags[key] = true
            end
        elseif a:sub(1, 1) == "-" and #a > 1 then
            local long = SHORT[a:sub(2)] or a:sub(2)
            if VALUE_FLAGS[long] then
                values[long] = argv[i + 1]
                i = i + 1
            else
                flags[long] = true
            end
        else
            positional[#positional + 1] = a
        end
        i = i + 1
    end
    return { flags = flags, values = values, positional = positional }
end

local function printList(info)
    local sections = {
        { "Qdiscs", info.qdiscs },
        { "Filters", info.filters },
        { "Actions", info.actions },
    }
    for _, section in ipairs(sections) do
        io.write("\n", section[1], ":\n  ", string.rep("-", 70), "\n")
        for _, entry in ipairs(section[2]) do
            local desc = entry.description or "(no description)"
            io.write(string.format("  %-12s %s\n", entry.name, desc))
            for pname, pinfo in pairs(entry.params or {}) do
                -- A param may be a plain description string (the common case)
                -- or a table {description, required, example}.
                local desc, req, ex
                if type(pinfo) == "table" then
                    desc = pinfo.description
                    req = pinfo.required and " (required)" or ""
                    ex = pinfo.example and ("  e.g. " .. pinfo.example) or ""
                else
                    desc = pinfo
                    req = ""
                    ex = ""
                end
                io.write(string.format("    %-18s %s%s%s\n", pname, desc or "", req, ex))
            end
        end
    end
end

local function runAuto(opts)
    local auto = require("htb.auto")
    local speed = nil
    if opts.values.speed then
        local d, u = opts.values.speed:match("^(%d+)/(%d+)$")
        if not d then
            io.stderr:write("Error: --speed must be DL/UL in Mbit, e.g. 950/100\n")
            return 1
        end
        speed = { down = tonumber(d), up = tonumber(u) }
    end
    local timeout = tonumber(opts.values.timeout) or 60
    local ok, result = pcall(auto.build_auto_config, {
        timeout = timeout,
        speed = speed,
        noLan = opts.flags["no-lan"] or false,
        lanSubnet = opts.values["lan-subnet"],
    })
    if not ok then
        io.stderr:write("Error: ", tostring(result), "\n")
        return 1
    end
    local toml_text = result
    if opts.values.output then
        local f = assert(io.open(opts.values.output, "w"))
        f:write(toml_text)
        f:close()
    else
        io.write(toml_text)
    end
    return 0
end

local function applyScript(scriptText)
    local auto = require("htb.auto")
    auto.apply(scriptText)
end

-- Main entry. Returns a process exit code (0 on success).
-- When called without an explicit argv (e.g. from the executable), it falls
-- back to the global command-line `arg` table (arg[1] .. arg[#arg]).
function main(argv)
    if argv == nil then
        argv = {}
        for i = 1, #arg do
            argv[i] = arg[i]
        end
    end
    local opts = parseArgs(argv)

    if opts.flags.version then
        io.write(htb.version, "\n")
        return 0
    end

    if opts.flags.help then
        io.write(HELP)
        return 0
    end

    if opts.flags.list then
        require("htb.plugins")
        local Registry = require("htb.registry")
        printList(Registry.list_all())
        return 0
    end

    if opts.flags.auto then
        return runAuto(opts)
    end

    local configPath = opts.positional[1]
    if not configPath then
        io.stderr:write("Error: CONFIG is required (unless using --list or --auto)\n")
        return 1
    end

    require("htb.plugins")
    local config = require("htb.config")
    local resolver = require("htb.resolver")
    local script = require("htb.script")
    local errors = require("htb.errors")

    local ok, err = pcall(function()
        local cfg = config.load_file(configPath)
        local resolved = resolver.resolve(cfg)

        if opts.flags.check then
            -- Run the full generation so plugin validation (and unknown-type
            -- detection) executes; the output is discarded.
            script.generate(cfg, resolved)
            io.write(string.format("Configuration '%s' is valid.\n", configPath))
            return
        end

        local out = script.generate(cfg, resolved)
        if opts.flags.apply then
            applyScript(out)
            return
        end
        if opts.values.output then
            local f = assert(io.open(opts.values.output, "w"))
            f:write(out)
            f:close()
        else
            io.write(out)
        end

        if opts.flags.show then
            local graph = require("htb.graph")
            graph.render(cfg, resolved)
        end
    end)

    if not ok then
        if errors.isHtbError(err) then
            io.stderr:write("Error: ", err.msg, "\n")
        else
            io.stderr:write("Error: ", tostring(err), "\n")
        end
        return 1
    end
    return 0
end

return { main = main, parseArgs = parseArgs }
