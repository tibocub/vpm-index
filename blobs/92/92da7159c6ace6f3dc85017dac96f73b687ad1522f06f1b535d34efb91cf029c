---@class boxd.CreateVmRequest
---@field name? string
---@field imageRef? string
---@field env? boxd.EnvVarList
---@field cmd? boxd.StringList
---@field restartPolicy? string
---@field config? boxd.VmConfig omit for defaults (all zeros)
