--- Global rock vars
_G.npg = {
    _CMD = 'npg',
    _NAME = 'NPG',
    _VERSION = '1.0.0',
    _DESCRIPTION = 'NPG - Neovim plugin generator'
}

--- @module "npg"
---
--- Rock entry point
---
local npg = {
    api = require('npg.api')
}

--- Launches rock
---
function npg.run()
    npg.api.parse_args()
    npg.api.config_scaffolding()
    npg.api.generate_plugin()
end

return npg
