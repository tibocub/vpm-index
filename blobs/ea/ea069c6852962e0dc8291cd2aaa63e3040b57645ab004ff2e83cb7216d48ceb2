M.index_md = [[
# Welcome to Rockydocs

Rockydocs is a Neovim plugin designed to simplify working with **MkDocs**, making it easier to create, build, and serve documentation projects—especially for the **Rocky Linux** documentation theme.

## About Rocky Linux Documentation

Rocky Linux is a community-driven enterprise operating system designed to be 100% bug-for-bug compatible with Red Hat Enterprise Linux. Its documentation is built using **MkDocs** and the **Material for MkDocs** theme, providing a modern, user-friendly experience for both readers and contributors.

## About MkDocs-Material

[MkDocs](https://www.mkdocs.org/) is a fast and simple static site generator geared towards project documentation. The [Material for MkDocs](https://squidfunk.github.io/mkdocs-material/) theme enhances MkDocs with a beautiful, responsive design and powerful features like:

- **Easy navigation** with collapsible sidebars and tabs.
- **Search functionality** for quick access to content.
- **Code highlighting** and **diagrams** support.
- **Dark/light mode** for better readability.

This project template is pre-configured with the Rocky Linux theme and essential plugins to help you get started quickly.

## Get Started

Edit the `docs/` directory to add your content, then use the Rockydocs plugin commands to build and serve your documentation.
]]

M.main_html = [[
{% extends "base.html" %}
{% block styles %}
{{ super() }}
<link rel="stylesheet" href="{{ 'assets/stylesheets/extra.css' | url }}" />
{% endblock %}
{% block config %}
{{ super() }}
{% if "localsearch" in config["plugins"] %}
<script src="{{ 'assets/javascripts/iframe-worker.js' | url }}"></script>
<script src="{{ 'search/search_index.js' | url }}"></script>
{% endif %}
<script>
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.getRegistrations().then(function (registrations) {
      for (let registration of registrations) {
        registration.unregister();
      }
    });
  }
</script>
<script
  defer
  data-domain="docs.rockylinux.org"
  data-api="https://img.resf.workers.dev/img/event"
  src="https://img.resf.workers.dev/js/script.js"
></script>
{% endblock %}
{% block content %}
{{ super() }}
{% if page and page.meta %}
{% if page.meta.author %}
<p><small>Author: {{ page.meta.author }}</small></p>
{% endif %}
{% if page.meta.contributors %}
<p><small>Contributors: {{ page.meta.contributors }}</small></p>
{% endif %}
{% endif %}
{% endblock %}
]]

