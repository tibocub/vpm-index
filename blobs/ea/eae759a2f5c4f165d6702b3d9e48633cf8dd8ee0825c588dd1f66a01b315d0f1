            issuer=nil
            for _,candidate in ipairs(servers) do if candidate==pinned then issuer=candidate; break end end
            if not issuer then return nil,'Configured oauth.issuer is not advertised by the resource' end
        end
        if not issuer or #M.metadata_urls(issuer)==0 or not self:url_allowed(issuer) then return nil,'OAuth resource has no safe authorization server' end
        local metadata
        for _,url in ipairs(M.metadata_urls(issuer)) do
            local value=self:fetch(url)
            if value then
                local valid,why=M.validate_metadata(value,issuer); if not valid then return nil,why end
                metadata={issuer=issuer,authorization_endpoint=value.authorization_endpoint,token_endpoint=value.token_endpoint,
                    code_challenge_methods_supported={'S256'},registration_endpoint=value.registration_endpoint,
                    authorization_response_iss_parameter_supported=value.authorization_response_iss_parameter_supported}
                break
            end
        end
        if not metadata then return nil,'Cannot discover OAuth authorization-server metadata' end
        if not self:url_allowed(metadata.authorization_endpoint) or not self:url_allowed(metadata.token_endpoint) then return nil,'Unsafe OAuth endpoint for this resource' end
        local registration=self.cfg.oauth
        local registration_key='mcp.oauth.registration_'..config.hash(issuer)
        if not registration or not registration.client_id then
            registration=self.state and self.state.get(registration_key)
            if type(registration)=='table' and registration.client_secret~=nil then
                return nil,self:recovery_error('Confidential DCR is unsupported')
            end
            if type(registration)~='table' or registration.issuer~=issuer or not nonempty(registration.client_id) then
                if not self:url_allowed(metadata.registration_endpoint) then return nil,'OAuth server needs configured oauth.client_id and oauth.issuer (no safe DCR endpoint)' end
                local value,why=self:fetch(metadata.registration_endpoint,{client_name='panto-mcp',application_type='native',
                    redirect_uris={'http://127.0.0.1/callback'},token_endpoint_auth_method='none',
                    grant_types={'authorization_code','refresh_token'},response_types={'code'}})
                if not value then return nil,why end
                if value.client_secret~=nil or (value.token_endpoint_auth_method~=nil and value.token_endpoint_auth_method~='none') then
                    return nil,'Confidential DCR is unsupported; configure oauth.client_id, oauth.issuer and optional oauth.client_secret'
                end
                if not nonempty(value.client_id) then return nil,'Invalid OAuth registration response' end
                registration={issuer=issuer,client_id=value.client_id}
                if self.state and not self.state.set(registration_key,registration) then return nil,'Cannot persist OAuth registration' end
            end
        end
        local scopes=challenge.scope
        if scopes==nil then scopes=prm.scopes_supported end
        if scopes==nil then scopes=self.cfg.oauth and self.cfg.oauth.scopes end
        if self.previous_issuer==issuer then scopes=M.union(scopes,self.requested_scopes) end
        local ok,why=self:define({issuer=issuer,metadata=metadata,client_id=registration.client_id,scopes=M.scopes(scopes)})
        if not ok then return nil,why end
        if not self:save() then return nil,'Cannot persist OAuth discovery' end
        if self.previous_issuer and self.previous_issuer~=issuer and self.state then
            self.state.set('mcp.oauth.registration_'..config.hash(self.previous_issuer),nil)
        end
        return true
    end
    local ok,value,err=pcall(work)
