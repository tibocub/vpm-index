    if not value then
        self.backoff=math.min((self.backoff or 2500)*2,60000); self.retry_at=self.clock()+self.backoff; self.discovery_error=err
    else self.backoff=nil; self.discovery_error=nil; self.retry_at=nil end
    self.discovering=nil; future:resolve(value,err)
    return value,err
end
function M:poll(callback,remaining,active)
    if self.closed then return end
    local t
    t=self.timer_factory(1000,function()
        self.timers[t]=nil
        if self.closed or (active and not active()) then return end
        local status=self:auth_status()
        if status.state~='pending' then callback(status); return end
        if remaining<=1000 then callback(nil); return end
        self:poll(callback,remaining-1000,active)
    end)
    self.timers[t]=true
end
function M:refresh()
    if self.refreshing then return self.refreshing:await() end
    local future=async.future(); self.refreshing=future
    local ok=self.auth.refresh(self.name)
    if not ok then self.refreshing=nil; return nil,self.cfg.auth and self:configured_error() or self:recovery_error(self:login_error()) end
    self.cached_status={state='pending'}; self.status_at=self.clock()
    self:poll(function(status)
        self.refreshing=nil
        if status and status.state=='logged_in' and not status.error then future:resolve(true)
        else future:resolve(nil,self.cfg.auth and self:configured_error() or self:recovery_error(self:login_error())) end
    end,70000)
    return future:await()
end
function M:recover(data)
    local challenge=data.challenge or {}
    if data.http_status==403 then
        if challenge.error~='insufficient_scope' then return nil,'Forbidden (HTTP 403); check server permissions' end
        if self.cfg.auth then return nil,'Configured auth session needs additional scopes; update its scopes and use panto auth login' end
        if not self.definition then return nil,'Insufficient scope (HTTP 403); no OAuth definition is available' end
        local scopes=M.union(M.union(self.spec.scopes,self:auth_status().scopes),challenge.scope)
        self.definition.scopes=scopes
        local ok,err=self:define(self.definition); if not ok then return nil,err end
        self:save()
        return nil,'Additional permission required; run /mcp-login '..self.cfg.name
    end
    if not self:available() then
        return nil,self.cfg.auth and self:configured_error() or 'MCP OAuth requires a newer panto with panto.ext.auth and HTTP POST support'
    end
    if data.auth_used then
        local ok,err=self:refresh()
        if ok or self.cfg.auth then return ok,err end
        self:invalidate()
        local discovered,why=self:discover(challenge)
        self.login_required=not self:usable() or nil
        return nil,discovered and err or self:recovery_error(why)
    end
    local ok,err=self:discover(challenge)
    if not ok then return nil,err end
    if self:request_auth() then return true end
    return nil,self:login_error()
end
function M:login(callback_url,on_success,on_error)
    if not self:available() then return nil,self.cfg.auth and 'Configured auth login requires a newer panto and an oauth_pkce session; use panto auth login instead' or 'MCP OAuth requires a newer panto with panto.ext.auth' end
    if not self.cfg.auth and not self.definition then return nil,'OAuth discovery is not ready; retry /mcp-login '..self.cfg.name..' after checking /mcp' end
    local usable=self:usable()
    local result
    if callback_url then
        if not self.auth.complete(self.name,callback_url) then return nil,'OAuth callback rejected; check the URL/state/issuer and retry' end
    elseif self.login_url and self:auth_status().state=='pending' then result={url=self.login_url}
    else
        result=self.auth.login(self.name)
        if not result then
            local text='Cannot start OAuth login; check that the configured auth session is oauth_pkce'
            return nil,self.cfg.auth and text or self:recovery_error(text)
        end
        self.login_url=result.url
    end
    self.login_usable=usable; self.login_required=not usable or nil
    self.cached_status={state='pending'}; self.status_at=self.clock()
    self.login_poll=(self.login_poll or 0)+1
