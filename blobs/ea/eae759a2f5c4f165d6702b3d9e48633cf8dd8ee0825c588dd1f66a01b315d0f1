    self:poll(function(status)
        self.login_required=nil; self.login_url=nil
        if status and status.state=='logged_in' and not status.error then
            self.login_usable=nil; on_success()
        elseif on_error then
            on_error(self:recovery_error('OAuth login failed or timed out'))
        end
    end,670000,function() return generation==self.login_poll end)
    return result and result.url or true
end
function M:close()
    self.closed=true
    for t in pairs(self.timers) do async.close(t) end; self.timers={}
    for handle,future in pairs(self.requests or {}) do handle:cancel(); future:resolve(nil,'session ended') end
    if self.refreshing then self.refreshing:resolve(nil,'session ended') end
end
return M
