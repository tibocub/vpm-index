end
function M:save()
    if self.state and self.definition then
        local d=self.definition
        return self.state.set(self.key,{version=2,name=self.name,fingerprint=self.cfg.fingerprint,resource=self.resource,issuer=d.issuer,
            metadata=d.metadata,client_id=d.client_id,scopes=d.scopes})
    end
    return true
end
function M:invalidate(reregister)
    if self.cfg.auth then return end
    if self.definition then
        self.previous_issuer=self.definition.issuer; self.requested_scopes=self.spec.scopes
    end
    if reregister and self.state and self.previous_issuer then
        self.state.set('mcp.oauth.registration_'..config.hash(self.previous_issuer),nil)
    end
    if self.state then self.state.set(self.key,nil) end
    self.login_poll=(self.login_poll or 0)+1
    self.definition=nil; self.spec=nil; self.cached_status=nil; self.login_required=nil; self.login_url=nil
    self.discovery_error=nil; self.retry_at=nil; self.backoff=nil
end
function M:fetch(url,body)
    if self.closed then return nil,'session ended' end
    if not self:url_allowed(url) then return nil,'Unsafe OAuth discovery URL for this resource' end
    local future=async.future()
    local opts={url=url,method=body and 'POST' or 'GET',timeout_ms=10000,max_bytes=1024*1024,headers={Accept='application/json'}}
    if body then opts.body=json.encode(body); opts.headers['Content-Type']='application/json' end
    local ok,handle=pcall(self.request_fn,opts,function(response)
        if self.closed then future:resolve(nil,'session ended'); return end
        if not response or response.status<200 or response.status>=300 then future:resolve(nil,'OAuth discovery/registration request failed'); return end
        local decoded,value=pcall(json.decode,response.body or '')
        if not decoded or type(value)~='table' then future:resolve(nil,'Invalid OAuth metadata JSON'); return end
        future:resolve(value)
    end)
    if not ok or not handle then return nil,'OAuth HTTP request could not start' end
    self.requests=self.requests or {}; self.requests[handle]=future
    local value,err=future:await(); self.requests[handle]=nil
    return value,err
end
function M:discover(challenge)
    if self.cfg.auth then return nil,self:configured_error() end
    challenge=challenge or {}
    if self.definition then return true end
    if self.discovering then return self.discovering:await() end
    if self.discovery_error and self.clock()<self.retry_at then return nil,self.discovery_error end
    if not self:available() then return nil,'MCP OAuth requires a newer panto with panto.ext.auth and HTTP POST support' end
    if not self.resource then return nil,'MCP OAuth requires HTTPS (or literal loopback HTTP)' end
    local future=async.future(); self.discovering=future
    local function work()
        local urls=challenge.resource_metadata and {challenge.resource_metadata} or M.prm_urls(self.resource)
        local prm,expected_resource
        for i,url in ipairs(urls) do
            local value=self:fetch(url)
            if value then
                prm=value; expected_resource=(not challenge.resource_metadata and i==2) and self.origin or self.resource
                break
            end
        end
        if not prm then return nil,'Cannot discover OAuth protected-resource metadata' end
        if M.url(prm.resource)~=expected_resource then return nil,'OAuth protected-resource metadata resource mismatch' end
