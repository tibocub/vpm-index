    "Export the whole metadata store as RDF.",

    cli.positional "path" {
        "Destination file path.",
        type = cli.string,
        default = "-"
    },

    function(args)
        if args.path == "-" then args.path = nil end
        repo.export(args.path)
        if args.path then
            io.stderr:write("File written to " .. args.path .. "\n")
        end
    end,
}


backup = cli.command {
    [[Perform a full archive backup to a destination folder.

    This includes files, raw database, and configuration.

    The configuration is modified so that the data paths point to the
    backup copy, which is fully functional without any modification.
    ]],

    cli.positional "path" {
        "Destination folder. The backup will be created in a new time-stamped \z
        folder under it.",
        type = cli.string,
    },

    function(args)
        io.stdout:write(json.encode(admin.backup(args.path)))
    end
}


restore = cli.command {
    "Restore a metadata DB from a backup. \n\z
    This command wipes out and rebuilds the target repository. \n\n\z
    Note: the `PKAR_CONFIG` environment variable does not play a role here. \z
    The locations to restore to (dres, ores, configuration) are indicated in \z
    the manifest file provided.",

    cli.positional "manifest" {
        "Manifest file created by the `backup` command. It should be in the \z
        backup folder under the nanme `pkar_restore.json`.",
        type = cli.string,
    },

    function(args)
        io.write("WARNING! This will WIPE all your archive data!\n\z
            The locations affected are indicated in the file: `" ..
            args.manifest .. "`. \n\z
            It is STRONGLY RECOMMENDED to review the paths in `ores.dest`, \z
            `dres.dest`, and `config.dest` of the JSON file, which will be \z
            overwritten by this operation, before proceeding.\n\n")
        io.write("Enter 'yes' if you want to continue: ")
        io.flush()
        local a = io.read()
        if a == "yes" then
            io.write("Alright, you asked for it.\n")
            io.stdout:write(admin.restore(args.manifest))
        else io.write("Chicken out.\n") end
    end
}


