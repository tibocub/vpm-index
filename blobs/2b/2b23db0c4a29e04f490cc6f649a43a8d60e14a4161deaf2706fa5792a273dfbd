cli.locale "en_US"  -- TODO set with multilingual support.

io.output(io.stdout)


--- Local ID to URI converter that strips prefix.
local id_to_uri = function(id)
    return model.id_to_uri(id:gsub("^" .. RSRC_PFX, ""))
end


