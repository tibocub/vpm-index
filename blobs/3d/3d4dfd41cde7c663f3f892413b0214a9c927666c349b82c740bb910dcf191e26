		exparts[4] = block1
		local codeblocks = {}
		codeblocks[#codeblocks + 1] = table.concat(exparts)

		for k = 3,#ast-1,2 do
			local efargs = {}
			if last then efargs[1] = " elseif" else efargs[1] = "elseif" end
			last = true
