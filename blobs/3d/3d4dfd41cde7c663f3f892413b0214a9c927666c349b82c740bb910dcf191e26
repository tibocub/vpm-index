			if tbl.ids[ast[1][1]] ~= nil then
				var = tbl.ids[ast[1][1]]
			else
				local newvar = getnextvarname(tbl.lname)
				tbl.lname = newvar
				tbl.ids[ast[1][1]] = newvar
				var = newvar
			end
			--[[
		else
			var = stringfor(ast[1],tbl)
			]]
		end
		spargs[2] = var
		spargs[3] = "="
		last = false
