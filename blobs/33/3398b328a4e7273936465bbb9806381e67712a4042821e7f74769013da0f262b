local request_transformer = require "kong.plugins.uoa-soap-to-rest.request_transformer"
local response_transformer = require "kong.plugins.uoa-soap-to-rest.response_transformer"

local transform_soap_body = request_transformer.transform_soap_body
local transform_headers = response_transformer.transform_headers
local transform_json_body = response_transformer.transform_json_body

local UoaSoapToRestHandler = {
  PRIORITY = 20000, -- set the plugin priority, which determines plugin execution order. See https://docs.konghq.com/konnect/reference/plugins/ for orders
  VERSION = "1.0.0", -- version in X.Y.Z format. Check hybrid-mode compatibility requirements.
}

-- runs in the 'access_by_lua_block'
-- Executed for every request from a client and before it is being proxied to the upstream service.
function UoaSoapToRestHandler:access(plugin_conf)
  if (plugin_conf.transform_json_response_to_xml) then
    -- Ensure response can be read by Kong so it can be converted to XML - will break if Accept-Encoding contains "gzip, br"
    kong.service.request.set_header("Accept-Encoding", "deflate")
  end


  --kong.log.inspect(plugin_conf)   -- check the logs for a pretty-printed config!
  local json_body, err = transform_soap_body(plugin_conf, kong.request.get_raw_body())

  if err then
    kong.log.warn("Soap body transformation failed: " .. err)
    return
  end

  kong.service.request.set_body(json_body, "application/json")
end

-- runs in the 'header_filter_by_lua_block'
-- Executed when all response headers bytes have been received from the upstream service.
function UoaSoapToRestHandler:header_filter(plugin_conf)
  if not plugin_conf.transform_json_response_to_xml then
    return
  end

  transform_headers()
end

-- runs in the 'body_filter_by_lua_block'
-- Executed for each chunk of the response body received from the upstream service.
-- Since the response is streamed back to the client, it can exceed the buffer size and be streamed chunk by chunk.
-- This function can be called multiple times if the response is large. See the lua-nginx-module documentation for more details
function UoaSoapToRestHandler:body_filter(plugin_conf)
  if not plugin_conf.transform_json_response_to_xml then
    return
  end

  local xml_body, err = transform_json_body(plugin_conf, kong.response.get_raw_body())
  if err then
    kong.log.warn("Response body transformation failed: " .. err)
    return
  end

  kong.response.set_raw_body(xml_body)
end

-- return our plugin object
return UoaSoapToRestHandler
