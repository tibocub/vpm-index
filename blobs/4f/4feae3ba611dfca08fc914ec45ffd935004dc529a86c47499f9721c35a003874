local fun = require("fun")

local base = require("bennu.base")

local na_msg = "N/A"

local function na_map(...)
   local t = table.pack(...)
   return fun.totable(fun.map(function(x)
      if t[x] == nil then
         return na_msg
      else
         return t[x]
      end
   end, fun.range(t.n)))
end

