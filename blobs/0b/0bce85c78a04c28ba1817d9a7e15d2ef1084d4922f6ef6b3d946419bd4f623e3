local FiveMock = {}

-- ========================
-- Vector types
-- ========================

local function makeVecMeta(dim)
    local mt = {}
    mt.__index = mt

    mt.__tostring = function(v)
        local parts = {}
        for i = 1, dim do parts[i] = tostring(v[i]) end
        return 'vector' .. dim .. '(' .. table.concat(parts, ', ') .. ')'
    end

    mt.__eq = function(a, b)
        for i = 1, dim do
            if a[i] ~= b[i] then return false end
        end
        return true
    end

    mt.__add = function(a, b)
        local t = {}
        for i = 1, dim do t[i] = a[i] + b[i] end
        return setmetatable(t, getmetatable(a))
    end

    mt.__sub = function(a, b)
        local t = {}
        for i = 1, dim do t[i] = a[i] - b[i] end
        return setmetatable(t, getmetatable(a))
    end

    mt.__mul = function(a, b)
        local t = {}
        if type(b) == 'number' then
            for i = 1, dim do t[i] = a[i] * b end
        elseif type(a) == 'number' then
            for i = 1, dim do t[i] = a * b[i] end
        else
            for i = 1, dim do t[i] = a[i] * b[i] end
        end
        return setmetatable(t, getmetatable(a) or getmetatable(b))
    end

    mt.__div = function(a, b)
        local t = {}
        if type(b) == 'number' then
            for i = 1, dim do t[i] = a[i] / b end
        else
            for i = 1, dim do t[i] = a[i] / b[i] end
        end
        return setmetatable(t, getmetatable(a))
    end

    mt.__unm = function(a)
        local t = {}
        for i = 1, dim do t[i] = -a[i] end
        return setmetatable(t, getmetatable(a))
    end

    mt.__len = function(v)
        local sum = 0
        for i = 1, dim do sum = sum + v[i] * v[i] end
        return math.sqrt(sum)
    end

    return mt
end

local vec2mt = makeVecMeta(2)
local vec3mt = makeVecMeta(3)
local vec4mt = makeVecMeta(4)

-- Named component accessors
for _, pair in ipairs({ { 'x', 1 }, { 'y', 2 } }) do
    vec2mt[pair[1]] = nil  -- set via __index below
end

-- Override __index to support .x/.y/.z/.w component access
local function addComponents(mt, names)
    local orig = mt.__index
    mt.__index = function(v, k)
        for i, name in ipairs(names) do
            if k == name then return rawget(v, i) end
        end
        return orig and orig[k]
    end
    -- Allow .x = val etc via __newindex
    mt.__newindex = function(v, k, val)
        for i, name in ipairs(names) do
            if k == name then rawset(v, i, val); return end
        end
        rawset(v, k, val)
    end
end

addComponents(vec2mt, { 'x', 'y' })
addComponents(vec3mt, { 'x', 'y', 'z' })
addComponents(vec4mt, { 'x', 'y', 'z', 'w' })

local function vector2(x, y)
    return setmetatable({ x or 0, y or 0 }, vec2mt)
end

local function vector3(x, y, z)
    return setmetatable({ x or 0, y or 0, z or 0 }, vec3mt)
end

local function vector4(x, y, z, w)
    return setmetatable({ x or 0, y or 0, z or 0, w or 0 }, vec4mt)
end

