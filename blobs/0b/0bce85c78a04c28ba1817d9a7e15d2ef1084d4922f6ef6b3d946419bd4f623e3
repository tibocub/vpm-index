-- Citizen object
-- ========================

local _gameTimer = 0

local Citizen = {}

--- Run fn immediately (no real coroutine scheduling in tests).
function Citizen.CreateThread(fn)
    local ok, err = pcall(fn)
    if not ok then
        print('[shiva-test] Citizen.CreateThread error: ' .. tostring(err))
    end
end

--- No-op in tests (no real async scheduler).
function Citizen.Wait(_ms) end

--- Call fn after ms milliseconds — immediate in test context.
function Citizen.SetTimeout(_ms, fn)
    local ok, err = pcall(fn)
    if not ok then
        print('[shiva-test] Citizen.SetTimeout error: ' .. tostring(err))
    end
end

--- Advance the fake game timer.
function Citizen.AdvanceTimer(ms)
    _gameTimer = _gameTimer + (ms or 0)
end

function Citizen.GetGameTimer()
    return _gameTimer
end

function Citizen.Trace(msg)
    print('[Citizen.Trace] ' .. tostring(msg))
end

function Citizen.InvokeNative(_hash, ...)
    -- No-op; specific natives should be registered via Natives
    return nil
end

-- ========================
-- json shim
-- ========================

local function jsonEncode(val, indent, level)
    level = level or 0
    local t = type(val)
    if t == 'nil'     then return 'null'
    elseif t == 'boolean' then return val and 'true' or 'false'
    elseif t == 'number'  then return tostring(val)
    elseif t == 'string'  then
        return '"' .. val
            :gsub('\\', '\\\\')
            :gsub('"',  '\\"')
            :gsub('\n', '\\n')
            :gsub('\r', '\\r')
            :gsub('\t', '\\t')
            .. '"'
    elseif t == 'table' then
        -- Detect array
        local isArray = true
        local n = 0
        for k in pairs(val) do
            n = n + 1
            if type(k) ~= 'number' or k ~= math.floor(k) or k < 1 then
                isArray = false; break
            end
        end
        if isArray and n == #val then
            local items = {}
            for _, v in ipairs(val) do
                items[#items + 1] = jsonEncode(v, indent, level + 1)
            end
            return '[' .. table.concat(items, ',') .. ']'
        else
            local items = {}
            for k, v in pairs(val) do
                items[#items + 1] = jsonEncode(tostring(k)) .. ':' .. jsonEncode(v, indent, level + 1)
            end
            return '{' .. table.concat(items, ',') .. '}'
        end
    end
    return 'null'
end

-- Minimal JSON decode (handles simple FiveM usage)
local function jsonDecode(s)
    s = s:match('^%s*(.-)%s*$')
    -- Delegate to load() trick for safe simple structures
    local fn, err = load('return ' .. s
        :gsub('"(.-)"%s*:', function(k) return '["' .. k .. '"]=' end)
        :gsub('%bnull', 'nil')
        :gsub('%btrue', 'true')
        :gsub('%bfalse', 'false')
    )
    if fn then
        local ok, result = pcall(fn)
        if ok then return result end
    end
    error('json.decode: failed to parse: ' .. tostring(err))
end

local json = {
    encode = jsonEncode,
    decode = jsonDecode,
}

-- ========================
-- Install into _G
-- ========================

---@param G     table  The global environment (_G)
---@param mode  string 'server' | 'client'
function FiveMock.install(G, mode)
    mode = mode or 'server'

    G.vector2 = vector2
    G.vector3 = vector3
    G.vector4 = vector4

    G.Citizen  = Citizen
    G.Wait     = function(ms) Citizen.Wait(ms) end
    G.CreateThread = function(fn) Citizen.CreateThread(fn) end
    G.SetTimeout   = function(ms, fn) Citizen.SetTimeout(ms, fn) end

    G.GetGameTimer           = function() return _gameTimer end
    G.GetCurrentResourceName = function() return 'shiva-test' end
    G.GetResourceMetadata    = function(_, _) return '' end
    G.GetNumResources        = function() return 0 end
    G.GetResourceByFindIndex = function(_) return '' end
    G.IsDuplicityVersion     = function() return mode == 'server' end

    G.json = json

    -- Server-side globals
    if mode == 'server' then
        G.source = 0
        G.NetworkGetEntityOwner = function(_) return 0 end
    end

    -- print variants that always work
    G.print     = G.print or print
    G.printTable = function(t)
        print(json.encode(t))
    end
end

--- Reset the game timer.
function FiveMock.resetTimer()
    _gameTimer = 0
end

FiveMock.vector2 = vector2
FiveMock.vector3 = vector3
FiveMock.vector4 = vector4
FiveMock.Citizen = Citizen
FiveMock.json    = json

return FiveMock
